22:  * The '-static' flag should be removed on Mac OS, which does not support\nL23:  * building static executables.\nL24:  *\nL25:  * ======================\nL26:  * How to use the program\nL27:  * ======================\nL28:  * You can run the program without argument to obtain the document.\nL29:  * Briefly, you can compare two structures by:\nL30:  *\nL31:  *     ./TMscore structure1.pdb structure2.pdb\nL32:  *\nL33:  * ==============\nL34:  * Update history\nL35:  * ==============\nL36:  * 2019/04/07: A C/C++ code of TM-score was constructed by Chengxin Zhang\nL37:  * 2019/07/24: Several updates to match the output format of TMscore.f:\nL38:  *            (1) Add rasmol format output by \"-o\" option\nL39:  *            (2) Add GDT score and MaxSub score output\nL40:  *            (3) Fixed bug in the calculation of 'the residue pairs of\nL41:  *                distance < 5.0 Angstrom)'\nL42:  * 2019/08/18: Add TM-score REMARK in rasmol output.\nL43:  * 2019/08/20: Clarify PyMOL syntax.\nL44:  * 2019/08/22: Add 4 more PyMOL scripts.\nL45:  * 2019/11/25: Remove unused functions. Fix minor memory leak.\nL46:  * 2021/01/07: Fix bug in -c.\nL47:  * 2021/02/24: Fix file format issue for new pymol.\nL48:  * 2022/02/27: Add -seq for TM-score superimposition guided by sequence\nL49:  *             alignment.\nL50:  */\nL51: \nL52: using namespace std;\nL53: #define MAX(A,B) ((A)>(B)?(A):(B))\nL54: #include <stdio.h>\nL55: #include <stdlib.h>\nL56: #include <math.h>\nL57: #include <time.h>\nL58: #include <string.h>\nL59: \nL60: #include <sstream>\nL61: #include <iostream>\nL62: #include <iomanip>\nL63: #include <fstream>\nL64: #include <vector>\nL65: #include <iterator>\nL66: #include <algorithm>\nL67: #include <string>\nL68: #include <iomanip>\nL69: #include <map>\nL70: \nL71: void print_version()\nL72: {\nL73:     cout <<\nL74: \"\\n\"\nL75: \" *************************************************************************\\n\"\nL76: \" *                                 TM-SCORE                              *\\n\"\nL77: \" * A scoring function to assess the similarity of protein structures     *\\n\"\nL78: \" * Based on statistics:                                                  *\\n\"\nL79: \" *       0.0 < TM-score < 0.17, random structural similarity             *\\n\"\nL80: \" *       0.5 < TM-score < 1.00, in about the same fold                   *\\n\"\nL81: \" * Reference: Yang Zhang and Jeffrey Skolnick, Proteins 2004 57: 702-710 *\\n\"\nL82: \" * For comments, please email to: zhanglab@zhanggroup.org                 *\\n\"\nL83: \" *************************************************************************\"\nL84:     << endl;\nL85: }\nL86: \nL87: void print_extra_help()\nL88: {\nL89:     cout <<\nL90: \"Additional options:\\n\"\nL91: \"    -a       TM-score normalized by the average length of two structures\\n\"\nL92: \"             T or F, (default F)\\n\"\nL93: \"\\n\"\nL94: \"    -m       Output TM-score rotation matrix\\n\"\nL95: \"\\n\"\nL96: \"    -d       TM-score scaled by an assigned d0, e.g. 5 Angstroms\\n\"\nL97: \"\\n\"\nL98: \"    -fast    Fast but slightly inaccurate alignment\\n\"\nL99: \"\\n\"\nL100: \"    -dir     Perform all-against-all alignment among the list of PDB\\n\"\nL101: \"             chains listed by 'chain_list' under 'chain_folder'. Note\\n\"\nL102: \"             that the slash is necessary.\\n\"\nL103: \"             $ TMscore -dir chain_folder/ chain_list\\n\"\nL104: \"\\n\"\nL105: \"    -dir1    Use chain2 to search a list of PDB chains listed by 'chain1_list'\\n\"\nL106: \"             under 'chain1_folder'. Note that the slash is necessary.\\n\"\nL107: \"             $ TMscore -dir1 chain1_folder/ chain1_list chain2\\n\"\nL108: \"\\n\"\nL109: \"    -dir2    Use chain1 to search a list of PDB chains listed by 'chain2_list'\\n\"\nL110: \"             under 'chain2_folder'\\n\"\nL111: \"             $ TMscore chain1 -dir2 chain2_folder/ chain2_list\\n\"\nL112: \"\\n\"\nL113: \"    -suffix  (Only when -dir1 and/or -dir2 are set, default is empty)\\n\"\nL114: \"             add file name suffix to files listed by chain1_list or chain2_list\\n\"\nL115: \"\\n\"\nL116: \"    -atom    4-character atom name used to represent a residue.\\n\"\nL117: \"             Default is \\\" C3'\\\" for RNA/DNA and \\\" CA \\\" for proteins\\n\"\nL118: \"             (note the spaces before and after CA).\\n\"\nL119: \"\\n\"\nL120: \"    -mol     Molecule type: RNA or protein\\n\"\nL121: \"             Default is detect molecule type automatically\\n\"\nL122: \"\\n\"\nL123: \"    -ter     Strings to mark the end of a chain\\n\"\nL124: \"             3: (default) TER, ENDMDL, END or different chain ID\\n\"\nL125: \"             2: ENDMDL, END, or different chain ID\\n\"\nL126: \"             1: ENDMDL or END\\n\"\nL127: \"             0: (default in the first C++ TMalign) end of file\\n\"\nL128: \"\\n\"\nL129: \"    -split   Whether to split PDB file into multiple chains\\n\"\nL130: \"             0: (default) treat the whole structure as one single chain\\n\"\nL131: \"             1: treat each MODEL as a separate chain (-ter should be 0)\\n\"\nL132: \"             2: treat each chain as a seperate chain (-ter should be <=1)\\n\"\nL133: \"\\n\"\nL134: \"    -outfmt  Output format\\n\"\nL135: \"             0: (default) full output\\n\"\nL136: \"             1: fasta format compact output\\n\"\nL137: \"             2: tabular format very compact output\\n\"\nL138: \"            -1: full output, but without version or citation information\\n\"\nL139: \"\\n\"\nL140: \"    -mirror  Whether to align the mirror image of input structure\\n\"\nL141: \"             0: (default) do not align mirrored structure\\n\"\nL142: \"             1: align mirror of chain1 to origin chain2\\n\"\nL143: \"\\n\"\nL144: \"    -het     Whether to align residues marked as 'HETATM' in addition to 'ATOM  '\\n\"\nL145: \"             0: (default) only align 'ATOM  ' residues\\n\"\nL146: \"             1: align both 'ATOM  ' and 'HETATM' residues\\n\"\nL147: \"\\n\"\nL148: \"    -infmt1  Input format for chain1\\n\"\nL149: \"    -infmt2  Input format for chain2\\n\"\nL150: \"            -1: (default) automatically detect PDB or PDBx/mmCIF format\\n\"\nL151: \"             0: PDB format\\n\"\nL152: \"             1: SPICKER format\\n\"\nL153: \"             2: xyz format\\n\"\nL154: \"             3: PDBx/mmCIF format\\n\"\nL155:     <<endl;\nL156: }\nL157: \nL158: void print_help(bool h_opt=false)\nL159: {\nL160:     //print_version();\nL161:     cout <<\nL162: \"\\n\"\nL163: \" Brief instruction for running TM-score program:\\n\"\nL164: \" (For detail: Zhang & Skolnick, Proteins, 2004 57:702-10)\\n\"\nL165: \"\\n\"\nL166: \" 1. Run TM-score to compare 'model' and 'native':\\n\"\nL167: \"     $ TMscore model.pdb native.pdb\\n\"\nL168: \"\\n\"\nL169: \" 2. Run TM-score to compare two complex structures with multiple chains\\n\"\nL170: \"     $ TMscore -c model.pdb native.pdb\\n\"\nL171: \"\\n\"\nL172: \" 2. TM-score normalized with an assigned scale d0 e.g. 5 A:\\n\"\nL173: \"     $ TMscore model.pdb native.pdb -d 5\\n\"\nL174: \"\\n\"\nL175: \" 3. TM-score normalized by a specific length, e.g. 120 residues:\\n\"\nL176: \"     $ TMscore model.pdb native.pdv -l 120\\n\"\nL177: \"\\n\"\nL178: \" 4. TM-score with superposition output, e.g. 'TM_sup.pdb':\\n\"\nL179: \"     $ TMscore model.pdb native.pdb -o TM_sup\\n\"\nL180: \"    View superposed CA-traces by RasMol or PyMOL:\\n\"\nL181: \"     $ rasmol -script TM_sup\\n\"\nL182: \"     $ pymol -d @TM_sup.pml\\n\"\nL183: \"    View superposed atomic models by RasMol or PyMOL:\\n\"\nL184: \"     $ rasmol -script TM_sup_atm\\n\"\nL185: \"     $ pymol -d @TM_sup_atm.pml\\n\"\nL186: \"\\n\"\nL187: \"\\n\"\nL188: \" 5. By default, this program assumes that residue pair with the same\\n\"\nL189: \"    residue index accross the two structure files are equivalent. This\\n\"\nL190: \"    often requires that the residue index in the input structures are\\n\"\nL191: \"    renumbered beforehand. Alternatively, residue equivalence can be\\n\"\nL192: \"    established by sequence alignment:\\n\"\nL193: \"     $ TMscore model.pdb native.pdb -seq\\n\"\nL194: \"\\n\"\nL195:     <<endl;\nL196: \nL197:     if (h_opt) print_extra_help();\nL198: \nL199:     exit(EXIT_SUCCESS);\nL200: }\nL201: \nL202: // PStreams - POSIX Process I/O for C++\nL203: \nL204: //        Copyright (C) 2001 - 2017 Jonathan Wakely\nL205: // Distributed under the Boost Software License, Version 1.0.\nL206: //    (See accompanying file LICENSE_1_0.txt or copy at\nL207: //          http://www.boost.org/LICENSE_1_0.txt)\nL208: //\nL209: \nL210: /**\nL211:  * @file pstream.h\nL212:  * @brief Declares all PStreams classes.\nL213:  * @author Jonathan Wakely\nL214:  *\nL215:  * Defines classes redi::ipstream, redi::opstream, redi::pstream\nL216:  * and redi::rpstream.\nL217:  */\nL218: \nL219: /* do not compile on windows, which does not have cygwin */\nL220: #if defined(WIN32) || defined(_WIN32) || defined(__WIN32__) && !defined(__CYGWIN__)\nL221: #define NO_PSTREAM\nL222: #else\nL223: \nL224: #ifndef REDI_PSTREAM_H_SEEN\nL225: #define REDI_PSTREAM_H_SEEN\nL226: \nL227: #include <ios>\nL228: #include <streambuf>\nL229: #include <istream>\nL230: #include <ostream>\nL231: #include <string>\nL232: #include <vector>\nL233: #include <algorithm>    // for min()\nL234: #include <cerrno>       // for errno\nL235: #include <cstddef>      // for size_t, NULL\nL236: #include <cstdlib>      // for exit()\nL237: #include <sys/types.h>  // for pid_t\nL238: #include <sys/wait.h>   // for waitpid()\nL239: #include <sys/ioctl.h>  // for ioctl() and FIONREAD\nL240: #if defined(__sun)\nL241: # include <sys/filio.h> // for FIONREAD on Solaris 2.5\nL242: #endif\nL243: #include <unistd.h>     // for pipe() fork() exec() and filedes functions\nL244: #include <signal.h>     // for kill()\nL245: #include <fcntl.h>      // for fcntl()\nL246: #if REDI_EVISCERATE_PSTREAMS\nL247: # include <stdio.h>     // for FILE, fdopen()\nL248: #endif\nL249: \nL250: \nL251: /// The library version.\nL252: #define PSTREAMS_VERSION 0x0101   // 1.0.1\nL253: \nL254: /**\nL255:  *  @namespace redi\nL256:  *  @brief  All PStreams classes are declared in namespace redi.\nL257:  *\nL258:  *  Like the standard iostreams, PStreams is a set of class templates,\nL259:  *  taking a character type and traits type. As with the standard streams\nL260:  *  they are most likely to be used with @c char and the default\nL261:  *  traits type, so typedefs for this most common case are provided.\nL262:  *\nL263:  *  The @c pstream_common class template is not intended to be used directly,\nL264:  *  it is used internally to provide the common functionality for the\nL265:  *  other stream classes.\nL266:  */\nL267: namespace redi\nL268: {\nL269:   /// Common base class providing constants and typenames.\nL270:   struct pstreams\nL271:   {\nL272:     /// Type used to specify how to connect to the process.\nL273:     typedef std::ios_base::openmode           pmode;\nL274:     /// Type used to hold the arguments for a command.\nL275:     typedef std::vector<std::string>          argv_type;\nL276: \nL277:     /// Type used for file descriptors.\nL278:     typedef int                               fd_type;\nL279: \nL280:     static const pmode pstdin  = std::ios_base::out; ///< Write to stdin\nL281:     static const pmode pstdout = std::ios_base::in;  ///< Read from stdout\nL282:     static const pmode pstderr = std::ios_base::app; ///< Read from stderr\nL283: \nL284:     /// Create a new process group for the child process.\nL285:     static const pmode newpg   = std::ios_base::trunc;\nL286: \nL287:   protected:\nL288:     enum { bufsz = 32 };  ///< Size of pstreambuf buffers.\nL289:     enum { pbsz  = 2 };   ///< Number of putback characters kept.\nL290:   };\nL291: \nL292:   /// Class template for stream buffer.\nL293:   template <typename CharT, typename Traits = std::char_traits<CharT> >\nL294:     class basic_pstreambuf\nL295:     : public std::basic_streambuf<CharT, Traits>\nL296:     , public pstreams\nL297:     {\nL298:     public:\nL299:       // Type definitions for dependent types\nL300:       typedef CharT                             char_type;\nL301:       typedef Traits                            traits_type;\nL302:       typedef typename traits_type::int_type    int_type;\nL303:       typedef typename traits_type::off_type    off_type;\nL304:       typedef typename traits_type::pos_type    pos_type;\nL305:       /** @deprecated use pstreams::fd_type instead. */\nL306:       typedef fd_type                           fd_t;\nL307: \nL308:       /// Default constructor.\nL309:       basic_pstreambuf();\nL310:       /// Constructor that initialises the buffer with @a cmd.\nL311:       basic_pstreambuf(const std::string& cmd, pmode mode);\nL312: \nL313:       /// Constructor that initialises the buffer with @a file and @a argv.\nL314:       basic_pstreambuf( const std::string& file,\nL315:                         const argv_type& argv,\nL316:                         pmode mode );\nL317: \nL318:       /// Destructor.\nL319:       ~basic_pstreambuf();\nL320: \nL321:       /// Initialise the stream buffer with @a cmd.\nL322:       basic_pstreambuf*\nL323:       open(const std::string& cmd, pmode mode);\nL324: \nL325:       /// Initialise the stream buffer with @a file and @a argv.\nL326:       basic_pstreambuf*\nL327:       open(const std::string& file, const argv_type& argv, pmode mode);\nL328: \nL329:       /// Close the stream buffer and wait for the process to exit.\nL330:       basic_pstreambuf*\nL331:       close();\nL332: \nL333:       /// Send a signal to the process.\nL334:       basic_pstreambuf*\nL335:       kill(int signal = SIGTERM);\nL336: \nL337:       /// Send a signal to the process' process group.\nL338:       basic_pstreambuf*\nL339:       killpg(int signal = SIGTERM);\nL340: \nL341:       /// Close the pipe connected to the process' stdin.\nL342:       void\nL343:       peof();\nL344: \nL345:       /// Change active input source.\nL346:       bool\nL347:       read_err(bool readerr = true);\nL348: \nL349:       /// Report whether the stream buffer has been initialised.\nL350:       bool\nL351:       is_open() const;\nL352: \nL353:       /// Report whether the process has exited.\nL354:       bool\nL355:       exited();\nL356: \nL357: #if REDI_EVISCERATE_PSTREAMS\nL358:       /// Obtain FILE pointers for each of the process' standard streams.\nL359:       std::size_t\nL360:       fopen(FILE*& in, FILE*& out, FILE*& err);\nL361: #endif\nL362: \nL363:       /// Return the exit status of the process.\nL364:       int\nL365:       status() const;\nL366: \nL367:       /// Return the error number (errno) for the most recent failed operation.\nL368:       int\nL369:       error() const;\nL370: \nL371:     protected:\nL372:       /// Transfer characters to the pipe when character buffer overflows.\nL373:       int_type\nL374:       overflow(int_type c);\nL375:       /// Transfer characters from the pipe when the character buffer is empty.\nL376:       int_type\nL377:       underflow();\nL378: \nL379:       /// Make a character available to be returned by the next extraction.\nL380:       int_type\nL381:       pbackfail(int_type c = traits_type::eof());\nL382: \nL383:       /// Write any buffered characters to the stream.\nL384:       int\nL385:       sync();\nL386: \nL387:       /// Insert multiple characters into the pipe.\nL388:       std::streamsize\nL389:       xsputn(const char_type* s, std::streamsize n);\nL390:       /// Insert a sequence of characters into the pipe.\nL391:       std::streamsize\nL392:       write(const char_type* s, std::streamsize n);\nL393: \nL394:       /// Extract a sequence of characters from the pipe.\nL395:       std::streamsize\nL396:       read(char_type* s, std::streamsize n);\nL397: \nL398:       /// Report how many characters can be read from active input without blocking.\nL399:       std::streamsize\nL400:       showmanyc();\nL401: \nL402:     protected:\nL403:       /// Enumerated type to indicate whether stdout or stderr is to be read.\nL404:       enum buf_read_src { rsrc_out = 0, rsrc_err = 1 };\nL405: \nL406:       /// Initialise pipes and fork process.\nL407:       pid_t\nL408:       fork(pmode mode);\nL409: \nL410:       /// Wait for the child process to exit.\nL411:       int\nL412:       wait(bool nohang = false);\nL413: \nL414:       /// Return the file descriptor for the output pipe.\nL415:       fd_type&\nL416:       wpipe();\nL417: \nL418:       /// Return the file descriptor for the active input pipe.\nL419:       fd_type&\nL420:       rpipe();\nL421: \nL422:       /// Return the file descriptor for the specified input pipe.\nL423:       fd_type&\nL424:       rpipe(buf_read_src which);\nL425: \nL426:       void\nL427:       create_buffers(pmode mode);\nL428: \nL429:       void\nL430:       destroy_buffers(pmode mode);\nL431: \nL432:       /// Writes buffered characters to the process' stdin pipe.\nL433:       bool\nL434:       empty_buffer();\nL435: \nL436:       bool\nL437:       fill_buffer(bool non_blocking = false);\nL438: \nL439:       /// Return the active input buffer.\nL440:       char_type*\nL441:       rbuffer();\nL442: \nL443:       buf_read_src\nL444:       switch_read_buffer(buf_read_src);\nL445: \nL446:     private:\nL447:       basic_pstreambuf(const basic_pstreambuf&);\nL448:       basic_pstreambuf& operator=(const basic_pstreambuf&);\nL449: \nL450:       void\nL451:       init_rbuffers();\nL452: \nL453:       pid_t         ppid_;        // pid of process\nL454:       fd_type       wpipe_;       // pipe used to write to process' stdin\nL455:       fd_type       rpipe_[2];    // two pipes to read from, stdout and stderr\nL456:       char_type*    wbuffer_;\nL457:       char_type*    rbuffer_[2];\nL458:       char_type*    rbufstate_[3];\nL459:       /// Index into rpipe_[] to indicate active source for read operations.\nL460:       buf_read_src  rsrc_;\nL461:       int           status_;      // hold exit status of child process\nL462:       int           error_;       // hold errno if fork() or exec() fails\nL463:     };\nL464: \nL465:   /// Class template for common base class.\nL466:   template <typename CharT, typename Traits = std::char_traits<CharT> >\nL467:     class pstream_common\nL468:     : virtual public std::basic_ios<CharT, Traits>\nL469:     , virtual public pstreams\nL470:     {\nL471:     protected:\nL472:       typedef basic_pstreambuf<CharT, Traits>       streambuf_type;\nL473: \nL474:       typedef pstreams::pmode                       pmode;\nL475:       typedef pstreams::argv_type                   argv_type;\nL476: \nL477:       /// Default constructor.\nL478:       pstream_common();\nL479: \nL480:       /// Constructor that initialises the stream by starting a process.\nL481:       pstream_common(const std::string& cmd, pmode mode);\nL482: \nL483:       /// Constructor that initialises the stream by starting a process.\nL484:       pstream_common(const std::string& file, const argv_type& argv, pmode mode);\nL485: \nL486:       /// Pure virtual destructor.\nL487:       virtual\nL488:       ~pstream_common() = 0;\nL489: \nL490:       /// Start a process.\nL491:       void\nL492:       do_open(const std::string& cmd, pmode mode);\nL493: \nL494:       /// Start a process.\nL495:       void\nL496:       do_open(const std::string& file, const argv_type& argv, pmode mode);\nL497: \nL498:     public:\nL499:       /// Close the pipe.\nL500:       void\nL501:       close();\nL502:       /// Report whether the stream's buffer has been initialised.\nL503:       bool\nL504:       is_open() const;\nL505: \nL506:       /// Return the command used to initialise the stream.\nL507:       const std::string&\nL508:       command() const;\nL509: \nL510:       /// Return a pointer to the stream buffer.\nL511:       stre