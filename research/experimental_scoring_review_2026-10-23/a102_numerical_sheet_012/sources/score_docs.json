sed stream.\nL560:       basic_ipstream()\nL561:       : istream_type(NULL), pbase_type()\nL562:       { }\nL563: \nL564:       /**\nL565:        * @brief Constructor that initialises the stream by starting a process.\nL566:        *\nL567:        * Initialises the stream buffer by calling do_open() with the supplied\nL568:        * arguments.\nL569:        *\nL570:        * @param cmd   a string containing a shell command.\nL571:        * @param mode  the I/O mode to use when opening the pipe.\nL572:        * @see   do_open(const std::string&, pmode)\nL573:        */\nL574:       explicit\nL575:       basic_ipstream(const std::string& cmd, pmode mode = pstdout)\nL576:       : istream_type(NULL), pbase_type(cmd, readable(mode))\nL577:       { }\nL578: \nL579:       /**\nL580:        * @brief Constructor that initialises the stream by starting a process.\nL581:        *\nL582:        * Initialises the stream buffer by calling do_open() with the supplied\nL583:        * arguments.\nL584:        *\nL585:        * @param file  a string containing the pathname of a program to execute.\nL586:        * @param argv  a vector of argument strings passed to the new program.\nL587:        * @param mode  the I/O mode to use when opening the pipe.\nL588:        * @see   do_open(const std::string&, const argv_type&, pmode)\nL589:        */\nL590:       basic_ipstream( const std::string& file,\nL591:                       const argv_type& argv,\nL592:                       pmode mode = pstdout )\nL593:       : istream_type(NULL), pbase_type(file, argv, readable(mode))\nL594:       { }\nL595: \nL596:       /**\nL597:        * @brief Constructor that initialises the stream by starting a process.\nL598:        *\nL599:        * Initialises the stream buffer by calling\nL600:        * @c do_open(argv[0],argv,mode|pstdout)\nL601:        *\nL602:        * @param argv  a vector of argument strings passed to the new program.\nL603:        * @param mode  the I/O mode to use when opening the