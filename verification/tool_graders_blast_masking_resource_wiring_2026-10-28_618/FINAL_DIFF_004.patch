+                'bytes': detail.get('bytes'), 'writer_closed': detail['available'] and view['terminal']})
+            if text_log and detail['available']:
+                logs.append({'role': selected['role'], 'path': str(path),
+                    'offset': detail['tail_byte_offset'], 'observed_size': detail['bytes'],
+                    'bytes_base64': detail['bytes_base64']})
+        return outputs, logs, outputs[-1]['available']
