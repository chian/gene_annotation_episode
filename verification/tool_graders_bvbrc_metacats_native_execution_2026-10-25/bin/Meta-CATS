#!/home/chia/repos/gene_annotation_episode/.venv/bin/python
import pathlib, subprocess, sys, shutil, json
cmd=['/home/chia/repos/gene_annotation_episode/verification/tool_graders_bvbrc_metacats_native_execution_2026-10-25/runtime/usr/lib/R/bin/exec/R', '--vanilla', '--slave', '--file=/home/chia/repos/gene_annotation_episode/verification/tool_graders_bvbrc_msa_metacats_boundaries_2026-10-25/retained_sources/bvbrc_metacats/scripts/Meta-CATS.R', '--args'] + sys.argv[1:]
p=subprocess.run(cmd)
out=pathlib.Path(sys.argv[4]); keep=out/"retained_raw"; keep.mkdir(exist_ok=True)
name=sys.argv[5]
for suffix in ("-chisqTable.txt","-mcTable.txt"):
 src=out/(name+suffix)
 if src.exists(): shutil.copyfile(src,keep/src.name)
(keep/(name+".invocation.json")).write_text(json.dumps({"command":cmd,"returncode":p.returncode},indent=2)+"\n")
sys.exit(p.returncode)
