    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "39133002"
            }
          ],
          "value": "Mutation results in a 10% reduction in PLP phosphatase activity in the cell-free extract, indicating the presence of some other PLP phosphatase(s) in E.coli (PubMed:39133002). The PLP phosphatase activity is nearly abolished in the ybhA-yigL double mutant (PubMed:39133002). Mutation does not affect the PNP phosphatase activity in the cell-free extract (PubMed:39133002). Mutant does not accumulate PNP in the cells (PubMed:39133002)"
        }
      ],
