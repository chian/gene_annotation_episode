unit-shuffle: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 unit-shuffle
.PHONY : unit-shuffle

# fast build rule for target.
unit-shuffle/fast:
	$(MAKE) $(MAKESILENT) -f src/tld/tests/CMakeFiles/unit-shuffle.dir/build.make src/tld/tests/CMakeFiles/unit-shuffle.dir/build
.PHONY : unit-shuffle/fast

