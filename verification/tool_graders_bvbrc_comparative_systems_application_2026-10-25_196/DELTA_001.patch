+        yield value
+        if set(value) == {"location", "value"}:
+            # Losslessly retained native JSON is data, not another contract.
+            yield from _walk(value["location"])
+            return
+        for item in value.values():
+            yield from _walk(item)
+    elif type(value) is list:
+        for item in value:
+            yield from _walk(item)
