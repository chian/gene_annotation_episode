+def _json_decode(text):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ValueError("duplicate_json_key")
+            result[key] = value
+        return result
+
+    def constant(_token):
+        raise ValueError("nonfinite_number")
