+def _reason_from_received_hypothesis(store, context, hypothesis_ref):
+    """A real nonempty reasoning action, with no new finding contribution."""
+    hypothesis = next(row for row in context['working_state']['hypotheses']
+        if row['id'] == hypothesis_ref)
+    assert hypothesis_ref in context['visible_record_refs']
+    payload = {name: [] for name in store.reasoning_schema()['required']}
+    payload['hypotheses'] = [{'alias': 'received_hypothesis', **{
+        name: hypothesis[name] for name in ('subject_refs', 'predicate', 'value', 'context_refs')}}]
+    return {'selection': {'kind': 'reason', 'commit': payload}, 'report_update': {}}
 
 
