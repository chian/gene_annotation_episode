        "formula": {
          "enum": [
            "native_estimate",
            "c_left*x_left",
            "c_right*x_right",
            "L-R",
            "L/R",
            "ln(L)-ln(R)",
            "c_left^2*Cll+c_right^2*Crr-2*c_left*c_right*Clr",
            "sqrt(V_D)",
            "D/sqrt(V_D)",
            "D^2/V_D",
            "(V_R-C_LR)/(V_L+V_R-2*C_LR)",
            "(V_L-C_LR)/(V_L+V_R-2*C_LR)",
            "if(V_D>0,w_L*L+w_R*R,if(V_D==0&&D==0,L,unavailable))",
            "if(V_D>0,(V_L*V_R-C_LR^2)/V_D,if(V_D==0&&D==0,V_L,unavailable))",
            "sqrt(V_combined)",
            "epsilon_nuisance/epsilon_signal",
            "J_alpha*C_epsilon*J_alpha_transpose",
            "s*alpha*f",
            "y-s*alpha*f",
            "J_h*C_y_epsilon_f*J_h_transpose",
            "y-H",
            "(y-H)/(s*alpha)"
