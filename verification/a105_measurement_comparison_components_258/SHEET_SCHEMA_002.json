        "interpretation": {
          "enum": [
            "native_report",
            "supported_reexpression",
            "descriptive_protocol_comparison",
            "common_estimand_comparison",
            "known_covariance_standardization",
            "estimated_covariance_plugin_standardization",
            "known_covariance_common_estimate",
            "estimated_covariance_plugin_common_estimate",
            "spectral_sensitivity",
            "supported_estimate_scale_correction",
            "first_order_known_input_covariance",
            "first_order_estimated_input_covariance",
            "stipulated_report_scale_scenario",
            "unavailable",
            "protocol_difference_uncertainty_known_covariance",
            "protocol_difference_uncertainty_estimated_covariance"
