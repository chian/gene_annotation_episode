        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "exact_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/exact"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditional_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "conditional_exact_value": {
