            "native_right",
            "converted_left",
            "converted_right",
            "protocol_difference",
            "protocol_ratio",
            "protocol_log_ratio",
            "common_difference",
            "common_ratio",
            "common_log_ratio",
            "difference_variance",
            "difference_standard_uncertainty",
            "standardized_difference",
            "squared_standardized_difference",
            "weight_left",
            "weight_right",
            "combined_estimate",
            "combined_variance",
            "combined_standard_uncertainty",
            "spectral_multiplier",
            "spectral_multiplier_variance",
            "observed_interference",
            "corrected_estimate",
            "corrected_estimate_variance",
