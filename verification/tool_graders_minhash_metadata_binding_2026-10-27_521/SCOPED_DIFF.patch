+    with h.store.transaction():
+        h.store.db.execute("UPDATE runtime_actions SET result=? WHERE run_id=? AND episode_id=? AND decision_index=?",
+            (canonical(outcome), ctx.run_id, ctx.episode_id, index))
+    return outcome
+
