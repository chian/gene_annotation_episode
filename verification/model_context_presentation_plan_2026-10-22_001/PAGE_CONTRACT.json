                "view": {
                  "const": "records"
                }
              },
              "required": [
                "view",
                "decision_indices"
              ],
              "type": "object"
            },
            "tool": {
              "const": "episode.history"
            }
          },
          "required": [
            "tool",
            "arguments"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
