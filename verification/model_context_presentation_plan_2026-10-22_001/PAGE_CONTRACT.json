    "last_unit_index",
    "decision_indices",
    "identity_fields",
    "included_rows_without_decision_identity",
    "included_rows_without_unit_ref",
    "raw_history_sha256",
    "included_history_sha256",
    "history_is_complete",
    "history_lookup",
    "exact_included_records",
    "discover_older_decisions",
    "history_result_row_path",
    "history_result_step_path",
