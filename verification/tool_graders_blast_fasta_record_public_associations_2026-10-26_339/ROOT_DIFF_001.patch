+def build_database_sheet(result: dict, *, reference_metadata: list[dict] | None = None,
+                         target_context: dict | None = None,
+                         database_profile: dict | None = None,
+                         description_bindings: list[dict] | None = None,
+                         sequence_identity_bindings: list[dict] | None = None,
+                         geometry_program: str | None = None,
+                         calculation_context: dict | None = None) -> dict:
+    """Populate numerical components and retain exact supplied associations.
+
+    Both binding lists omitted preserves legacy accession matching. Supplying
+    both selects explicit links; only an explicitly supplied record locator
+    selects the v2 sheet. Record addresses never infer functions or independent
+    sequences. The caller authenticates the supplied bytes and relationships.
+    """
+    extended = _uses_record_locators(reference_metadata, description_bindings, sequence_identity_bindings)
+    if extended and description_bindings is None and sequence_identity_bindings is None:
+        raise ValueError("blast_record_locator_requires_explicit_bindings")
+    return _build_database_sheet(result, reference_metadata=reference_metadata,
+        target_context=target_context, database_profile=database_profile,
+        description_bindings=description_bindings, sequence_identity_bindings=sequence_identity_bindings,
+        geometry_program=geometry_program, calculation_context=calculation_context,
+        association_version=2 if extended else 1)
 
 
