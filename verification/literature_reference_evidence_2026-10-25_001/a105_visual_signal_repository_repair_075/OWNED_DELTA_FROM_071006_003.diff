+        raw = store.get_artifact(store.get(reference)['artifact_ref'])
+        quote = raw.decode()
+        selection['comparison'][key] = {'status': 'known', 'value': quote,
+            'witnesses': [{'kind': 'text', 'source_ref': reference, 'representation': 'original',
+                'start': 0, 'end': len(raw), 'quote': quote}]}
