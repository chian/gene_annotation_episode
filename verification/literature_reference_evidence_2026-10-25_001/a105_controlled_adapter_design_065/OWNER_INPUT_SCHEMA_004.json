        "condition1_target",
        "condition0_target",
        "condition_levels_relation",
        "subject_construct_across_conditions",
        "condition1_control_application",
        "condition0_control_application",
        "control_reference_reuse",
        "nonintended_conditions",
        "intended_factor"
