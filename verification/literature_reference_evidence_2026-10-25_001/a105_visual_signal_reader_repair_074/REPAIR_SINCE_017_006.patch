+def multi_dependency_fixture():
+    """Multiple constructed text/source/view aliases; no native custody claim."""
+    primary, subject, genotype = ['source_' + str(n) * 24 for n in (1, 2, 3)]
+    xml = b'<article><body><sec id="s1"><p>SyntheticProtein 60% (V) of WT levels.</p></sec></body></article>'
+    label = '\u03bc SyntheticProtein'.encode('utf-8')
+    data = {(primary, 'original'): xml, (subject, 'text'): label,
+        (subject, 'original'): b'<p>' + label + b'</p>', (genotype, 'original'): b'ConstructedStrain'}
+    def text_witness(ref, representation, *, start=0, end=None):
+        raw = data[(ref, representation)]
+        end = len(raw) if end is None else end
+        return {'kind': 'text', 'source_ref': ref, 'representation': representation,
+            'start': start, 'end': end, 'quote': raw[start:end].decode('utf-8')}
+    passage = prose()
+    passage['selection']['source_ref'] = primary
+    subject_witness = text_witness(subject, 'text')
+    passage['comparison_relation']['witnesses'] = [deepcopy(subject_witness)]
+    selected = request([visual(ident='first_view2', view=VIEW2), passage,
+        visual(ident='third_view1'), visual(ident='fourth_alias', view=VIEW2)])
+    selected['source_ref'] = primary
+    selected['comparison']['subject'] = {'status': 'known', 'value': 'SyntheticProtein', 'witnesses': [subject_witness]}
+    selected['comparison']['genotype'] = {'status': 'known', 'value': 'ConstructedStrain',
+        'witnesses': [text_witness(genotype, 'original')]}
+    selected['comparison']['experiment'] = {'status': 'known', 'value': 'constructed experiment',
+        'witnesses': [text_witness(subject, 'original', start=3, end=3 + len(label)), deepcopy(subject_witness)]}
+    source, view, _ = callbacks()
+    calls = []
+    def read_source(ref, representation):
+        calls.append(('source', ref, representation))
+        raw = data[(ref, representation)]
+        return {'artifact_ref': 'artifact_' + hashlib.sha256(raw).hexdigest(), 'content': raw}
+    def read_view(ref):
+        calls.append(('view', ref))
+        return view(ref)
+    return selected, read_source, read_view, calls, data
+
+
+def test_canonical_multi_source_multi_view_reader_roundtrip_and_array_order(monkeypatch):
+    from gene_annotation_episode import literature_ratio_source_inputs as inputs
+    selected, read_source, read_view, calls, data = multi_dependency_fixture()
+    original = deepcopy(selected)
+    expected_calls = [('source', *key) for key in sorted(data)] + [('view', VIEW), ('view', VIEW2)]
+    decode = inputs._view_bytes
+    def guarded(*a):
+        assert calls == expected_calls  # all unique actual callbacks before helper
+        return decode(*a)
+    monkeypatch.setattr(inputs, '_view_bytes', guarded)
+    extraction = read_relative_signal_source_inputs(selected, read_source=read_source,
+        read_view=read_view, evidence_origin='synthetic_fixture')
+    assert calls == expected_calls
+    assert [(r['source_ref'], r['representation']) for r in extraction['sources']] == sorted(data)
+    assert [r['view_ref'] for r in extraction['views']] == [VIEW, VIEW2]
+    assert [r['representation_id'] for r in extraction['representations']] == [r['representation_id'] for r in original['representations']]
+    assert extraction['comparison']['subject']['witnesses'][0]['locator']['quote'] == '\u03bc SyntheticProtein'
+    assert selected == original
+    loaded = json.loads(json.dumps(extraction, sort_keys=True))
+    assert validate_relative_signal_source_extraction(loaded) == extraction
+    # Reordered object fields have identical callback order and actual results.
+    calls.clear()
+    reordered = json.loads(json.dumps(selected, sort_keys=True))
+    repeated = read_relative_signal_source_inputs(reordered, read_source=read_source,
+        read_view=read_view, evidence_origin='synthetic_fixture')
+    assert calls == expected_calls and repeated == extraction
+    # Scientific arrays retain their deliberately changed ordering.
+    calls.clear()
+    reordered['representations'].reverse()
+    reversed_output = read_relative_signal_source_inputs(reordered, read_source=read_source,
+        read_view=read_view, evidence_origin='synthetic_fixture')
+    assert calls == expected_calls
+    assert [r['representation_id'] for r in reversed_output['representations']] == [r['representation_id'] for r in reordered['representations']]
+    assert reversed_output['selection']['representations'] != extraction['selection']['representations']
+
