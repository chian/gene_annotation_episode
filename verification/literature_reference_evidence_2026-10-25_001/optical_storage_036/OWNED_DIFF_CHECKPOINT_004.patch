+            return {"selection": {"kind": "redeliver_report", "delivery_ref": inputs["feedback"]["delivery_ref"],
+                "purpose": "Receive the original saved optical subset", "schema_json": json.dumps(repaired)}, "report_update": {}}
+        def received(inputs):
