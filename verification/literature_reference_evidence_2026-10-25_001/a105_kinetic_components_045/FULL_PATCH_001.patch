+        "log_basis": "natural_log_canonical_parameter", "origin": "synthetic",
+        "source": {"source_ref": "synthetic covariance", "artifact_ref": "synthetic covariance artifact",
+            "representation": "synthetic", "start": 0, "end": 20}}
+    result.update(updates)
+    return result
