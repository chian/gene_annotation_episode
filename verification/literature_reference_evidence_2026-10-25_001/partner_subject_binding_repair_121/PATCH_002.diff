+_NATIVE_BINDING_VERSION = "partner_native_operand_bindings_v1"
+_NATIVE_IDENTITY_FIELDS = ("subject", "partner", "endpoint", "normalization")
+_COMPONENT_ROLES = {
+    "reference_rate": ("reference",), "omitted_rate": ("omitted",),
+    "addback_rate": ("addback",), "partner_loss": ("reference", "omitted"),
+    "partner_loss_fraction": ("reference", "omitted"),
+    "addback_gain": ("addback", "omitted"),
+    "addback_fraction": _ROLES, "restored_reference_fraction": _ROLES,
