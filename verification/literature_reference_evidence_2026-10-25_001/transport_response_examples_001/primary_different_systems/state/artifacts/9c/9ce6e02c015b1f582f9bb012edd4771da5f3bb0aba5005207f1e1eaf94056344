on (Fig. S8). Therefore, the uptake rates were corrected by the values determined for pure diffusion. The Km of the transporter BtsT for pyruvate measured in intact cells was 16.5 \u00b1 6.4 \u03bcM.","representation":"primary_html","section_id":"sec2-4","source_ref":"source_29f86582ecb7f863c255ff42"},"subject":"BtsT","uncertainty":{"count":null,"kind":"unspecified","magnitude":6.4,"sampling_basis":"unspecified"},"unit":"uM","value":16.5,"version":"a105_html_quantity_v1"},"interpretation_limits":["subject_token_presence_is_not_experimental_attribution","reported_specific_activity_does_not_establish_product_identity","reported_spread_with_unspecified_meaning_is_not_SEM_or_SD","apparent_km_is_not_affinity_or_an_activity_rate"],"scope":"reported_source_quantity","source_conditions":null},"version":"literature_source_quantity_record_v1"},"km_sheet_ref":"source_16ed91c4d9301194949795c9","sheet":{"cells":{"apparent_km":{"conditional_on":[],"formula":"km","origin":"reported","status":"populated","unavailable_reason":null,"unit":"uM","value":16.5},"condition_response":{"conditional_on":["same_kinetic_curve","michaelis_menten_response"],"formula":"substrate_test*(km+substrate_reference)/(substrate_reference*(km+substrate_test))","origin":"derived","status":"unavailable","unavailable_reason":"different_kinetic_curves","unit":"dimensionless","value":null},"condition_response_standard_uncertainty":{"conditional_on":["same_kinetic_curve","michaelis_menten_response","first_order_covariance_propagation"],"formula":"sqrt(condition_response_variance)","origin":"derived","status":"unavailable","unavailable_reason":"different_kinetic_curves","unit":"dimensionless","value":null},"condition_response_variance":{"conditional_on":["same_kinetic_curve","michaelis_menten_response","first_order_covariance_propagation"],"formula":"Jh*covariance*Jh_transpose; Jh=h*[km/(St*(km+St)),-km/(Sr*(km+Sr)),1/(km+Sr)-1/(km+St)]","origin":"derived","status":"unavailable","unavailable_reason":"different_ki