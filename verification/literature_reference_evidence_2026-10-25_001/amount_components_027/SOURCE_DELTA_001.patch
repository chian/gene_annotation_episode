+        anchor = records.get(measurement, {}).get("anchor")
+        if not isinstance(anchor, Mapping):
+            continue
+        for reference in associated.get(measurement, ()):
+            candidate = records.get(reference, {}).get("anchor")
+            if (isinstance(candidate, Mapping)
