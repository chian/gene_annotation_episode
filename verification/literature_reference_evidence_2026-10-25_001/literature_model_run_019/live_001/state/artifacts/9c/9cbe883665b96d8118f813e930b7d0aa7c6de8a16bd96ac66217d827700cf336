documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC9499530?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":33,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"Y","dbCrossReferenceList":{"dbName":["PDB"]},"hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["pdb","doi"]},"dateOfCompletion":"2022-09-23","dateOfCreation":"2022-08-26","dateOfRevision":"2025-05-30","electronicPublicationDate":"2022-08-26","firstPublicationDate":"2022-08-26","firstIndexDate":"2022-08-27","fullTextReceivedDate":"2022-09-26","hasEvaluations":"N"},{"id":"22582275","source":"MED","pmid":"22582275","pmcid":"PMC3393501","fullTextIdList":{"fullTextId":["PMC3393501"]},"doi":"10.1128/jb.00385-12","title":"Electron bifurcation involved in the energy metabolism of the acetogenic bacterium Moorella thermoacetica growing on glucose or H2 plus CO2.","authorString":"Huang H, Wang S, Moll J, Thauer RK.","authorList":{"author":[{"fullName":"Huang H","lastName":"Huang","firstName":"Haiyan","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Max Planck Institute for Terrestrial Microbiology, Marburg, Germany."}]}},{"fullName":"Wang S","lastName":"Wang","firstName":"Shuning","initials":"S","authorId":{"type":"ORCID","value":"0000-0002-1166-078X"}},{"fullName":"Moll J","lastName":"Moll","firstName":"Johanna","initials":"J"},{"fullName":"Thauer RK","lastName":"Thauer","firstName":"Rudolf K","initials":"RK"}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-1166-078X"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"14","volume":"194","journalIssueId":1944078,"dateOfPublication":"2012 Jul","monthOfPublication":7,"yearOfPublication":2012,"journal":{"medlineAbbreviation":"J Bacteriol","title":"Journal of bacteriology","essn":"1098-5530","issn":"0021-9193","isoabbreviation":"J Bacteriol","nlmid":"2985120R"},"printPublicationDate":"2012-07-01"},"pubYear":"2012","pageInfo":"3689-3699","abstractText":"Moorella thermoacetica ferments glucose to three acetic acids. In the oxidative part of the fermentation, the hexose is converted to 2 acetic acids and 2 CO(2) molecules with the formation of 2 NADH and 2 reduced ferredoxin (Fd(red)(2-)) molecules. In the reductive part, 2 CO(2) molecules are reduced to acetic acid, consuming the 8 reducing equivalents generated in the oxidative part. An open question is how the two parts are electronically connected, since two of the four oxidoreductases involved in acetogenesis from CO(2) are NADP specific rather than NAD specific. We report here that the 2 NADPH molecules required for CO(2) reduction to acetic acid are generated by the reduction of 2 NADP(+) molecules with 1 NADH and 1 Fd(red)(2-) catalyzed by the electron-bifurcating NADH-dependent reduced ferredoxin:NADP(+) oxidoreductase (NfnAB). The cytoplasmic iron-sulfur flavoprotein was heterologously produced in Escherichia coli, purified, and characterized. The purified enzyme was composed of 30-kDa (NfnA) and 50-kDa (NfnB) subunits in a 1-to-1 stoichiometry. NfnA harbors a [2Fe2S] cluster and flavin adenine dinucleotide (FAD), and NfnB harbors two [4Fe4S] clusters and FAD. M. thermoacetica contains a second electron-bifurcating enzyme. Cell extracts catalyzed the coupled reduction of NAD(+) and Fd with 2 H(2) molecules. The specific activity of this cytoplasmic enzyme was 3-fold higher in H(2)-CO(2)-grown cells than in glucose-grown cells. The function of this electron-bifurcating hydrogenase is not yet clear, since H(2)-CO(2)-grown cells additionally contain high specific activities of an NADP(+)-dependent hydrogenase that catalyzes the reduction of NADP(+) with H(2). This activity is hardly detectable in glucose-grown cells.","affiliation":"Max Planck Institute for Terrestrial Microbiology, Marburg, Germany.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Carbon Dioxide","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"Hydrogen","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"Oxidoreductases","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"Glucose","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"Gene Expression Regulation, Bacterial","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"PH","qualifierName":"physiology"}]}},{"majorTopic_YN":"N","descriptorName":"Gene Expression Regulation, Enzymologic"},{"majorTopic_YN":"N","descriptorName":"Energy Metabolism","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"PH","qualifierName":"physiology"}]}},{"majorTopic_YN":"N","descriptorName":"Electrons"},{"majorTopic_YN":"N","descriptorName":"Molecular Sequence Data"},{"majorTopic_YN":"N","descriptorName":"Moorella","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"ME","qualifierName":"metabolism"}]}}]},"chemicalList":{"chemical":[{"name":"Oxidoreductases","registryNumber":"EC 1.-"},{"name":"Glucose","registryNumber":"IY9XDZ35W2"},{"name":"Carbon Dioxide","registryNumber":"142M471B3J"},{"name":"Hydrogen","registryNumber":"7YNJ3PO35Z"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medi