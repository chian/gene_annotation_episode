uations":"N"},{"id":"5145910","source":"MED","pmid":"5145910","pmcid":"PMC1178194","fullTextIdList":{"fullTextId":["PMC1178194"]},"doi":"10.1042/bj1250879","title":"The purification and properties of butyryl-coenzyme A dehydrogenase from Peptostreptococcus elsdenii.","authorString":"Engel PC, Massey V.","authorList":{"author":[{"fullName":"Engel PC","lastName":"Engel","firstName":"P C","initials":"PC"},{"fullName":"Massey V","lastName":"Massey","firstName":"V","initials":"V"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"3","volume":"125","journalIssueId":492790,"dateOfPublication":"1971 Dec","monthOfPublication":12,"yearOfPublication":1971,"journal":{"medlineAbbreviation":"Biochem J","title":"The Biochemical journal","essn":"1470-8728","issn":"0264-6021","isoabbreviation":"Biochem J","nlmid":"2984726R"},"printPublicationDate":"1971-12-01"},"pubYear":"1971","pageInfo":"879-887","abstractText":"Butyryl-CoA dehydrogenase prepared by a simple procedure from Peptostreptococcus elsdenii has a molecular weight of approx. 150000. The enzyme has FAD as its prosthetic group. The amino acid analysis is reported. This enzyme, like most of the corresponding mammalian ones, is green. The absorption band at 710nm can be abolished irreversibly by dithionite reduction and air reoxidation; it can be abolished reversibly by phenylmercuric acetate or potassium bromide. The enzyme as isolated appears to be a mixture of a green and a yellow form, both of which are active. This view is supported by the variable ;greenness' of different preparations and the biphasic curve obtained in anaerobic spectrophotometric titrations with dithionite. It can be calculated from the titration results that fully green enzyme would have a peak-to-peak absorption ratio (E(710)/E(430)) as great as 0.54. The green form is much less rapidly reduced by dithionite than the yellow form, but is nevertheless much more readily reduced by dithionite than the enzyme from pig liver. It is also more readily reoxidized by air and shows less tendency to form a semiquinone. Treatment with sodium borohydride produces an unusual reduced species that is probably the 3,4-dihydroflavin.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Peptostreptococcus","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"EN","qualifierName":"enzymology"}]}},{"majorTopic_YN":"N","descriptorName":"Sulfuric Acids"},{"majorTopic_YN":"N","descriptorName":"Borohydrides"},{"majorTopic_YN":"N","descriptorName":"Butyrates"},{"majorTopic_YN":"N","descriptorName":"Coenzyme A"},{"majorTopic_YN":"N","descriptorName":"Flavin-Adenine Dinucleotide","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AN","qualifierName":"analysis"}]}},{"majorTopic_YN":"N","descriptorName":"Oxidoreductases","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AN","qualifierName":"analysis"},{"majorTopic_YN":"Y","abbreviation":"IP","qualifierName":"isolation & purification"}]}},{"majorTopic_YN":"N","descriptorName":"Amino Acids","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AN","qualifierName":"analysis"}]}},{"majorTopic_YN":"N","descriptorName":"Sulfhydryl Reagents"},{"majorTopic_YN":"N","descriptorName":"Chromatography, DEAE-Cellulose"},{"majorTopic_YN":"N","descriptorName":"Spectrophotometry"},{"majorTopic_YN":"N","descriptorName":"Oxidation-Reduction"},{"majorTopic_YN":"N","descriptorName":"Molecular Weight"},{"majorTopic_YN":"N","descriptorName":"Light"},{"majorTopic_YN":"N","descriptorName":"Color"}]},"chemicalList":{"chemical":[{"name":"Amino Acids","registryNumber":"0"},{"name":"Flavin-Adenine Dinucleotide","registryNumber":"146-14-5"},{"name":"Sulfuric Acids","registryNumber":"0"},{"name":"Butyrates","registryNumber":"0"},{"name":"Sulfhydryl Reagen