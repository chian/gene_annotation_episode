{"arguments":{"context":{"alternative":{"asserted_function":null,"construct":null,"dead_time":null,"detector":null,"genotype":null,"ionic_conditions":null,"membrane":null,"molecular_unit":null,"molecule":null,"normalization":null,"organism":null,"pH":null,"preparation":null,"time_window":null,"voltage":null},"alternative_ion":{"end":5068,"quote":"Cl<sup>\u2212</sup>","representation":"original","source_ref":"source_3ac268b7222de447b161afbf","start":5052},"assertion":null,"intended_change":null,"preferred":{"asserted_function":null,"construct":null,"dead_time":null,"detector":null,"genotype":null,"ionic_conditions":null,"membrane":null,"molecular_unit":null,"molecule":null,"normalization":null,"organism":null,"pH":null,"preparation":null,"time_window":null,"voltage":null},"preferred_ion":{"end":4742,"quote":"F<sup>\u2212</sup>","representation":"original","source_ref":"source_3ac268b7222de447b161afbf","start":4727}},"nonintended_differences":[],"relationships":{"alternative_ion_attribution":{"value":"unknown","witnesses":[]},"intended_ions":{"value":"different_ions","witnesses":[{"end":4742,"quote":"F<sup>\u2212</sup>","representation":"original","source_ref":"source_3ac268b7222de447b161afbf","start":4727},{"end":5068,"quote":"Cl<sup>\u2212</sup>","representation":"original","source_ref":"source_3ac268b7222de447b161afbf","start":5052}]},"nonintended_conditions":{"value":"unknown","witnesses":[]},"normalization":{"value":"unknown","witnesses":[]},"preferred_ion_attribution":{"value":"unknown","witnesses":[]},"preparations":{"value":"unknown","witnesses":[]},"quantity":{"value":"unknown","witnesses":[]},"subject_construct":{"value":"unknown","witnesses":[]}},"reported_ratio":{"derivation":{"value":"author_summary_inference","witnesses":[{"end":47645,"quote":"<p>A deeper enigma is Fluc\u2019s remarkable discrimination between F<sup>\u2212</sup>, which is so difficult to desolvate, and Cl<sup>\u2212</sup>, which is orders of magnitude more abundant in the environment. Li