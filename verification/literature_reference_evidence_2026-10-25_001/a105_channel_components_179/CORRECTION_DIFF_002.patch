+def test_unit_after_unselected_spread_constrains_mean_scale_and_dimension(suffix,code):
+    source = Source(current_suffix=suffix)
+    args = source.args()
+    assert args["measurements"]["current"]["spread"] is None
+    assert_error(code, read_channel_inputs, args, read_source=source.read)
+
+
+@pytest.mark.parametrize("suffix", [" ± 0.2 pA", " ± 0.2", " ± .2 pA", " ± 2e-1 pA",
+    " +/- 0.2 pA", " + − 0.2 pA", " &plusmn; 0.2 pA", " &#177; 0.2 pA",
+    " &#xB1; 0.2 pA", " ± <italic>0.2</italic> pA", " ±<br/>0.2<br/>pA",
+    " ± 0.2 (pA)"])
+def test_matching_unit_after_unselected_spread_preserves_mean_without_inventing_spread(suffix):
+    source = Source(current_suffix=suffix)
+    extraction,sheet = run(source)
+    assert extraction["values"]["current"] == 1.8
+    assert extraction["measurements"]["current"]["spread"] is None
+    assert sheet["cells"]["chord_conductance_variance"]["value"] is None
+
+
