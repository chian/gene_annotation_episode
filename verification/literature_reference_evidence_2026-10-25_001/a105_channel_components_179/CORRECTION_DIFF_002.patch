+    (" ± 0.2 pA/s", "partial_electrical_unit"),
+    (" ± 0.2 pA per cell", "partial_electrical_unit"),
+    (" ± 0.2 pA²", "partial_electrical_unit"),
+    (" ± 0.2 (nA)", "electrical_explicit_unit_mismatch"),
+    (" ± 0.2 (pA)/s", "partial_electrical_unit"),
+    (" ± 0.2 pA)/s", "partial_electrical_unit"),
