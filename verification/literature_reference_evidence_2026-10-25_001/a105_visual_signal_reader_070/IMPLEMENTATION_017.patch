+    IW = obj({'kind': {'const': 'image'}, 'view_ref': REF, 'region': BOX, 'quote': TEXT})
+    WITNESS = {'oneOf': [TW, IW]}
+    FRAGMENT = obj({'view_ref': REF, 'region': BOX, 'raw_fragment': {'type': ['string', 'null']}})
