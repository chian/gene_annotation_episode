+    trial = {"version": "controlled_response_owner_inputs_v2", "arms": {r:arms[r]["calculation_operand"] if arms[r] else None for r in PRIMITIVE_ORDER},
+        "relationships": _relationships_inputs(relationships), "covariance": covariance,
