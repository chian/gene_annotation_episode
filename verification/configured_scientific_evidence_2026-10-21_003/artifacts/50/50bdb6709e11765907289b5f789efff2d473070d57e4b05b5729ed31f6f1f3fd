e_PMC","url":"https://europepmc.org/articles/PMC3187277"},{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC3187277?pdf=render"},{"availability":"Free","availabilityCode":"F","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1128/iai.01390-10"}]},"isOpenAccess":"N","inEPMC":"Y","inPMC":"Y","citedByCount":92,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"Y","dbCrossReferenceList":{"dbName":["EMBL"]},"hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"Y","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["geo"]},"dateOfCompletion":"2011-11-15","dateOfCreation":"2011-07-20","dateOfRevision":"2024-01-09","electronicPublicationDate":"2011-07-18","firstPublicationDate":"2011-07-18","firstIndexDate":"2011-07-20","fullTextReceivedDate":"2025-02-02","hasEvaluations":"N"},{"id":"18199838","source":"MED","pmid":"18199838","pmcid":"PMC2242690","fullTextIdList":{"fullTextId":["PMC2242690"]},"doi":"10.1073/pnas.0709671105","title":"High-confidence prediction of global interactomes based on genome-wide coevolutionary networks.","authorString":"Juan D, Pazos F, Valencia A.","authorList":{"author":[{"fullName":"Juan D","lastName":"Juan","firstName":"David","initials":"D","authorId":{"type":"ORCID","value":"0000-0003-1912-9667"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Structural Bioinformatics Group, Spanish National Cancer Research Centre, Melchor Fernández Almagro 3, 28029 Madrid, Spain."}]}},{"fullName":"Pazos F","lastName":"Pazos","firstName":"Florencio","initials":"F","authorId":{"type":"ORCID","value":"0000-0002-2646-6226"}},{"fullName":"Valencia A","lastName":"Valencia","firstName":"Alfonso","initials":"A"}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2646-6226"},{"type":"ORCID","value":"0000-0003-1912-9667"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"3","volume":"105","journalIssueId":1502374,"dateOfPublication":"2008 Jan","monthOfPublication":1,"yearOfPublication":2008,"journal":{"medlineAbbreviation":"Proc Natl Acad Sci U S A","title":"Proceedings of the National Academy of Sciences of the United States of America","essn":"1091-6490","issn":"0027-8424","isoabbreviation":"Proc Natl Acad Sci U S A","nlmid":"7505876"},"printPublicationDate":"2008-01-01"},"pubYear":"2008","pageInfo":"934-939","abstractText":"Interacting or functionally related protein families tend to have similar phylogenetic trees. Based on this observation, techniques have been developed to predict interaction partners. The observed degree of similarity between the phylogenetic trees of two proteins is the result of many different factors besides the actual interaction or functional relationship between them. Such factors influence the performance of interaction predictions. One aspect that can influence this similarity is related to the fact that a given protein interacts with many others, and hence it must adapt to all of them. Accordingly, the interaction or coadaptation signal within its tree is a composite of the influence of all of the interactors. Here, we introduce a new estimator of coevolution to overcome this and other problems. Instead of relying on the individual value of tree similarity between two proteins, we use the whole network of similarities between all of the pairs of proteins within a genome to reassess the similarity of that pair, thereby taking into account its coevolutionary context. We show that this approach offers a substantial improvement in interaction prediction performance, providing a degree of accuracy/coverage comparable with, or in some cases better than, that of experimental techniques. Moreover, important information on the structure, function, and evolution of macromolecular complexes can be inferred with this methodology.","affiliation":"Structural Bioinformatics Group, Spanish National Cancer Research Centre, Melchor Fernández Almagro 3, 28029 Madrid, Spain.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Proteins","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Sensitivity and Specificity"},{"majorTopic_YN":"N","descriptorName":"Genome","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Biological Evolution"}]},"chemicalList":{"chemical":[{"name":"Proteins","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Unpaywall","url":"https://europepmc.org/articles/pmc2242690?pdf=render"},{"availability":"Free after 6 months","availabilityCode":"F6","documentStyle":"abs","site":"www.pnas.org","url":"http://www.pnas.org/cgi/content/abstract/105/3/934"},{"availability":"Free after 6 months","availabilityCode":"F6","documentStyle":"html","site":"www.pnas.org","url":"http://www.pnas.org/cgi/content/full/105/3/934"},{"availability":"Free after 6 months","availabilityCode":"F6","documentStyle":"pdf","site":"www.pnas.org","url":"http://www.pnas.org/cgi/reprint/105/3/934.pdf"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1073/pnas.0709671105"},{"availability":"Free","availabilityCode":"F","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC2242690"},{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC2242690?pdf=render"},{"availability":"Free","availabilityCode":"F","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1073/pnas.0709671105"}]},"isOpenAccess":"N","inEPMC":"Y","inPMC":"Y","citedByCount":118,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2008-02-12","dateOfCreation":"2008-01-18","dateOfRevision":"2018-11-13","electronicPublicationDate":"2008-01-16","firstPublicationDate":"2008-01-16","firstIndexDate":"2009-12-24","fullTextReceivedDate":"2025-02-02","hasEvaluations":"N"},{"id":"22210761","source":"MED","pmid":"22210761","pmcid":"PMC3294845","fullTextIdList":{"fullTextId":["PMC3294845"]},"doi":"10.1128/jb.06105-11","title":"Analysis of the Pseudomonas aeruginosa regulon controlled by the sensor kinase KinB and sigma factor RpoN.","authorString":"Damron FH, Owings JP, Okkotsu Y, Varga JJ, Schurr JR, Goldberg JB, Schurr MJ, Yu HD.","authorList":{"author":[{"fullName":"Damron FH","lastName":"Damron","firstName":"F Heath","initials":"FH","authorId":{"type":"ORCID","value":"0000-0002-3140-402X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biochemistry and Microbiology, Joan C. Edwards School of Medicine, Marshall University, Huntington, West Virginia, USA."}]}},{"fullName":"Owings JP","lastName":"Owings","firstName":"Joshua P","initials":"JP"},{"fullName":"Okkotsu Y","lastName":"Okkotsu","firstName":"Yuta","initials":"Y"},{"fullName":"Varga JJ","lastName":"Varga","firstName":"John J","initials":"JJ","authorId":{"type":"ORCID","value":"0000-0002-4868-1971"}},{"fullName":"Schurr JR","lastName":"Schurr","firstName":"Jill R","initials":"JR"},{"fullName":"Goldberg JB","lastName":"Goldberg","firstName":"Joanna B","initials":"JB"},{"fullName":"Schurr MJ","lastName":"Schurr","firstName":"Michael J","initials":"MJ"},{"fullName":"Yu HD","lastName":"Yu","firstName":"Hongwei D","initials":"HD","authorId":{"type":"ORCID","value":"0000-0002-8546-0158"}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3140-402X"},{"type":"ORCID","value":"0000-0002-4868-1971"},{"type":"ORCID","value":"0000-0002-8546-0158"},{"type":"ORCID","value":"0000-0003-2585-0477"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data","related_data"]},"journalInfo":{"issue":"6","volume":"194","journalIssueId":1909126,"dateOfPublication":"2012 Mar","monthOfPublication":3,"yearOfPublication":2012,"journal":{"medlineAbbreviation":"J Bacteriol","title":"Journal of bacteriology","essn":"1098-5530","issn":"0021-9193","isoabbreviation":"J Bacteriol","nlmid":"2985120R"},"printPublicationDate":"2012-03-01"},"pubYear":"2012","pageInfo":"1317-1330","abstractText":"Alginate overproduction by Pseudomonas aeruginosa, also known as mucoidy, is associated with chronic endobronchial infections in cystic fibrosis. Alginate biosynthesis is initiated by the extracytoplasmic function sigma factor (σ(22); AlgU/AlgT). In the wild-type (wt) nonmucoid strains, such as PAO1, AlgU is sequestered to the cytoplasmic membrane by the anti-sigma factor MucA that inhibits alginate production. One mechanism underlying the conversion to mucoidy is mutation of mucA. However, the mucoid conversion can occur in wt mucA strains via the degradation of MucA by activated intramembrane proteases AlgW and/or MucP. Previously, we reported that the deletion of the sensor kinase KinB in PAO1 induces an AlgW-dependent proteolysis of MucA, resulting in alginate overproduction. This type of mucoid induction requires the alternate sigma factor RpoN (σ(54)). To determine the RpoN-dependent KinB regulon, microarray and proteomic analyses were performed on a mucoid kinB mutant and an isogenic nonmucoid kinB rpoN double mutant. In the kinB mutant of PAO1, RpoN controlled the expression of approximately 20% of the genome. In addition to alginate biosynthetic and regulatory genes, KinB and RpoN also control a large number of genes including those involved in carbohydrate metabolism, quorum sensing, iron regulation, rhamnolipid production, and motility. In an acute pneumonia murine infection model, BALB/c mice exhibited increased survival when challenged with the kinB mutant relative to survival with PAO1 challenge. Together, these data strongly suggest that KinB regulates virulence factors important for the development of acute pneumonia and conversion to mucoidy.","affiliation":"Department of Biochemistry and Microbiology, Joan C. Edwards School of Medicine, Marshall University, Huntington, West Virginia, USA.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Research Support, U.S. Gov't, Non-P.H.S.","Journal Article","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"T32 AI055432","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"AI07406","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"T32 AI007046","orderIn":0},{"agency":"NCRR NIH HHS","acronym":"RR","grantId":"P20 RR016477","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"R01 AI050812-01","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"R01 AI050812","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"5T32AI055432","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"R01 AI068112","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Mice, Inbred BALB C"},{"majorTopic_YN":"N","descriptorName":"Mice"},{"majorTopic_YN":"N","descriptorName":"Pseudomonas aeruginosa","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"Y","abbreviation":"ME","qualif