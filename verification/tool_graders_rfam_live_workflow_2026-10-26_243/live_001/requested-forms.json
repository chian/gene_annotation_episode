            "type": "integer"
          },
          "continuation_cost": {
            "description": "The actual child's decision threshold in its configured controller units.",
            "minimum": 0,
            "type": "number"
          },
          "expected_next_gain": {
            "additionalProperties": false,
            "properties": {
              "alpha": {
                "description": "Original band parameter: -1 unavailable; 0 exact; otherwise the configured tail parameter.",
                "type": "number"
              },
              "lower": {
                "description": "The original band's lower coordinate; read status_code before interpreting it.",
                "type": "number"
              },
              "status_code": {
                "description": "0 normal; -1 insufficient observations; -2 unidentifiable. Coded coordinates are not negative forecasts.",
                "enum": [
                  0,
                  -1,
                  -2
                ],
                "type": "integer"
              },
              "uncertainty_code": {
                "description": "-1 unavailable; 0 exact; 1 Chebyshev; 2 Laplace approximation. The code does not establish calibrated coverage.",
                "enum": [
                  -1,
                  0,
                  1,
                  2
                ],
                "type": "integer"
              },
              "upper": {
                "description": "The original band's upper coordinate; read status_code before interpreting it.",
                "type": "number"
              },
              "value": {
                "description": "The original band point in this child's configured controller units.",
                "type": "number"
              }
            },
            "required": [
              "value",
              "lower",
              "upper",
              "status_code",
              "uncertainty_code",
              "alpha"
            ],
            "type": "object"
          },
          "stop_requested": {
            "description": "The child's controller decision, not a parent instruction, job cancellation or scientific completion.",
            "type": "boolean"
          }
        },
        "required": [
          "completed_actions",
          "expected_next_gain",
          "continuation_cost",
          "stop_requested"
        ],
