new file mode 100644
--- /dev/null
+++ b/gene_annotation_episode/native_flux_balance_contracts.py
@@ -0,0 +1,142 @@
+"""Execution envelope for one selected, source-derived Cobra/GLPK FBA call.
+
+Analytical records are owned by ``flux_balance_contracts``. This module only
+validates execution paths, the selected software closure and the run envelope.
+It neither discovers a resource nor starts work.
+"""
+from copy import deepcopy
+import os
+from pathlib import PurePosixPath
+
+from .execution_contracts import canonical, digest
+from .flux_balance_contracts import validate_flux_balance_record
+
+RUN_PLAN_FILENAME = "flux-balance-plan.json"
+ATTEMPT_DIRECTORY_NAME = "flux-balance-attempt"
+OWNER_FILENAME = ".native-flux-balance-owner.json"
+STARTED_FILENAME = ".native-flux-balance-started.json"
+SOLVE_ENTERED_FILENAME = ".native-flux-balance-solve-entered.json"
+DRIVER_MODULE = "gene_annotation_episode.native_flux_balance_driver"
+POLICY = {"memory_bytes": 21474836480, "scratch_bytes": 4294967296, "wall_seconds": None}
+SOURCE_FUNCTION_SHA256 = "ab47e2640366833d05cf896091e1c3803ce69aae940bfa46ba993abda51983b9"
+STACK = {"cobra": "0.32.1", "optlang": "1.9.1", "swiglpk": "5.0.13", "python-libsbml": "5.21.2"}
+ARTIFACT_FORMATS = {
+    "selected_request": "flux_balance_selected_request_v1", "effective_model": "cobra_model_capture_v1",
+    "effective_problem": "cobra_glpk_problem_capture_v1", "solution": "cobra_glpk_solution_capture_v1",
+    "flux_csv": "biomni_fba_csv_v1", "native_log": "utf8_text", "manifest": "flux_balance_native_manifest_v1",
+}
+
+
+def require(condition, code):
+    if not condition:
+        raise ValueError(code)
+
+
+def path_value(value, *, absolute):
+    require(type(value) is str and value and not any(c in value for c in "\0\r\n\\"), "fba_invalid_path")
+    path = PurePosixPath(value)
+    require(path.is_absolute() == absolute and str(path) == value and ".." not in path.parts
+            and value not in (".", "/") and not value.startswith("//"), "fba_invalid_path")
+    return path
+
+
+def validate_flux_balance_software(value):
+    value = validate_flux_balance_record("FBASoftware", value)
+    require(value["solver_interface"] == "optlang.glpk_interface", "solver_unavailable")
+    for field in ("python_home", "module_root"):
+        path_value(value[field], absolute=True)
+    roots = [path_value(p, absolute=True) for p in value["dependency_roots"]]
+    require(roots and len(set(roots)) == len(roots), "fba_dependency_root_unbound")
+    pins = [value["python"], *value["implementation_files"], *value["runtime_files"], *value["solver_runtime_files"]]
+    paths = [str(path_value(p["path"], absolute=True)) for p in pins]
+    require(len(paths) == len(set(paths)), "fba_duplicate_software_file")
+    required = {str(PurePosixPath(value["module_root"]) / "gene_annotation_episode" / filename) for filename in (
+        "__init__.py", "execution_contracts.py", "flux_balance_contracts.py", "native_flux_balance_contracts.py",
+        "native_flux_balance_storage.py", "native_flux_balance_cobra_glpk.py", "native_flux_balance_driver.py")}
+    require(required <= {p["path"] for p in value["implementation_files"]}, "fba_implementation_closure_incomplete")
+    distributions = {p["name"].lower().replace("_", "-"): p["version"] for p in value["distributions"]}
+    require(len(distributions) == len(value["distributions"]) and all(distributions.get(k) == v for k, v in STACK.items()),
+            "fba_distribution_selection_mismatch")
+    require(value["runtime_files"] and value["solver_runtime_files"], "fba_runtime_closure_incomplete")
+    require(all(any(PurePosixPath(p["path"]).is_relative_to(root) for p in value["runtime_files"]) for root in roots),
+            "fba_dependency_root_unbound")
+    require(any(PurePosixPath(p["path"]).is_relative_to(PurePosixPath(value["python_home"]) / "lib")
+                for p in value["runtime_files"]), "fba_standard_library_binding_missing")
+    return value
+
+
+def flux_balance_environment(software, *, attempt_directory, lifecycle_directory):
+    software = validate_flux_balance_software(software)
+    attempt = path_value(attempt_directory, absolute=True)
+    lifecycle = path_value(lifecycle_directory, absolute=True)
+    require(attempt == lifecycle / ATTEMPT_DIRECTORY_NAME, "fba_original_attempt_mismatch")
+    return {"PYTHONPATH": os.pathsep.join([software["module_root"], *software["dependency_roots"]]),
+            "PYTHONHOME": software["python_home"], "PYTHONDONTWRITEBYTECODE": "1", "PYTHONNOUSERSITE": "1",
+            "PYTHONSAFEPATH": "1", "OPENBLAS_NUM_THREADS": "1", "OMP_NUM_THREADS": "1",
+            "TMPDIR": str(lifecycle), "TMP": str(lifecycle), "TEMP": str(lifecycle),
+            "XDG_CACHE_HOME": str(attempt / "cache"), "PIP_CACHE_DIR": str(attempt / "cache/pip")}
+
+
+def validate_flux_balance_requested_job(value):
+    value = validate_flux_balance_record("FBARequestedJob", value)
+    job = value["native_flux_balance"]
+    software = validate_flux_balance_software(job["software"])
+    require(job["source_function_sha256"] == SOURCE_FUNCTION_SHA256, "fba_source_function_mismatch")
+    path_value(job["model_input"]["file"]["path"], absolute=True)
+    prefix = path_value(job["output_prefix"], absolute=False)
+    path_value(job["flux_output_name"], absolute=False)
+    require(not prefix.parts[0].startswith(".") and prefix.parts[0] not in {"tmp", "cache"}, "fba_invalid_output_prefix")
+    lifecycle = value["environment"].get("TMPDIR")
+    require(type(lifecycle) is str, "fba_runtime_environment_mismatch")
+    expected = flux_balance_environment(software, attempt_directory=str(PurePosixPath(lifecycle) / ATTEMPT_DIRECTORY_NAME),
+                                        lifecycle_directory=lifecycle)
+    require(value["environment"] == expected, "fba_runtime_environment_mismatch")
+    require(value["argv"] == [software["python"]["path"], "-B", "-S", "-m", DRIVER_MODULE, RUN_PLAN_FILENAME],
+            "fba_requested_argv_mismatch")
+    flux_balance_output_files(job)
+    return value
+
+
+def flux_balance_output_files(job):
+    job = validate_flux_balance_record("FBAJob", job)
+    prefix = path_value(job["output_prefix"], absolute=False)
+    names = {"original_model": "original-model.xml" if job["model_input"]["format"] == "sbml" else "original-model.json",
+             "selected_request": "selected-request.json", "effective_model": "model-capture.json",
+             "effective_problem": "problem-capture.json", "solution": "solution-capture.json",
+             "flux_csv": job["flux_output_name"], "native_log": "native-log.txt", "manifest": "native-manifest.json"}
+    paths = [prefix / path_value(name, absolute=False) for name in names.values()]
+    require(len(paths) == len(set(paths)) and not any(a.is_relative_to(b) for a in paths for b in paths if a != b),
+            "fba_output_role_mismatch")
+    return [{"role": role, "relative_path": str(prefix / names[role]),
+             "format": job["model_input"]["format"] if role == "original_model" else ARTIFACT_FORMATS[role]}
+            for role in names]
+
+
+def validate_flux_balance_run_plan(value):
+    require(type(value) is dict and set(value) == {"version", "identity", "requested_job", "attempt_directory", "policy", "outputs"}
+            and value["version"] == "flux_balance_run_plan_v1", "fba_invalid_run_plan")
+    request = validate_flux_balance_requested_job(value["requested_job"])
+    owner = validate_flux_balance_record("FBAAttemptIdentity", value["identity"])
+    execution = path_value(owner["execution_id"], absolute=True)
+    attempt = path_value(value["attempt_directory"], absolute=True)
+    require(execution.name == "native.json" and attempt == execution.parent / ATTEMPT_DIRECTORY_NAME
+            and owner["attempt_id"] == digest(owner["operation_key"])
+            and owner["requested_job_sha256"] == digest(request)
+            and execution.parent.name == owner["attempt_id"]
+            and execution.parent.parent.name == digest({"run": owner["run_id"], "episode": owner["episode_id"]})
+            and execution.parent.parent.parent.name == ".episode-operations", "fba_original_attempt_mismatch")
+    require(request["environment"] == flux_balance_environment(request["native_flux_balance"]["software"],
+            attempt_directory=str(attempt), lifecycle_directory=str(execution.parent)), "fba_runtime_environment_mismatch")
+    require(canonical(value["policy"]) == canonical(POLICY), "fba_original_allocation_mismatch")
+    require(value["outputs"] == flux_balance_output_files(request["native_flux_balance"]), "fba_output_role_mismatch")
+    job = request["native_flux_balance"]
+    protected = [job["model_input"]["file"]["path"], job["software"]["python_home"], job["software"]["module_root"],
+                 *job["software"]["dependency_roots"], *[p["path"] for p in job["software"]["solver_runtime_files"]]]
+    require(all(not PurePosixPath(p).is_relative_to(execution.parent) and not execution.parent.is_relative_to(PurePosixPath(p))
+                for p in protected), "fba_input_output_overlap")
+    return deepcopy(value)
+
+
+def flux_balance_driver_argv(plan):
+    plan = validate_flux_balance_run_plan(plan)
+    return [*plan["requested_job"]["argv"][:-1], str(PurePosixPath(plan["identity"]["execution_id"]).parent / RUN_PLAN_FILENAME)]
diff --git a/gene_annotation_episode/native_flux_balance_storage.py b/gene_annotation_episode/native_flux_balance_storage.py
new file mode 100644
--- /dev/null
+++ b/gene_annotation_episode/native_flux_balance_storage.py
@@ -0,0 +1,144 @@
+"""Confined immutable FBA bytes; this module grants no execution authority."""
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import uuid
+
+from .execution_contracts import canonical
+from .native_flux_balance_contracts import path_value, require
+
+
+@contextmanager
+def _directory_fd(path, *, create=False):
+    path = path_value(str(path), absolute=True)
+    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        for part in path.parts[1:]:
+            if create:
+                try:
+                    os.mkdir(part, mode=0o700, dir_fd=fd)
+                except FileExistsError:
+                    pass
+            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+            os.close(fd)
+            fd = next_fd
+        yield fd
+    finally:
+        os.close(fd)
+
+
+def directory(path, *, create=False):
+    with _directory_fd(path, create=create):
+        pass
+    return Path(path)
+
+
+def confined_file(root, relative, *, create_parents=False):
+    root = path_value(str(root), absolute=True)
+    relative = path_value(relative, absolute=False)
+    target = Path(root / relative)
+    with _directory_fd(target.parent, create=create_parents) as fd:
+        try:
+            observed = os.stat(target.name, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError:
+            return target
+        require(stat.S_ISREG(observed.st_mode), "fba_non_regular_or_symlink")
+    return target
+
+
+@contextmanager
+def regular(path):
+    path = Path(path_value(str(path), absolute=True))
+    with _directory_fd(path.parent) as parent:
+        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+    stream = os.fdopen(fd, "rb")
+    try:
+        require(stat.S_ISREG(os.fstat(fd).st_mode), "fba_non_regular_file")
+        yield stream
+    finally:
+        stream.close()
+
+
+def _stable(before, after):
+    return (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) == (
+        after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
+
+
+def file_pin(path):
+    h = hashlib.sha256()
+    with regular(path) as stream:
+        before = os.fstat(stream.fileno())
+        while block := stream.read(1024 * 1024):
+            h.update(block)
+        require(_stable(before, os.fstat(stream.fileno())), "fba_file_changed_during_read")
+    return {"path": str(path), "sha256": h.hexdigest(), "size_bytes": before.st_size}
+
+
+@contextmanager
+def _exclusive_output(path):
+    path = Path(path_value(str(path), absolute=True))
+    with _directory_fd(path.parent, create=True) as parent:
+        temporary = ".fba-writing-" + uuid.uuid4().hex
+        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent)
+        # On failure the explicitly named unfinished bytes stay in the attempt.
+        with os.fdopen(fd, "wb") as stream:
+            yield stream
+            stream.flush()
+            os.fsync(stream.fileno())
+            os.fchmod(stream.fileno(), 0o444)
+        os.link(temporary, path.name, src_dir_fd=parent, dst_dir_fd=parent, follow_symlinks=False)
+        os.unlink(temporary, dir_fd=parent)
+        os.fsync(parent)
+
+
+def immutable_bytes(path, raw):
+    require(type(raw) is bytes, "fba_bytes_required")
+    with _exclusive_output(path) as stream:
+        stream.write(raw)
+
+
+def immutable_json(path, value):
+    immutable_bytes(path, canonical(value).encode("utf-8") + b"\n")
+
+
+def retain_input(source, target, *, max_bytes):
+    """One stable streaming read and exclusive publication of the actual bytes."""
+    h = hashlib.sha256()
+    size = 0
+    with regular(source) as original, _exclusive_output(target) as output:
+        before = os.fstat(original.fileno())
+        require(before.st_size <= max_bytes, "fba_input_exceeds_scratch_limit")
+        while block := original.read(1024 * 1024):
+            size += len(block)
+            require(size <= max_bytes, "fba_input_exceeds_scratch_limit")
+            h.update(block)
+            output.write(block)
+        require(_stable(before, os.fstat(original.fileno())) and size == before.st_size, "fba_file_changed_during_read")
+    return {"sha256": h.hexdigest(), "size_bytes": size}
+
+
+def decode_json(raw):
+    def pairs(rows):
+        result = {}
+        for key, value in rows:
+            require(key not in result, "fba_duplicate_json_key")
+            result[key] = value
+        return result
+    def nonfinite(_):
+        raise ValueError("fba_nonfinite_json")
+    return json.loads(raw, object_pairs_hook=pairs, parse_constant=nonfinite)
+
+
+def read_bytes(path):
+    with regular(path) as stream:
+        before = os.fstat(stream.fileno())
+        value = stream.read()
+        require(_stable(before, os.fstat(stream.fileno())), "fba_file_changed_during_read")
+        return value
+
+
+def read_json(path):
+    return decode_json(read_bytes(path))
diff --git a/gene_annotation_episode/native_flux_balance_cobra_glpk.py b/gene_annotation_episode/native_flux_balance_cobra_glpk.py
new file mode 100644
--- /dev/null
+++ b/gene_annotation_episode/native_flux_balance_cobra_glpk.py
@@ -0,0 +1,961 @@
+"""Read the pinned live Cobra/GLPK objects around one original invocation.
+
+Scientific imports occur only when these helpers are called in the selected
+bounded process. This module captures source operands and native observations;
+it contains no feasibility, residual, objective or annotation-score calculator.
+"""
+from contextlib import contextmanager
+from copy import deepcopy
+import io
+import json
+import math
+import os
+from pathlib import Path
+import tempfile
+import traceback
+import xml.etree.ElementTree as ET
+from xml.parsers import expat
+
+from .execution_contracts import canonical, digest
+from .flux_balance_contracts import flux_balance_schema
+from .native_flux_balance_contracts import require
+from .native_flux_balance_storage import decode_json, directory, read_bytes
+
+
+def location(role, pointer):
+    return {"role": role, "pointer": pointer}
+
+
+def issue(code, stage, field=None, **positions):
+    row = {"code": code, "stage": stage, "field": field, "source_row_index": None,
+           "reaction_position": None, "metabolite_position": None, "variable_position": None,
+           "constraint_position": None, "detail_file": None}
+    row.update(positions)
+    return row
+
+
+def exception(error, stage, operation):
+    return {"stage": stage, "operation": operation, "exception_module": type(error).__module__,
+            "exception_class": type(error).__name__, "message": str(error),
+            "traceback": "".join(traceback.format_exception(type(error), error, error.__traceback__))}
+
+
+def observation(value):
+    if value is None:
+        return {"state": "missing", "value": None, "native_token": None, "float_hex": None}
+    if type(value) is int:
+        return {"state": "present", "value": value, "native_token": str(value), "float_hex": None}
+    number = float(value)
+    return {"state": "present" if math.isfinite(number) else "nonfinite",
+            "value": number if math.isfinite(number) else None,
+            "native_token": repr(number), "float_hex": number.hex() if math.isfinite(number) else None}
+
+
+def number(value=None, *, role, pointer, missing_reason="unavailable_source"):
+    raw = observation(value)
+    return {**raw, "precision": "full_native" if raw["state"] == "present" else "unknown",
+            "source": location(role, pointer) if value is not None else None,
+            "missing_reason": missing_reason if value is None else None}
+
+
+def _number_observed(raw, *, role, pointer, established=True, missing_reason="primal_not_established"):
+    if not established or raw is None or raw.get("state") == "missing":
+        return number(role=role, pointer=pointer, missing_reason=missing_reason if not established else "not_returned")
+    return {k: raw[k] for k in ("state", "value", "native_token", "float_hex")} | {
+        "precision": "full_native" if raw["state"] == "present" else "unknown",
+        "source": location(role, pointer), "missing_reason": None}
+
+
+def bound(value, *, role, pointer):
+    value = float(value)
+    if math.isfinite(value):
+        return {"kind": "finite", "value": value, "native_token": repr(value), "float_hex": value.hex(),
+                "source": location(role, pointer)}
+    return {"kind": "negative_infinity" if value == -math.inf else "positive_infinity" if value == math.inf else "invalid",
+            "value": None, "native_token": repr(value), "float_hex": None, "source": location(role, pointer)}
+
+
+def unknown_unit():
+    return {"native_text": None, "basis": "unknown", "source": None}
+
+
+def _name(value):
+    return value if type(value) is str and value else None
+
+
+def _escape(value):
+    return str(value).replace("~", "~0").replace("/", "~1")
+
+
+def _xml_name(value):
+    if value.startswith("{"):
+        namespace, name = value[1:].split("}", 1)
+        return {"namespace_uri": namespace, "local_name": name}
+    return {"namespace_uri": None, "local_name": value}
+
+
+def _source_audit(raw, profile):
+    audit = {"version": "cobra_fba_source_audit_v1", "input_profile": profile,
+             "original_model": location("original_model", ""), "xml_elements": None, "issues": []}
+    if profile == "cobra_json":
+        return audit, decode_json(raw)
+    # No DTD or external entity resolution; preserve original bytes separately.
+    parser = expat.ParserCreate()
+    def forbidden(*_):
+        raise ValueError("source_semantics_unsupported:doctype_or_entity")
+    parser.StartDoctypeDeclHandler = forbidden
+    parser.ExternalEntityRefHandler = forbidden
+    parser.Parse(raw, True)
+    rows, stack, namespaces, siblings, elements = [], [], [], {}, []
+    for event, item in ET.iterparse(io.BytesIO(raw), events=("start-ns", "start", "end")):
+        if event == "start-ns":
+            namespaces.append({"prefix": item[0], "uri": item[1]})
+        elif event == "start":
+            parent = stack[-1][0] if stack else None
+            name = _xml_name(item.tag)
+            key = (parent, item.tag)
+            ordinal = siblings.get(key, 0)
+            siblings[key] = ordinal + 1
+            index = len(rows)
+            path = (deepcopy(rows[parent]["path"]) if parent is not None else []) + [{"name": name, "sibling_ordinal": ordinal}]
+            rows.append({"source_record_index": index, "path": path, "parent_source_record_index": parent,
+                         "child_source_record_indices": [], "namespace_declarations": namespaces,
+                         "attributes": [{"name": _xml_name(k), "value": v} for k, v in item.attrib.items()],
+                         "text": None, "tail": None})
+            elements.append(item)
+            namespaces = []
+            if parent is not None:
+                rows[parent]["child_source_record_indices"].append(index)
+            stack.append((index, item))
+        else:
+            index, _ = stack.pop()
+    # Tails can finish after an end event at an incremental parser boundary.
+    for row, element in zip(rows, elements):
+        row["text"], row["tail"] = element.text, element.tail
+    audit["xml_elements"] = rows
+    return audit, None
+
+
+def _attribute(row, name, *, namespace=None):
+    for index, attr in enumerate(row["attributes"]):
+        if attr["name"]["local_name"] == name and (namespace is None or attr["name"]["namespace_uri"] == namespace):
+            return attr["value"], f"/source_audit/xml_elements/{row['source_record_index']}/attributes/{index}/value"
+    return None, None
+
+
+def _source_information(audit, original_json, model=None):
+    """Source-ID joins and declared transformations; no biological inference."""
+    from cobra.io import sbml
+    entries, features, source_reactions, missing_bounds = [], [], {}, set()
+    unsupported = False
+    has_objective = False
+    axes = {"compartment": "compartments", "gene": "genes", "metabolite": "metabolites", "reaction": "reactions", "group": "groups"}
+    if audit["input_profile"] == "cobra_json":
+        require(type(original_json) is dict, "source_semantics_unsupported")
+        entries.append(("model", None, original_json.get("id"), original_json.get("id"), location("original_model", "/id") if "id" in original_json else location("original_model", "")))
+        for kind, axis in axes.items():
+            values = original_json.get(axis, {} if kind == "compartment" else [])
+            iterator = list(values.items()) if kind == "compartment" and isinstance(values, dict) else enumerate(values)
+            for i, (key, value) in enumerate(iterator):
+                sid = key if kind == "compartment" else value.get("id")
+                pointer = f"/{axis}/{_escape(key)}" if kind == "compartment" else f"/{axis}/{i}/id"
+                entries.append((kind, i, sid, sid, location("original_model", pointer)))
+                if kind == "reaction":
+                    source_reactions[sid] = {"gpr_native": value.get("gene_reaction_rule"), "gpr_pointer": None, "flux_unit": unknown_unit(),
+                                              "json_source": deepcopy(value), "source_index": i}
+                    if "lower_bound" not in value or "upper_bound" not in value:
+                        missing_bounds.add(sid)
+                        features.append({"kind": "default_bound", "source": location("original_model", f"/reactions/{i}"), "disposition": "transformed"})
+                    has_objective |= "objective_coefficient" in value
+        recognized = {"id", "name", "notes", "annotation", "compartments", "metabolites", "reactions", "genes", "version"}
+        for key in original_json.keys() - recognized:
+            features.append({"kind": "ignored_json_field", "source": location("original_model", "/" + _escape(key)), "disposition": "unsupported"})
+            unsupported = True
+    else:
+        rows = audit["xml_elements"]
+        parameters = {_attribute(r, "id")[0]: r for r in rows if r["path"][-1]["name"]["local_name"] == "parameter"}
+        mapping = {"model": ("model", None), "compartment": ("compartment", None),
+                   "species": ("metabolite", sbml.F_SPECIE), "geneProduct": ("gene", sbml.F_GENE),
+                   "reaction": ("reaction", sbml.F_REACTION), "group": ("group", sbml.F_GROUP)}
+        active_ids = {_attribute(row, "activeObjective")[0] for row in rows if row["path"][-1]["name"]["local_name"] == "listOfObjectives"}
+        for row in rows:
+            tag = row["path"][-1]["name"]["local_name"]
+            source = location("effective_model", f"/source_audit/xml_elements/{row['source_record_index']}")
+            if tag in mapping:
+                kind, replacement = mapping[tag]
+                sid, ptr = _attribute(row, "id")
+                loaded = sbml.F_REPLACE[replacement](sid) if sid is not None and replacement else sid
+                entries.append((kind, row["source_record_index"], sid, loaded,
+                                location("effective_model", ptr) if ptr else source))
+                if kind == "reaction":
+                    gpr = next((i for i in row["child_source_record_indices"] if rows[i]["path"][-1]["name"]["local_name"] == "geneProductAssociation"), None)
+                    units = []
+                    for side in ("lowerFluxBound", "upperFluxBound"):
+                        parameter = parameters.get(_attribute(row, side)[0])
+                        units.append(_attribute(parameter, "units") if parameter is not None else (None, None))
+                    unit = {"native_text": units[0][0], "basis": "supplied", "source": location("effective_model", units[0][1])} if (
+                        units[0][0] and units[0][0] == units[1][0]) else unknown_unit()
+                    source_reactions[loaded] = {"gpr_native": None, "flux_unit": unit,
+                        "gpr_pointer": None if gpr is None else f"/source_audit/xml_elements/{gpr}", "json_source": None,
+                        "source_index": row["source_record_index"]}
+                    if any(_attribute(row, side)[0] is None for side in ("lowerFluxBound", "upperFluxBound")):
+                        missing_bounds.add(loaded)
+                        features.append({"kind": "default_bound", "source": source, "disposition": "transformed"})
+                if kind == "metabolite" and _attribute(row, "boundaryCondition")[0] in {"true", "1"}:
+                    features.append({"kind": "boundary_exchange_creation", "source": source, "disposition": "transformed"})
+                    # This exact ID rule is from the selected loader, not a guessed join.
+                    missing_bounds.add("EX_" + loaded)
+            if tag == "objective" and _attribute(row, "id")[0] in active_ids:
+                has_objective = any(rows[i]["path"][-1]["name"]["local_name"] == "listOfFluxObjectives"
+                                    and bool(rows[i]["child_source_record_indices"]) for i in row["child_source_record_indices"])
+            feature = {"assignmentRule": "dynamic_rule", "rateRule": "dynamic_rule", "algebraicRule": "dynamic_rule",
+                       "event": "event", "initialAssignment": "initial_assignment", "stoichiometryMath": "nonconstant_stoichiometry",
+                       "kineticLaw": "dynamic_rule"}.get(tag)
+            if tag == "speciesReference" and (_attribute(row, "constant")[0] in {"false", "0"} or _attribute(row, "stoichiometry")[0] is None):
+                feature = "nonconstant_stoichiometry"
+            if feature:
+                features.append({"kind": feature, "source": source, "disposition": "unsupported"})
+                unsupported = True
+            if tag == "annotation":
+                features.append({"kind": "annotation_qualifier_loss", "source": source, "disposition": "transformed"})
+            for ns in row["namespace_declarations"]:
+                uri = ns["uri"]
+                if "/sbml/" in uri and ("/fbc/" in uri or "/groups/" in uri or uri.count("/") > 7):
+                    supported = uri.endswith("/fbc/version2") or uri.endswith("/groups/version1") or uri.endswith("/core")
+                    features.append({"kind": "sbml_package", "source": source,
+                                     "disposition": "preserved" if supported else "unsupported"})
+                    unsupported |= not supported
+    if not has_objective:
+        features.append({"kind": "missing_objective", "source": location("original_model", ""), "disposition": "unknown"})
+    seen = set()
+    joins = []
+    mapped = set()
+    positions_by_kind = {}
+    if model is not None:
+        for kind, axis in axes.items():
+            ids = list(model._compartments) if kind == "compartment" else [r.id for r in getattr(model, axis)]
+            positions_by_kind[kind] = {identifier: position for position, identifier in enumerate(ids)}
+    for kind, index, sid, loaded, source in entries:
+        key = kind, loaded
+        if key in seen:
+            features.append({"kind": "id_collision", "source": source, "disposition": "unsupported"})
+            unsupported = True
+        seen.add(key)
+        position = None
+        if model is not None:
+            if kind == "model":
+                position = 0 if model.id == loaded else None
+            else:
+                position = positions_by_kind[kind].get(loaded)
+        state = "mapped" if position is not None else "unmapped"
+        joins.append({"kind": kind, "source_record_index": index, "source_id": sid, "loaded_id": loaded,
+                      "loaded_position": position, "state": state, "source": source})
+        if position is not None:
+            mapped.add((kind, loaded))
+    if model is not None:
+        for kind, axis in axes.items():
+            ids = list(model._compartments) if kind == "compartment" else [r.id for r in getattr(model, axis)]
+            for position, identifier in enumerate(ids):
+                if (kind, identifier) not in mapped:
+                    joins.append({"kind": kind, "source_record_index": None, "source_id": None, "loaded_id": identifier,
+                                  "loaded_position": position, "state": "loader_created", "source": location("original_model", "")})
+    return {"joins": joins, "features": features, "reactions": source_reactions,
+            "missing_bounds": missing_bounds, "missing_objective": not has_objective, "unsupported": unsupported}
+
