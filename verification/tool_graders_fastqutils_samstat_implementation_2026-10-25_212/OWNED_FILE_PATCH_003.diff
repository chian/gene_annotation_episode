+    elif mutation=='duplicate_row':
+        row=re.search(rb'<tbody>\s*(<tr>.*?</tr>)',raw,re.S)[1];raw=raw.replace(b'</tbody>',row+b'</tbody>',1)
+    elif mutation=='malformed_row': raw=raw.replace(b'<td class="num">4</td>',b'<td class="num">-4</td>',1)
