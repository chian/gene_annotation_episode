+table{border-collapse:collapse;min-width:20rem}
+th,td{padding:.55rem .9rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
+thead th{border-bottom:2px solid var(--ink);font-size:.9rem}
+td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
+td svg{display:block}
+.plot h2 .num{display:inline-block;min-width:1.6rem;color:var(--accent)}
+.figs{margin:0 0 .5rem;overflow-x:auto}
+.figs svg{display:block;width:100%;margin:0 0 12px 0}
+.figs:not(.paired)>svg{min-width:30rem}
+.figs .plot-key svg{width:auto}
+.figs.paired{max-width:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px}
+.figs.paired>p{grid-column:1/-1}
+.figs.paired svg{max-width:32rem}
+@media (max-width:40rem){.figs.paired{grid-template-columns:minmax(0,1fr)}}
+.good{max-width:48rem;margin:0 0 .6rem}
+.plot-na{display:inline-block;margin:0 0 .75rem;padding:.6rem .9rem;border:2px dashed var(--muted);border-radius:6px}
+.plot-note{margin:0 0 .75rem;padding:.5rem .9rem;background:var(--wash);border-left:5px solid var(--muted);border-radius:0 6px 6px 0;max-width:48rem}
+.plot-key{margin:0 0 .5rem}
+.plot-key svg{margin:0}
+details{margin:.25rem 0 0;border:1px solid var(--line);border-radius:6px;max-width:48rem}
+summary{padding:.5rem .9rem;font-weight:600;color:var(--accent);cursor:pointer}
+summary:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
+details[open] summary{border-bottom:1px solid var(--line)}
+.howto{padding:.75rem .9rem 0}
+.howto p{margin-bottom:.6rem}
+footer{margin-top:3rem;padding-top:1rem;border-top:2px solid var(--line);font-size:.9rem;color:var(--muted)}
+footer p{margin-bottom:.5rem}
+@page{size:A4 portrait;margin:14mm}
+@media print{
+body{font-size:11pt;-webkit-print-color-adjust:exact;print-color-adjust:exact}
+.page{max-width:none;padding:0}
+main>section,.strip>div,.notes li,details,table,tr,.figs,.plot-na,.plot-note,.good{break-inside:avoid}
+h1,h2,summary{break-after:avoid}
+section.plot{break-inside:avoid-page}
+details>*:not(summary){display:block!important}
+details::details-content{content-visibility:visible!important;display:block!important}
+details>summary{list-style:none;border-bottom:1px solid var(--line)}
+details>summary::-webkit-details-marker{display:none}
+summary{color:var(--ink)}
+}
+</style>
