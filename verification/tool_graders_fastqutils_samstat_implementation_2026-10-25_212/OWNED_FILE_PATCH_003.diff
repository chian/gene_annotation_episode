+</td><th scope="row">MAPQ 10-29</th><td class="num">0</td><td class="num">0.0</td></tr>
+<tr><td><svg xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="samstat-mapq-2-t samstat-mapq-2-d" width="52" height="14" viewBox="0 0 52 14" style="vertical-align:middle" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" font-size="12" fill="#1a1a1a"><title id="samstat-mapq-2-t">dotted vermillion line</title><desc id="samstat-mapq-2-d">Line sample: vermillion, dotted.</desc><path fill="none" stroke="#D55E00" stroke-width="2.5" stroke-dasharray="3 4" d="M2,7H50"/></svg>
