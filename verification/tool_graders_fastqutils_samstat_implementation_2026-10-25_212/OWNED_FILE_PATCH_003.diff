gned part</text><text x="75.5" y="352.2" text-anchor="end">0</text><text x="75.5" y="309.2" text-anchor="end">2</text><text x="75.5" y="266.2" text-anchor="end">4</text><text x="75.5" y="223.2" text-anchor="end">6</text><text x="75.5" y="180.2" text-anchor="end">8</text><text x="75.5" y="137.2" text-anchor="end">10</text><text transform="translate(14.2 239.5) rotate(-90)" text-anchor="middle">mean base quality (Q)</text></svg>
