r="end">4 k</text><text x="70" y="172.6" text-anchor="end">6 k</text><text x="70" y="136.8" text-anchor="end">8 k</text><text x="70" y="100.9" text-anchor="end">10 k</text><text x="70" y="65.1" text-anchor="end">12 k</text><text transform="translate(13.3 167.7) rotate(-90)" text-anchor="middle">number of reads</text><path fill="none" stroke="#595959" stroke-width="1" d="M77,275.2v2.5M131.2,275.2v2.5M185.4,275.2v2.5M239.6,275.2v2.5M293.8,275.2v2.5M348,275.2v2.5M402.2,275.2v2.5M456.4,275.2v2.5M510.6,275.2v2.5M564.8,275.2v2.5M619,275.2v2.5"/><path fill="none" stroke="#0072B2" stroke-width="2" stroke-linejoin="round" d="M348,275.2V96H402.2V275.2"><title>MAPQ &gt;= 30</title></path></svg>
