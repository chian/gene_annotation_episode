+def test_deep_valid_json_prior_preserves_independent_native_work(captures):
+    # Valid JSON is not rejected merely for being nested. Use the ordinary
+    # interpreter recursion limit rather than pytest's larger test-runner limit.
+    raw = b'{"bound":' + b'[' * 600 + b'0' + b']' * 600 + b'}'
+    payloads, expected, extra = with_prior(captures, raw=raw, pointer="/bound")
+    previous_limit = sys.getrecursionlimit()
+    try:
+        sys.setrecursionlimit(1000)
+        result = parse_fba_capture(payloads, expected=expected, prior_sources=[extra])
+    finally:
+        sys.setrecursionlimit(previous_limit)
+    assert extra["file"] in result["retained_files"]
+    assert result["original_request_file"] == payloads["selected_request"]["file"]
+    assert result["native"]["request_realization"] == "exact"
+    assert_independent_work(result)
