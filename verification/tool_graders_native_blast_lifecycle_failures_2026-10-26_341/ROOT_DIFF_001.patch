+def _assert_original_failure_replay_and_return(h, child, outcome, monkeypatch):
+    """Use the saved selected action and the actual existing parent return ports."""
+    body = outcome['result']
+    assert outcome['status'] == 'completed' and not body['complete']
+    assert h.family.completion_for_action(child, body['operation_key']) is None
+    before_actions = [dict(row) for row in h.store.db.execute(
+        'SELECT * FROM runtime_actions WHERE episode_id=?', (child.episode_id,))]
+    assert len(before_actions) == 1 and json.loads(before_actions[0]['result']) == outcome
+    before_remote = len(h.calls)
+    def forbidden(*args, **kwargs):
+        pytest.fail('frozen failure replay executed local or remote work')
+    monkeypatch.setattr('gene_annotation_episode.native_blast_database_result_publication.run_local_job', forbidden)
+    monkeypatch.setattr(h.family.job_progress_provider.targets, 'observe_target', forbidden)
+    monkeypatch.setattr(h.family.job_progress_provider.targets, 'read_file', forbidden)
+    assert asyncio.run(h.family.execute(child, 'execution.results.collect', {}, body['operation_key'])) == outcome
+    form, schema = h.returned(child)
+    received = h.family.native_blast_database_returns.received_facts(h.root, schema)
+    assert received['execution_blast_database_failures'] == body['failures']
+    assert received['execution_blast_database_acquisition']['complete'] is False
+    expected_rows = [] if body['publication'] is None else body['publication']['rows_by_family']['hsp']
+    assert received['execution_blast_database_hsp_rows'] == expected_rows
+    assert h.returned(child)[0] == form
+    assert len(h.calls) == before_remote
+    assert [dict(row) for row in h.store.db.execute(
+        'SELECT * FROM runtime_actions WHERE episode_id=?', (child.episode_id,))] == before_actions
+    assert h.family.native_blast_database_results.credit_view(child, dict(
+        known_record_refs=body['record_refs'], initial_known_record_refs=body['record_refs']))['credit'] == 0
+    return form, schema, received
+
+
+def _inject_native_collect_failure(monkeypatch, policy, resource_limit):
+    """Actual lifecycle classification, with synthetic status and no exhaustion."""
+    from types import SimpleNamespace
+    from gene_annotation_episode import native_lifecycle
+    metadata = {'policy': policy.to_dict(), 'service_exit': {
+        'SERVICE_RESULT': 'oom-kill' if resource_limit else 'exit-code'},
+        'synthetic_failure_injection': True}
+    view = {'terminal': True, 'metadata': metadata, 'native_receipt': None}
+    with monkeypatch.context() as patch:
+        patch.setattr(native_lifecycle, 'status', lambda handle: view)
+        native_lifecycle.collect(SimpleNamespace())
+    pytest.fail('actual lifecycle collect did not raise')
+
