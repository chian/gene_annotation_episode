    def _utility_plan(self, assignment, execution_id, *, run_id=None, origin_episode_id=None,
                      original_operation_key=None, attempt_id=None, resource_id=None,
                      requested_job_sha256=None):
        """Authenticate the original utility reservation; never choose or start work."""
        from .native_blast_utility_local import local_blast_utility_plan
        self.validate_assignment(assignment)
        plan = local_blast_utility_plan(assignment, execution_id)
        expected = {'run_id': run_id, 'episode_id': origin_episode_id,
            'operation_key': original_operation_key, 'attempt_id': attempt_id,
            'resource_id': resource_id, 'requested_job_sha256': requested_job_sha256}
        if (plan['policy'] != self.policy.to_dict() or any(value is not None and
                plan['identity'][key] != value for key, value in expected.items())):
            raise ValueError('native_blast_utility_original_attempt_mismatch')
        return plan

    @staticmethod
    def _utility_validation(plan):
        """Record actual bundle/file checks, independently of the native exit status."""
        from .native_blast_utility_contracts import validate_native_blast_utility_bundle
        from .native_blast_utility_driver import validate_native_blast_utility_bundle_files
        from .native_infernal_driver import _confined_file, _read_json
        record = {'version': 'native_blast_utility_validation_v1', 'bundle': None,
            'bundle_sha256': None, 'files_validated': False, 'failure_code': 'sealed_bundle_unavailable'}
        root = Path(plan['attempt_directory'])
        try:
            manifest = _confined_file(root, 'bundle.json')
            if not manifest.is_file():
                return record
            bundle = validate_native_blast_utility_bundle(_read_json(manifest, sealed=True), plan)
        except (OSError, ValueError):
            record['failure_code'] = 'original_bundle_invalid'
            return record
        record.update(bundle=bundle, bundle_sha256=digest(bundle))
        try:
            validate_native_blast_utility_bundle_files(bundle, root)
        except (OSError, ValueError):
            record['failure_code'] = 'original_bundle_files_invalid'
        else:
            record.update(files_validated=True, failure_code=None)
        return record

    @classmethod
    def _utility_sealed_bundle(cls, plan):
        record = cls._utility_validation(plan)
        return record['bundle'] if record['files_validated'] else None

    @staticmethod
    def _utility_output_rows(plan, bundle):
        # database_family is a selected prefix. Only the sealed enumeration
        # supplies its individual files, including failed partial native output.
        rows = (bundle['artifacts'] if bundle is not None else [row
            for row in plan['requested_job']['native_blast_utility']['outputs']
            if row['path_kind'] == 'file'])
        return [*rows, {'role': 'native_blast_utility_bundle', 'relative_path': 'bundle.json'}]

    @classmethod
    def _utility_observed_files(cls, plan, view, *, validation=None,
                                log_window_bytes=8192, log_roles=('stdout', 'stderr')):
        from .native_infernal_driver import _confined_file
        validation = cls._utility_validation(plan) if validation is None else validation
        outputs, logs = [], []
        for selected in cls._utility_output_rows(plan, validation['bundle']):
            role = selected['role']
            if role in {'database_file', 'database_metadata'} or (
                    plan['requested_job']['native_blast_utility']['version'] == 'native_blast_utility_job_v2'
                    and role not in {'stdout', 'stderr', 'native_blast_utility_bundle'}):
                role += ':' + selected['relative_path']
            try:
                path = _confined_file(Path(plan['attempt_directory']), selected['relative_path'])
                detail = _output_details(path, text_log=role in log_roles, limit=log_window_bytes)
            except (OSError, ValueError):
                detail = {'available': False}
            outputs.append({'role': role, 'available': detail['available'],
                'bytes': detail.get('bytes'), 'writer_closed': detail['available'] and view['terminal']})
            if role in log_roles and detail['available']:
                logs.append({'role': role, 'path': str(path), 'offset': detail['tail_byte_offset'],
                    'observed_size': detail['bytes'], 'bytes_base64': detail['bytes_base64']})
        return outputs, logs, outputs[-1]['available']

    @staticmethod
    def _masking_observed_files(plan, view, *, log_window_bytes=8192, log_roles=('stdout', 'stderr')):
        """Expose measured selected files; availability is not result validation."""
        from .native_infernal_driver import _confined_file
        outputs, logs = [], []
        rows = [*plan['requested_job']['native_blast_masking']['outputs'],
            {'role': 'native_blast_masking_bundle', 'relative_path': 'bundle.json'}]
        for selected in rows:
            path = _confined_file(Path(plan['attempt_directory']), selected['relative_path'])
            text_log = selected['role'] in log_roles
            detail = _output_details(path, text_log=text_log, limit=log_window_bytes)
            outputs.append({'role': selected['role'], 'available': detail['available'],
                'bytes': detail.get('bytes'), 'writer_closed': detail['available'] and view['terminal']})
            if text_log and detail['available']:
                logs.append({'role': selected['role'], 'path': str(path),
                    'offset': detail['tail_byte_offset'], 'observed_size': detail['bytes'],
                    'bytes_base64': detail['bytes_base64']})
        return outputs, logs, outputs[-1]['available']

    @staticmethod
    def _masking_sealed_bundle(plan):
        from .native_blast_masking_contracts import validate_original_bundle
        from .native_blast_masking_driver import validate_native_blast_masking_bundle_files
        from .native_infernal_driver import _confined_file, _read_json
        root = Path(plan['attempt_directory'])
        manifest = _confined_file(root, 'bundle.json')
        if not manifest.is_file():
            return None
        bundle = validate_original_bundle(_read_json(manifest, sealed=True), plan)
        return validate_native_blast_masking_bundle_files(bundle, root)

