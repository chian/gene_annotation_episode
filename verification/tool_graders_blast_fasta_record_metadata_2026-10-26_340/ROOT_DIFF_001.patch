+def _record_address_status(document, pointer, locator, *, contents, cache):
+    """Qualify a v2 address from supplied bytes; preserve original header slots."""
+    blast_record_identity(source_ref=document["source_ref"], pointer=pointer, record_locator=locator)
+    if (document["format"] == "fasta") != (locator is not None):
+        return "incompatible", ["record_locator_format_conflict"], None
+    if locator is None:
+        return "available", [], None
+    identity = (document["artifact_ref"], document["sha256"], document["size_bytes"])
+    if identity not in cache:
+        if type(contents) is not bytes or _sha(contents) != document["sha256"] or len(contents) != document["size_bytes"]:
+            return "incompatible", ["document_bytes_conflict"], None
+        cache[identity] = parse_blast_fasta_source_records(contents)
+    parsed = cache[identity]
+    ordinal = locator["record_ordinal"]
+    if ordinal >= len(parsed["records"]):
+        if "input_not_utf8" in parsed["issues"]:
+            return "incompatible", ["fasta_record_invalid", *parsed["issues"]], None
+        return "unavailable", ["fasta_record_ordinal_unavailable"], None
+    record = parsed["records"][ordinal]
+    if record["status"] != "available":
+        return "incompatible", ["fasta_record_invalid", *record["issues"]], record
+    return "available", [], record
