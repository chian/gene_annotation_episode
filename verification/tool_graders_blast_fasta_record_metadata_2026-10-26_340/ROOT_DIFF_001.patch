+def fasta_record_payload(tmp_path, catalog, *, ordinals=(0, 1), raw=b">s0\nACDEFGHIKL\n>s1\nACDEPQRSTV\n"):
+    payload = sequence_payload(tmp_path, catalog)
+    assignments = source(tmp_path, catalog, "explicit-assignments", encoded(payload))
+    fasta = source(tmp_path, catalog, "original-fasta", raw, "fasta")
+    payload["documents"].extend([assignments, fasta])
+    payload["schema"] = "native_blast_database_sequence_metadata_v2"
+    unit = payload["searches"][0]
+    for i, ordinal in enumerate(ordinals):
+        locator = dict(kind="fasta_record", record_ordinal=ordinal)
+        unit["reference_metadata"][i].update(source="original-fasta", native_pointer="", record_locator=deepcopy(locator))
+        for function in unit["reference_metadata"][i]["functions"]: function["source"] = "explicit-assignments"
+        unit["description_bindings"][i]["binding"].update(metadata_source_ref="original-fasta", metadata_pointer="",
+            metadata_record_locator=deepcopy(locator))
+        unit["sequence_identity_bindings"][i]["binding"].update(source_ref="original-fasta", pointer="", record_locator=deepcopy(locator))
+        unit["sequence_proofs"][i].update(document_key="original-fasta", representation="fasta_record",
+            record_ordinal=ordinal, sequence_pointer=None)
+    return payload
+
+
+def record_wire(tmp_path, catalog, payload, key="record-v2"):
+    raw = metadata(tmp_path, catalog, "sequence_database", payload, key)
+    raw["descriptor"]["schema_id"] = payload["schema"]
+    return raw
