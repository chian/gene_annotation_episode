+def _pb_counts(sequences, *, width, residues, columns=None):
+    """Native PB span rule; collect all-row counts after choosing a sample map."""
+    counts = [Counter() for _ in range(width)]
+    minspan = math.ceil(_f32(.5 * _f32(width)))
+    fragments = 0
+    for sequence in sequences:
+        left = next((i for i, symbol in enumerate(sequence) if symbol in residues), width)
+        right = next((i for i in range(width - 1, -1, -1) if sequence[i] in residues), -1)
+        if right - left + 1 >= minspan:
+            left, right = 0, width - 1
+        else:
+            fragments += 1
+        for column in range(left, right + 1) if columns is None else columns:
+            if left <= column <= right:
+                counts[column][sequence[column]] += 1
+    return counts, fragments
+
+
+def _pb_consensus(counts, residues):
+    consensus = []
+    for column, counter in enumerate(counts):
+        total = sum(count for symbol, count in counter.items() if symbol in residues or symbol == "-")
+        if total and _f32(_f32(counter["-"]) / _f32(total)) < _f32(.5):
+            consensus.append(column)
+    return consensus
+
