+def _normalize_easel_weights(raw_weights):
+    """Ordered esl_vec_DSum, then DNorm division, then separate DScale."""
+    if not raw_weights or any(not finite(value) or value < 0 for value in raw_weights):
+        raise ValueError("weight_invalid")
+    total = correction = 0.
+    for value in raw_weights:
+        y = value - correction
+        updated = total + y
+        correction = (updated - total) - y
+        total = updated
+    if not finite(total):
+        raise ValueError("weight_invalid")
+    count = len(raw_weights)
+    normalized = [value / total for value in raw_weights] if total != 0. else [1. / count] * count
+    weights = [value * count for value in normalized]
+    if any(not finite(value) or value < 0 for value in weights):
+        raise ValueError("weight_invalid")
+    return weights, {"method": "easel_kahan_divide_then_scale", "sum": total,
+                     "sequence_count": count, "zero_sum": total == 0.}
+
