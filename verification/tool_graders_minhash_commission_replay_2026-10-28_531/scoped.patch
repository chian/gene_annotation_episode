+@pytest.mark.parametrize("normalization", ["reordered", "merged"])
+def test_original_scope_uses_runtime_normalization_without_rewriting_records(commission_host, monkeypatch, normalization):
+    h = commission_host
+    span = h.store.coverage(h.scope["subject_refs"][0])[0]
+    intervals = [(4, 8), (0, 2)] if normalization == "reordered" else [(3, 8), (0, 5)]
+    raw_scope = {**deepcopy(h.scope), "segments": [
+        {**span, "start": start, "end": end} for start, end in intervals]}
+    h.scope = h.store.validate_scope(raw_scope)
+    assert raw_scope != h.scope
+    parent, native, selector, _, _ = setup_inputs(h)
+    child = recorded_child(h, parent, native, selector, 1)
+    reference = publish_child(h, parent, child, 1)
+    grade = h.family.minhash.read_own(reference, context=child)["grading"]
+    action = {"kind": "episode_child", "role": "results",
+        "assignment": plain(child.assignment), "scope": raw_scope}
+    with h.store.transaction():
+        h.store.db.execute("UPDATE runtime_actions SET action=? WHERE run_id=? "
+            "AND episode_id=? AND decision_index=1", (canonical(action), parent.run_id, parent.episode_id))
+    before = retained_state(h)
+    prohibit_reextraction(h, monkeypatch)
+    assert h.binding.prepare_assignment(parent, "results", plain(child.assignment), h.scope,
+        f"{parent.run_id}:{parent.episode_id}:1") == plain(child.assignment)
+    assert h.family.minhash.read_own(reference, context=child)["grading"] == grade
+    assert retained_state(h) == before
+    # Change actual coverage while staying inside the original parent's scope.
+    # Normalization cannot turn this different selected span into the original.
+    action["scope"]["segments"][0]["end"] = 7
+    with h.store.transaction():
+        h.store.db.execute("UPDATE runtime_actions SET action=? WHERE run_id=? "
+            "AND episode_id=? AND decision_index=1", (canonical(action), parent.run_id, parent.episode_id))
+    before = retained_state(h)
+    with pytest.raises(ValueError, match="commission_scope_conflict"):
+        h.binding.prepare_assignment(parent, "results", plain(child.assignment), h.scope,
+            f"{parent.run_id}:{parent.episode_id}:1")
+    assert retained_state(h) == before
+    assert len(h.client.calls) == 1
