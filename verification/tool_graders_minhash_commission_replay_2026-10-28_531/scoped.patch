+    def validate_commission_inputs(self, parent, assignment, *, request, scope, operation_key):
+        """Authenticate an original commission without rebuilding its frozen inputs.
+
+        A new child still receives full input validation. An exact saved child
+        keeps its own first-publication validation and saved-publication reader;
+        reconstructing the parent commission must not extract its metadata again.
+        """
+        assignment = plain(assignment)
+        prefix = f'{self.run_id}:{parent.episode_id}:'
+        suffix = (operation_key[len(prefix):] if isinstance(operation_key, str)
+            and operation_key.startswith(prefix) else '')
+        self._require(re.fullmatch(r'0|[1-9][0-9]*', suffix) is not None,
+            'commission_operation_required')
+        index = int(suffix)
+        path = (*parent.path, ('results', 'child_' + suffix))
+        child_id = EpisodeRef(self.run_id, path).episode_id
+        row = self.db.execute('SELECT action FROM runtime_actions WHERE run_id=? '
+            'AND episode_id=? AND decision_index=?',
+            (self.run_id, parent.episode_id, index)).fetchone()
+        saved_child = self.db.execute('SELECT 1 FROM runtime_episodes WHERE run_id=? '
+            'AND episode_id=?', (self.run_id, child_id)).fetchone()
+        if row is None:
+            self._require(saved_child is None, 'commission_action_missing')
+            return self.validate_inputs(parent, assignment['selector'], request=request,
+                handoff_ref=assignment['handoff_ref'])
+        self.authenticate(parent)
+        action = json.loads(row['action'])
+        self._require(action.get('kind') == 'episode_child', 'commission_action_conflict')
+        self._require(action.get('role') == 'results', 'commission_role_conflict')
+        self._require(_same(action.get('assignment'), assignment), 'commission_assignment_conflict')
+        self._require(isinstance(action.get('scope'), dict), 'commission_scope_conflict')
+        try:
+            original_scope = self.store.validate_scope(action['scope'],
+                parent_scope=plain(parent.scope))
+        except (ValueError, KeyError, TypeError) as error:
+            raise ValueError(self.failure_prefix + 'commission_scope_conflict') from error
+        self._require(_same(original_scope, plain(scope)), 'commission_scope_conflict')
+        self._require(saved_child is not None, 'commission_child_missing')
+        child = self.context(child_id)
+        self._require(child.path == path and child.role == 'results', 'commission_child_conflict')
+        self._require(_same(child.assignment, assignment), 'commission_child_assignment_conflict')
+        self._require(_same(child.scope, plain(scope)), 'commission_child_scope_conflict')
+        target = self.api.read_target(assignment['handoff_ref'], scope)
+        if (target['assignment'].get('service') != SERVICE
+                or not _same(target['assignment'].get('request'), plain(request))):
+            self._input_failure('minhash_publication_inputs_conflict',
+                handoff_ref=assignment['handoff_ref'])
+        selected = validate_minhash_result_selector(assignment['selector'])
+        for pair_index, record in enumerate(selected.get('pair_metadata', [])):
+            for evidence in record['provenance']['fields']:
+                reference = evidence['source_ref']
+                detail = {'pair_metadata_index': pair_index, 'row_index': record['row_index'],
+                    'genome_id': record['genome_id'], 'field': evidence['field'],
+                    'record_path': evidence['record_path']}
+                self._source(reference, code='minhash_metadata_source_missing', **detail)
+                try:
+                    self.possession(parent, reference, before=index)
+                except ValueError as error:
+                    raise ContractError('minhash_metadata_source_not_received',
+                        detail={'source_ref': reference, **detail}) from error
+        if selected.get('mode') == 'saved_sheet':
+            self.possession(parent, selected['saved_result_ref'], before=index,
+                code='minhash_saved_result_not_received')
+        # Artifact/receipt associations are authenticated by read_own through
+        # _frozen_inputs. No new publication envelope or authority is created.
+        return None
