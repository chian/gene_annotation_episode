+"""Focused MinHash commission authentication; not a full Workflow fixture.
+
+Reuse B521's explicit selected-action/typed-admission journals and synthetic
+native response. The unchanged D522 closed-Workflow test remains the integration
+proof. These cases exercise the real execution-family preparation and API result
+publication; no model or live service is used.
+"""
+from copy import deepcopy
+from dataclasses import replace
+import json
+
+import pytest
+
+from gene_annotation_episode.communication import plain
+from gene_annotation_episode.domain import canonical
+from gene_annotation_episode.execution_episodes import ExecutionEpisodes
+
+from test_api_bvbrc_minhash import (
+    CONFIGURATION, RESULT_OPERATION, executor, explicit_pair_inputs, harness,
+    no_external_connections, request,
+)
+from test_bvbrc_minhash_metadata_custody import (
+    SOURCE_SCHEMA, admit, parse_selected, results_context, setup_inputs,
+)
+from test_execution_episodes_family import select
+
+
+@pytest.fixture
+def commission_host(executor):
+    h = executor
+    h.binding = ExecutionEpisodes(None, store=h.store, directory=h.tmp_path / "run",
+        run_id=h.journal.run_id, resources={"minhash": CONFIGURATION},
+        initial_information={}, tool_registry=h.tools, handoff_unit=3,
+        acquired_record_unit=2, log_window_bytes=4, log_roles=["stdout", "stderr"])
+    h.family = h.binding.api_execution
+    return h
+
+
+def assigned(native, selector):
+    return {"version": "execution_results_assignment_v1", "handoff_ref": native,
+        "selector": deepcopy(selector)}
+
+
+def recorded_child(h, parent, native, selector, index):
+    """B521's direct fixture, with the original scope also recorded for this port."""
+    child = results_context(h, parent, native, selector, index)
+    action = {"kind": "episode_child", "role": "results",
+        "assignment": plain(child.assignment), "scope": plain(child.scope)}
+    with h.store.transaction():
+        h.store.db.execute("UPDATE runtime_actions SET action=? WHERE run_id=? "
+            "AND episode_id=? AND decision_index=?",
+            (canonical(action), parent.run_id, parent.episode_id, index))
+    return child
+
+
+def publish_child(h, parent, child, index):
+    outcome = select(h, child, 0, RESULT_OPERATION)
+    assert outcome["status"] == "completed", outcome
+    reference = outcome["result"]["source_ref"]
+    admit(h, parent, child, index, {"source": reference}, SOURCE_SCHEMA)
+    return reference
+
+
+def retained_state(h):
+    """Retain all DB content and all execution files, without issuing a write."""
+    directory = h.tmp_path / "run"
+    return (tuple(h.store.db.iterdump()), {
+        str(path.relative_to(directory)): path.read_bytes()
+        for path in directory.rglob("*") if path.is_file()})
+
+
+def prohibit_reextraction(h, monkeypatch):
+    def forbidden(*args, **kwargs):
+        raise AssertionError("Recorded commission must not extract, calculate or acquire")
+    for name in ("validate_inputs", "publication_inputs", "metadata_bindings", "_pointer"):
+        monkeypatch.setattr(h.family.minhash, name, forbidden)
+    for module in ("api_bvbrc_minhash", "bvbrc_minhash_grader"):
+        for name in ("parse_minhash_result", "calculate_minhash_components"):
+            monkeypatch.setattr("gene_annotation_episode." + module + "." + name, forbidden)
+    monkeypatch.setattr(h.service, "invoke", forbidden)
+    monkeypatch.setattr(h.client, "rpc", forbidden)
+
+
+@pytest.mark.parametrize("mode", ["legacy", "native_result", "saved_sheet"])
+def test_recorded_commission_uses_original_child_and_frozen_inputs(commission_host, monkeypatch, mode):
+    h = commission_host
+    parent, native, selector, _, material = setup_inputs(h)
+    if mode == "legacy":
+        selector = {}
+    index = 1
+    child = recorded_child(h, parent, native, selector, index)
+    reference = publish_child(h, parent, child, index)
+    original_reference = reference
+    original_grade = h.family.minhash.read_own(reference, context=child)["grading"]
+    if mode == "saved_sheet":
+        changed, metadata = explicit_pair_inputs(h, request(), values={"kmer_length": 2,
+            "query_length": 2, "reference_length": 2, "alphabet_size": 2})
+        parse_selected(h, parent, changed, index=2)
+        selector = {"version": "bvbrc_minhash_result_selector_v2", "mode": "saved_sheet",
+            "saved_result_ref": reference, "pair_metadata": [metadata]}
+        index = 3
+        child = recorded_child(h, parent, native, selector, index)
+        reference = publish_child(h, parent, child, index)
+    grade = h.family.minhash.read_own(reference, context=child)["grading"]
+    artifacts = {}
+    for source_ref in (material["source_ref"], original_reference, reference):
+        source = h.store.get(source_ref)
+        for artifact_ref in [source["artifact_ref"], *source.get("auxiliary_artifact_refs", [])]:
+            artifacts[artifact_ref] = h.store.get_artifact(artifact_ref)
+    before = retained_state(h)
+    prohibit_reextraction(h, monkeypatch)
+    selection = plain(child.assignment)
+    assert h.binding.prepare_assignment(parent, "results", selection, h.scope,
+        f"{parent.run_id}:{parent.episode_id}:{index}") == selection
+    assert h.family.minhash.read_own(reference, context=child)["grading"] == grade
+    if mode == "saved_sheet":
+        saved = grade["publication_inputs"]["saved_result"]
+        assert saved["source_ref"] == original_reference
+        assert saved["sheet"] == original_grade["sheet"]
+        assert saved["original_components"] == original_grade["components"]
+    assert retained_state(h) == before
+    assert {ref: h.store.get_artifact(ref) for ref in artifacts} == artifacts
+    assert len(h.client.calls) == 1
+
