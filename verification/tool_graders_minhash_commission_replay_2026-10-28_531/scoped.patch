+@pytest.mark.parametrize("problem,code", [
+    ("selection", "commission_assignment_conflict"),
+    ("recorded_assignment", "commission_assignment_conflict"),
+    ("scope", "commission_scope_conflict"),
+    ("recorded_scope", "commission_scope_conflict"),
+    ("role", "commission_role_conflict"),
+    ("kind", "commission_action_conflict"),
+    ("missing_child", "commission_child_missing"),
+    ("missing_commission", "commission_action_missing"),
+    ("child_assignment", "commission_child_assignment_conflict"),
+    ("child_scope", "commission_child_scope_conflict"),
+    ("child_path", "context_conflict"),
+    ("parent_request", "original_context_conflict"),
+    ("native_request", "minhash_publication_inputs_conflict"),
+])
+def test_conflicting_commission_never_falls_back_to_fresh_validation(commission_host, monkeypatch, problem, code):
+    h = commission_host
+    parent, native, selector, _, _ = setup_inputs(h)
+    child = recorded_child(h, parent, native, selector, 1)
+    selection, scope, native_request = plain(child.assignment), plain(h.scope), request()
+    row = h.store.db.execute("SELECT action FROM runtime_actions WHERE run_id=? "
+        "AND episode_id=? AND decision_index=1", (parent.run_id, parent.episode_id)).fetchone()
+    action = json.loads(row["action"])
+    with h.store.transaction():
+        if problem == "selection":
+            selection["selector"]["pair_metadata"][0]["kmer_length"] = 2
+        elif problem in {"recorded_assignment", "recorded_scope", "role", "kind"}:
+            if problem == "recorded_assignment":
+                action["assignment"]["selector"] = {}
+            elif problem == "recorded_scope":
+                action["scope"] = {"subject_refs": []}
+            else:
+                action[problem] = "launch_api" if problem == "role" else "job_child"
+            h.store.db.execute("UPDATE runtime_actions SET action=? WHERE run_id=? "
+                "AND episode_id=? AND decision_index=1", (canonical(action), parent.run_id, parent.episode_id))
+        elif problem == "scope":
+            scope = {"subject_refs": []}
+        elif problem == "missing_child":
+            h.store.db.execute("DELETE FROM runtime_episodes WHERE run_id=? AND episode_id=?",
+                (child.run_id, child.episode_id))
+        elif problem == "missing_commission":
+            h.store.db.execute("DELETE FROM runtime_actions WHERE run_id=? AND episode_id=? AND decision_index=1",
+                (parent.run_id, parent.episode_id))
+        elif problem in {"child_assignment", "child_scope"}:
+            saved = plain(child.request)
+            if problem == "child_assignment":
+                saved["message"]["episode_assignment"]["selector"] = {}
+            else:
+                saved["message"]["scope"] = {"subject_refs": []}
+            h.store.db.execute("UPDATE runtime_episodes SET request=? WHERE run_id=? AND episode_id=?",
+                (canonical(saved), child.run_id, child.episode_id))
+        elif problem == "child_path":
+            h.store.db.execute("UPDATE runtime_episodes SET path=? WHERE run_id=? AND episode_id=?",
+                (canonical([*parent.path, ("results", "child_9")]), child.run_id, child.episode_id))
+        elif problem == "parent_request":
+            parent = replace(parent, request={**plain(parent.request), "copied": True})
+        else:
+            native_request = request(max_hits=11)
+    before = retained_state(h)
+    prohibit_reextraction(h, monkeypatch)
+    with pytest.raises(ValueError, match=code):
+        h.family.minhash.validate_commission_inputs(parent, selection,
+            request=native_request, scope=scope, operation_key=f"{parent.run_id}:{parent.episode_id}:1")
+    assert retained_state(h) == before
+    assert len(h.client.calls) == 1
