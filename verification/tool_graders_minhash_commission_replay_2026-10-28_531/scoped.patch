+def test_fresh_and_changed_new_child_use_actual_input_validation(commission_host, monkeypatch):
+    h = commission_host
+    parent, native, selector, _, material = setup_inputs(h)
+    original = h.family.minhash.validate_inputs
+    calls = []
+
+    def validate(context, value, **kwargs):
+        calls.append((context.episode_id, plain(value), plain(kwargs)))
+        return original(context, value, **kwargs)
+
+    monkeypatch.setattr(h.family.minhash, "validate_inputs", validate)
+    selection = assigned(native, selector)
+    before = retained_state(h)
+    assert h.binding.prepare_assignment(parent, "results", selection, h.scope,
+        f"{parent.run_id}:{parent.episode_id}:1") == selection
+    assert retained_state(h) == before
+    recorded_child(h, parent, native, selector, 1)
+    changed = deepcopy(selection)
+    changed["selector"]["pair_metadata"][0]["kmer_length"] = 2
+    before = retained_state(h)
+    with pytest.raises(ValueError, match="minhash_metadata_value_conflict") as failure:
+        h.binding.prepare_assignment(parent, "results", changed, h.scope,
+            f"{parent.run_id}:{parent.episode_id}:2")
+    assert failure.value.detail == {"source_ref": material["source_ref"],
+        "artifact_ref": selector["pair_metadata"][0]["provenance"]["fields"][0]["artifact_ref"],
+        "pair_metadata_index": 0, "row_index": 0, "genome_id": "511145.12",
+        "field": "kmer_length", "record_path": "/kmer_length"}
+    assert [call[1] for call in calls] == [selector, changed["selector"]]
+    assert all(call[0] == parent.episode_id and call[2] == {
+        "request": request(), "handoff_ref": native} for call in calls)
+    assert retained_state(h) == before
+    assert len(h.client.calls) == 1
