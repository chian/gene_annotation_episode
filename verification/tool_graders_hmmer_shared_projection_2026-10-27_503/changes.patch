+def test_aliases_copy_shared_cells_and_ignore_parser_alias_sentinels(tmp_path, monkeypatch, algorithm, shared_value):
+    """Injected score sentinels establish projection, not scientific measurements."""
+    import gene_annotation_episode.tools as tool_module
+    original_parse = tool_module.parse_hmmer
+    def poisoned_parser(*args, **kwargs):
+        parsed = original_parse(*args, **kwargs)
+        for hit in parsed['hits']:
+            for domain in hit['domains']:
+                domain.update(query_coverage=.987, reference_coverage=.876)
+        return parsed
+    monkeypatch.setattr(tool_module, 'parse_hmmer', poisoned_parser)
+    with Store(tmp_path) as store:
+        tools, _, _, result_owner = receiver(store, body=synthetic_payload(algorithm), algorithm=algorithm,
+            sequence='MACDEFGHIK' if algorithm == 'phmmer' else 'MACDEFGHIKLM')
+        original_grading = tools._hmmer_grading
+        def injected_shared_cells(snapshot):
+            grading = original_grading(snapshot)
+            score, = grading['scores']['domains']
+            for name, value in (('model_span_coverage', shared_value), ('sequence_span_coverage', .625)):
+                score[name] = score['derived'][name] = score['components'][name]['value'] = value
+            return grading
+        monkeypatch.setattr(tools, '_hmmer_grading', injected_shared_cells)
+        outcome = result_owner.act('api.hmmer.result')
+        assert outcome['status'] == 'completed'
+        assert_span_aliases_equal_shared(store, outcome, algorithm)
+        values = numeric(store, domain_refs(outcome)[0])
+        alias = 'target_coverage' if algorithm == 'hmmscan' else 'query_coverage'
+        if shared_value is None:
+            assert alias not in values
+        else:
+            assert values[alias] == shared_value
