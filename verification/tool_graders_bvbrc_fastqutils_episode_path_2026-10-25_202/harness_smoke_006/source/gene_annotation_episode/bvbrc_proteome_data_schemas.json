{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gene-annotation:proteome-input-data:v1",
  "title": "Proteome supplied-input data contracts",
  "x-contract-roots": [
    "ProteinInventoryResult",
    "FeatureSnapshotResult",
    "GenomeSnapshotResult",
    "FeatureSequenceSnapshotResult",
    "InputIndexResult",
    "NativeSource",
    "PopulationDescriptor",
    "CoordinateConvention",
    "ParameterSource",
    "SourceContract"
  ],
  "$defs": {
    "ContentBinding": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_field": {
          "enum": [
            "artifact_ref",
            "text_ref",
            "stdout_ref",
            "stderr_ref",
            "request_ref"
          ]
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source_ref",
        "artifact_field",
        "artifact_ref",
        "sha256",
        "byte_count"
      ],
      "additionalProperties": false
    },
    "NativeNumber": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "presence": {
          "enum": [
            "value",
            "explicit_null",
            "omitted",
            "blank",
            "invalid"
          ]
        },
        "lexeme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_field": {
          "$ref": "#/$defs/SourceField"
        }
      },
      "required": [
        "value",
        "presence",
        "lexeme",
        "source_field"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "presence": {
                "const": "value"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "NativeSource": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentBinding"
        },
        "body_complete": {
          "type": "boolean"
        },
        "object_complete": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        }
      },
      "required": [
        "content",
        "body_complete",
        "object_complete"
      ],
      "additionalProperties": false
    },
    "NativeString": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "presence": {
          "enum": [
            "value",
            "explicit_null",
            "omitted",
            "blank",
            "invalid"
          ]
        },
        "source_field": {
          "$ref": "#/$defs/SourceField"
        }
      },
      "required": [
        "value",
        "presence",
        "source_field"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "track_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_row_ordinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "association_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "protein_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "report_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "query_ordinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "hit_ordinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "hsp_ordinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "track_key",
        "reference_row_ordinal",
        "association_key",
        "protein_key",
        "report_key",
        "query_ordinal",
        "hit_ordinal",
        "hsp_ordinal"
      ],
      "additionalProperties": false
    },
    "SourceContract": {
      "type": "object",
      "properties": {
        "id": {
          "const": "GenomeComparison_inspected_source_v1"
        },
        "application_tree": {
          "const": "5c365e1dca2b3a8c311d7d352e862ff1442eefc9"
        },
        "application_sha256": {
          "const": "4267b35bdd5ad858b833fa2b84eb794c91e95b7f5abc0628b90ec4d6a0a33c14"
        },
        "dependency_tree": {
          "const": "18196fe0df123702457e4af2e0b1e0707d5f5281"
        },
        "deployment_match": {
          "enum": [
            "demonstrated",
            "unobserved",
            "different"
          ]
        },
        "deployment_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceField"
          }
        }
      },
      "required": [
        "id",
        "application_tree",
        "application_sha256",
        "dependency_tree",
        "deployment_match",
        "deployment_evidence"
      ],
      "additionalProperties": false
    },
    "SourceField": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(|/.*)$"
        },
        "row_ordinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "field_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_ref",
        "sha256",
        "pointer",
        "row_ordinal",
        "field_name"
      ],
      "additionalProperties": false
    },
    "PReason": {
      "enum": [
        "source_bytes_incomplete",
        "source_object_incomplete",
        "content_binding_mismatch",
        "encoding_invalid",
        "format_incompatible",
        "json_invalid",
        "duplicate_json_member",
        "fasta_header_invalid",
        "fasta_record_incomplete",
        "fasta_sequence_invalid",
        "fasta_empty_sequence",
        "input_empty",
        "input_arrays_unavailable",
        "input_reference_index_invalid",
        "parameter_source_conflict",
        "input_order_is_not_execution_proof",
        "exact_executed_input_missing",
        "input_membership_incomplete",
        "input_membership_unknown",
        "inventory_record_invalid",
        "input_binding_conflict",
        "staging_collision",
        "duplicate_identifier",
        "cross_input_identifier_collision",
        "identifier_mapping_missing",
        "identifier_mapping_conflict",
        "row_join_missing",
        "row_join_ambiguous",
        "row_join_conflict",
        "sequence_digest_conflict",
        "sequence_length_conflict",
        "metadata_record_invalid",
        "metadata_join_missing",
        "metadata_join_ambiguous",
        "metadata_join_conflict",
        "metadata_population_incomplete",
        "metadata_population_unknown",
        "coordinate_convention_unknown",
        "later_snapshot_not_original_input",
        "unknown_metadata_fields_retained",
        "native_invalid_cell",
        "native_missing_cell",
        "native_table_layout_uncertain",
        "native_identifier_unavailable",
        "native_category_invalid",
        "track_missing_from_projection",
        "track_materialization_unknown",
        "projection_incomplete",
        "reference_membership_unresolved",
        "representation_correspondence_missing",
        "representation_conflict",
        "alternate_representation_not_independent",
        "duplicate_native_representation",
        "reported_rows_not_input_population",
        "legacy_first_hsp_only",
        "legacy_rounded_fraction",
        "legacy_subject_endpoint_difference",
        "legacy_zero_fallback_possible",
        "native_category_not_orthology_probability",
        "observed_subset_not_total",
        "no_eligible_values",
        "postfilter_cannot_recover_filtered_associations",
        "native_min_positives_not_enforced_in_projection",
        "native_zero_default_divergence",
        "denominator_unavailable",
        "denominator_zero",
        "selection_unknown",
        "published_absence_not_biological_absence",
        "sequence_equivalence_not_feature_identity",
        "dependence_not_independence",
        "full_reports_not_retained",
        "directional_report_missing",
        "directional_report_partial",
        "report_operand_unbound",
        "report_query_missing",
        "report_counts_conflict",
        "report_geometry_conflict",
        "report_mapping_conflict",
        "native_hit_limit_censoring",
        "producer_exit_unknown",
        "producer_failed",
        "producer_format_unverified",
        "calculation_parameters_invalid",
        "sheet_relationship_invalid",
        "supplied_contract_invalid",
        "execution_witness_interface_unavailable",
        "occurrence_witness_interface_unavailable"
      ]
    },
    "PDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PReason"
        },
        "severity": {
          "enum": [
            "error",
            "qualification"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(|/.*)$"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceField"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "scope",
        "source_fields"
      ],
      "additionalProperties": false
    },
    "PRequirement": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PReason"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "required_input": {
          "enum": [
            "complete_bytes",
            "original_parameters",
            "exact_executed_fasta",
            "execution_input_witness",
            "complete_membership",
            "occurrence_mapping",
            "feature_metadata",
            "genome_metadata",
            "feature_sequence",
            "coordinate_convention",
            "representation_correspondence",
            "directional_report",
            "producer_execution_facts",
            "valid_parameters",
            "valid_saved_sheet"
          ]
        },
        "source_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceField"
          }
        }
      },
      "required": [
        "code",
        "scope",
        "required_input",
        "source_fields"
      ],
      "additionalProperties": false
    },
