specific sigma factors","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1371/journal.pone.0138466"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC4577112"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC4577112?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":24,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","license":"cc0","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2016-05-31","dateOfCreation":"2015-09-22","dateOfRevision":"2020-12-15","electronicPublicationDate":"2015-09-21","firstPublicationDate":"2015-09-21","firstIndexDate":"2015-09-22","fullTextReceivedDate":"2020-07-09","hasEvaluations":"N"},{"id":"17220219","source":"MED","pmid":"17220219","pmcid":"PMC1899374","fullTextIdList":{"fullTextId":["PMC1899374"]},"doi":"10.1128/jb.01562-06","title":"Enhancement of the synthesis of RpoN, Cra, and H-NS by polyamines at the level of translation in Escherichia coli cultured with glucose and glutamate.","authorString":"Terui Y, Higashi K, Taniguchi S, Shigemasa A, Nishimura K, Yamamoto K, Kashiwagi K, Ishihama A, Igarashi K.","authorList":{"author":[{"fullName":"Terui Y","lastName":"Terui","firstName":"Yusuke","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School of Pharmaceutical Sciences, Chiba University, 1-8-1 Inohana, Chiba 260-8675, Japan."}]}},{"fullName":"Higashi K","lastName":"Higashi","firstName":"Kyohei","initials":"K","authorId":{"type":"ORCID","value":"0000-0002-2622-4825"}},{"fullName":"Taniguchi S","lastName":"Taniguchi","firstName":"Shiho","initials":"S"},{"fullName":"Shigemasa A","lastName":"Shigemasa","firstName":"Ai","initials":"A"},{"fullName":"Nishimura K","lastName":"Nishimura","firstName":"Kazuhiro","initials":"K","authorId":{"type":"ORCID","value":"0000-0002-6209-5522"}},{"fullName":"Yamamoto K","lastName":"Yamamoto","firstName":"Kaneyoshi","initials":"K","authorId":{"type":"ORCID","value":"0000-0003-0696-8939"}},{"fullName":"Kashiwagi K","lastName":"Kashiwagi","firstName":"Keiko","initials":"K"},{"fullName":"Ishihama A","lastName":"Ishihama","firstName":"Akira","initials":"A"},{"fullName":"Igarashi K","lastName":"Igarashi","firstName":"Kazuei","initials":"K","authorId":{"type":"ORCID","value":"0000-0003-3751-3187"}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2622-4825"},{"type":"ORCID","value":"0000-0002-6209-5522"},{"type":"ORCID","value":"0000-0003-0696-8939"},{"type":"ORCID","value":"0000-0003-3751-3187"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"6","volume":"189","journalIssueId":1380543,"dateOfPublication":"2007 Mar","monthOfPublication":3,"yearOfPublication":2007,"journal":{"medlineAbbreviation":"J Bacteriol","title":"Journal of bacteriology","essn":"1098-5530","issn":"0021-9193","isoabbreviation":"J Bacteriol","nlmid":"2985120R"},"printPublicationDate":"2007-03-01"},"pubYear":"2007","pageInfo":"2359-2368","abstractText":"Proteins whose synthesis is enhanced by polyamines at the level of translation were identified in a polyamine-requiring mutant cultured in the presence of 0.1% glucose and 0.02% glutamate instead of 0.4% glucose as an energy source. Under these conditions, enhancement of cell growth by polyamines was almost the same as that in the presence of 0.4% glucose. It was found that synthesis of RpoN, Cra, and H-NS was enhanced by polyamines at the level of translation at the early logarithmic phase of growth (A(540) of 0.15). The effects of polyamines on synthesis of RpoN, H-NS, and Cra were due to the existence of unusual Shine-Dalgarno sequences (RpoN and H-NS) and an inefficient GUG initiation codon (Cra) in their mRNAs. Thus, rpoN, cra, and hns genes were identified as new members of the polyamine modulon. Because most of the polyamine modulon genes thus far identified encode transcription factors (RpoS [sigma(38)], Cya, FecI [sigma(18)], Fis, RpoN [sigma(54)], Cra, and H-NS), DNA microarray analysis of mRNA expressed in cells was performed. At the early logarithmic phase of growth, a total of 97 species of mRNAs that were up-regulated by polyamines more than twofold were under the control of seven polyamine modulon genes mentioned above.","affiliation":"Graduate School of Pharmaceutical Sciences, Chiba University, 1-8-1 Inohana, Chiba 260-8675, Japan.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Escherichia coli","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"DE","qualifierName":"drug effects"},{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"Y","abbreviation":"GD","qualifierName":"growth & development"},{"majorTopic_YN":"Y","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"Polyamines","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"},{"majorTopic_YN":"Y","abbreviation":"PD","qualifierName":"pharmacology"}]}},{"majorTopic_YN":"N","descriptorName":"Glucose","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"},{"majorTopic_YN":"N","abbreviation":"PD","qualifierName":"pharmacology"}]}},{"majorTopic_YN":"N","descriptorName":"Glutamic Acid","meshQualifierList":{"meshQualifier"