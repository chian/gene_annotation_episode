+def validate_completed_action_commission_context(value, *, run_id, episode_id,
+        selected_frame, pending_at_selection, pending_after_action, controller_credit):
+    """Validate saved factual v6 fields using only their original operands."""
+    from .local_commission_frame import validate_local_commission_frame
+
+    if (not _text(run_id) or not _text(episode_id) or not isinstance(value, dict)
+            or value.get('version') != CONTEXT_COMMISSION_VERSION
+            or value.get('local_commission_frame_at_selection') is None
+            or value.get('local_commission_frame_after_action') is None
+            or selected_frame is None):
+        raise WaitError('invalid_wait_record')
+    before = validate_local_commission_frame(value['local_commission_frame_at_selection'],
+        run_id=run_id, episode_id=episode_id, pending=pending_at_selection,
+        controller_credit=controller_credit)
+    after = validate_local_commission_frame(value['local_commission_frame_after_action'],
+        run_id=run_id, episode_id=episode_id, pending=pending_after_action,
+        controller_credit=controller_credit)
+    if (_json(before) != _json(selected_frame)
+            or 'pending_work_at_selection' not in value
+            or 'pending_work_after_action' not in value
+            or _json(value['pending_work_at_selection']) != _json(pending_at_selection)
+            or _json(value['pending_work_after_action']) != _json(pending_after_action)):
+        raise ValueError('local_commission_frame_identity_conflict')
+    result = _copy(value)
+    result.update(local_commission_frame_at_selection=before,
+        local_commission_frame_after_action=after)
+    return result
