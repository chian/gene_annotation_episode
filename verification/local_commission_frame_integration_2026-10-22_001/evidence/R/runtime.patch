+def _saved_commission_frame(request, *, run_id, episode_id):
+    """Read only the original factual metadata, never current execution state."""
+    if not isinstance(request, dict):
+        raise ContractError('local_commission_frame_invalid_input', detail={'path': ['request']})
+    versioned = request.get('version') == COMMISSION_MODEL_CALL_REQUEST_VERSION
+    if not versioned:
+        if 'local_commission_frame' in request:
+            raise ContractError('local_commission_frame_invalid_input',
+                detail={'path': ['request', 'version']})
+        return None
+    fields = {'version', 'context', 'schema', 'local_commission_frame'}
+    if 'model_presentation' in request:
+        fields.add('model_presentation')
+    if (set(request) != fields or not isinstance(request['context'], dict)
+            or not isinstance(request['schema'], dict)):
+        raise ContractError('local_commission_frame_invalid_input',
+            detail={'path': ['request']})
+    frame = request['local_commission_frame']
+    try:
+        return validate_local_commission_frame(frame, run_id=run_id, episode_id=episode_id,
+            pending=request['context'].get('pending_work'),
+            controller_credit=frame.get('controller_credit') if isinstance(frame, dict) else None)
+    except ValueError as error:
+        raise ContractError(str(error), detail={'path': ['request', 'local_commission_frame']}) from error
 
