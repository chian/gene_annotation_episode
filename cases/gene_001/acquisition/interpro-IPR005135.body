{"metadata":{"accession":"IPR005135","entry_id":null,"type":"domain","go_terms":[{"identifier":"GO:0003824","name":"catalytic activity","category":{"code":"F","name":"molecular_function"}}],"source_database":"interpro","member_databases":{"pfam":{"PF19580":"Endonuclease/Exonuclease/phosphatase family","PF14529":"Endonuclease-reverse transcriptase","PF03372":"Endonuclease/Exonuclease/phosphatase family"}},"integrated":null,"hierarchy":{"accession":"IPR005135","name":"Endonuclease/exonuclease/phosphatase","type":"Domain","children":[{"accession":"IPR000300","name":"Inositol polyphosphate-related phosphatase","type":"Domain","children":[{"accession":"IPR037793","name":"OCRL1/INPP5B, INPP5c domain","type":"Domain","children":[]}]},{"accession":"IPR034965","name":"Nocturnin, deadenylase domain","type":"Domain","children":[]},{"accession":"IPR034966","name":"CCR4-NOT transcription complex subunit 6","type":"Domain","children":[]},{"accession":"IPR034967","name":"CCR4-NOT transcription complex subunit 6-like","type":"Domain","children":[]}]},"name":{"name":"Endonuclease/exonuclease/phosphatase","short":"Endo/exonuclease/phosphatase"},"description":[{"text":"<p>This domain is found in a large number of proteins including magnesium dependent endonucleases and phosphatases involved in intracellular signalling [[cite:PUB00007746]]. Proteins this domain is found in include: AP endonuclease proteins ([ec:4.2.99.18]), DNase I proteins ([ec:3.1.21.1]), Synaptojanin an inositol-1,4,5-trisphosphate phosphatase ([ec:3.1.3.56]) and Sphingomyelinase ([ec:3.1.4.12]).</p>","llm":false,"checked":false,"updated":false}],"wikipedia":null,"literature":{"PUB00007746":{"PMID":10838565,"ISBN":null,"volume":"25","issue":"6","year":2000,"title":"Functionally unrelated signalling proteins contain a fold similar to Mg2+-dependent endonucleases.","URL":null,"raw_pages":"272-3","medline_journal":"Trends Biochem Sci","ISO_journal":"Trends Biochem. Sci.","authors":["Dlakic M."],"DOI_URL":"http://dx.doi.org/10.1016/S0968-0004(00)01582-6"}},"set_info":null,"overlaps_with":[{"accession":"IPR036691","name":"Endonuclease/exonuclease/phosphatase superfamily","type":"homologous_superfamily"}],"counters":{"subfamilies":0,"domain_architectures":4876,"interactions":1,"matches":190634,"pathways":70,"proteins":188894,"proteomes":21117,"sets":0,"structural_models":{"alphafold":131813},"structures":232,"taxa":34263},"entry_annotations":{"alignment:seed":5,"alignment:full":1837},"cross_references":{"gp":{"displayName":"Genome Properties","description":"Genome properties is an annotation system whereby functional attributes can be assigned to a genome, based on the presence of a defined set of protein signatures within that genome.","rank":45,"accessions":[{"accession":"GenProp1229","url":"https://www.ebi.ac.uk/interpro/genomeproperties/genome-property/GenProp1229"},{"accession":"GenProp1395","url":"https://www.ebi.ac.uk/interpro/genomeproperties/genome-property/GenProp1395"},{"accession":"GenProp1363","url":"https://www.ebi.ac.uk/interpro/genomeproperties/genome-property/GenProp1363"},{"accession":"GenProp1509","url":"https://www.ebi.ac.uk/interpro/genomeproperties/genome-property/GenProp1509"},{"accession":"GenProp1605","url":"https://www.ebi.ac.uk/interpro/genomeproperties/genome-property/GenProp1605"}]}},"is_llm":false,"is_reviewed_llm":false,"is_updated_llm":false,"representative_structure":{"accession":"5ewt","name":"Crystal structure of ExoIII endonuclease from Sulfolobus islandicus"}}}