"""Root-owned action_catalog.py"""
from __future__ import annotations
from .composition_information import CONTRACT_ARGUMENT_TRANSPORT
from .decision_context import PROTOCOL as DECISION_EXCHANGE_PROTOCOL
from .report_facts import FACT_MEANINGS
from collections.abc import Mapping
from .goal import REASONING_COMMIT_REQUIREMENT
from .episode_journal import WorkflowError
from .workflow_values import _array
from .workflow_values import _embedded_tool_schema
from .task_values import _json
from .task_action_contracts import _object
from .workflow_values import _wait_condition_schema
from .workflow_values import _wait_estimate_operation
from gene_annotation_episode.tool_knowledge import catalog as knowledge_catalog
from gene_annotation_episode.launch_instructions import catalog as launch_instruction_catalog
from .composition_information import restricted_root

class ActionCatalog:

    def scientific_library_available(self, source):
        if self.scientific_process_binding is None:
            return False
        if source is None:
            return True
        if self.is_job_source(source):
            return False
        binding = self.specialist(source)
        return binding is None or 'scientific_process' in binding.allowed_children(self.binding_context(source), self.services.capabilities())

    def scientific_retriever_catalog(self):
        catalog = getattr(self.scientific_process_binding, 'scientific_retriever_catalog', None)
        if catalog is not None:
            return catalog()
        from .scientific_tool_library import catalog
        configuration = self.scientific_process_binding.tool_retrieval
        return catalog(retrieval_mode=None if configuration is None else configuration['mode'], tool_info=self.scientific_process_binding.tool_library.supports_tool_info)

    def catalog(self, scope, source=None):
        if restricted_root(self, source):
            entries = self.shared_information_catalog(source)
            if self.receipts is not None and source is not None and self.permits_common_action(source, 'wait'):
                entries.append(_wait_estimate_operation())
            return entries
        catalog = self.job_implementation(path=source.path).catalog(source) if source is not None and self.is_job_source(source) else self.specialist(source).catalog(self.binding_context(source)) if source is not None and self.specialist(source) is not None else self.tools.catalog(scope=scope)
        entries = [{'name': name, **definition} for name, definition in catalog.items()] if isinstance(catalog, Mapping) else list(catalog)
        knowledge_tools = knowledge_catalog()
        launch_tools = launch_instruction_catalog()
        from .shared_information import catalog as shared_catalog
        shared_tools = self.shared_information_catalog(source)
        process_tools = []
        if self.scientific_process_binding is not None:
            scientific_catalog = getattr(self.scientific_process_binding, 'scientific_library_catalog', None)
            if scientific_catalog is None:
                from .scientific_process_library import catalog as scientific_catalog
            process_tools = scientific_catalog() + self.scientific_retriever_catalog()
        reserved = {'episode.history', 'episode.credit', 'episode.annotation_score', 'episode.estimate_wait', 'episode.monitoring_information', *(item['name'] for item in knowledge_tools), *(item['name'] for item in launch_tools), *(item['name'] for item in shared_catalog()), *(item['name'] for item in process_tools)}
        if any((item['name'] in reserved for item in entries)):
            raise WorkflowError('Episode inspection tools are owned by the current Episode runtime')
        for entry in entries:
            guides = self.knowledge.entries_for_tool(entry['name'])
            if guides:
                entry['knowledge_entry_ids'] = guides
        entries.extend(knowledge_tools)
        entries.extend(launch_tools)
        entries.extend(shared_tools)
        if self.scientific_library_available(source):
            entries.extend(process_tools)
        if source is not None and self.permits_common_action(source, 'wait'):
            entries.append(_wait_estimate_operation())
        entries.append({'name': 'episode.history', 'description': "Read only this Episode's prior decisions: metadata index, exact selected actions/outcomes and admitted direct-child forms, or a bounded publication-ID page from one prior own action. Prior history-read bodies are represented by references to their original decision indices; read those indices directly rather than recursively copying history responses. Original scientific outcomes remain exact. Failed outcomes remain failed. In view=records, a saved rejected selection retains its exact rejection_feedback without becoming an executed outcome. This ordinary read never executes old work or reads child-private conversations.", 'input_schema': {'anyOf': [{'type': 'object', 'additionalProperties': False, 'required': ['view'], 'properties': {'view': {'type': 'string', 'enum': ['index', 'records']}, 'offset': {'type': 'integer', 'minimum': 0, 'description': "Position in this Episode's ordered prior-decision page; omit when selecting decision_indices."}, 'limit': {'type': 'integer', 'minimum': 1, 'description': 'Requested page size; defaults to max(1, restoration preview_size), so disabling automatic previews still permits an ordinary page to advance. Omit when selecting decision_indices.'}, 'decision_indices': {'type': 'array', 'minItems': 1, 'uniqueItems': True, 'items': {'type': 'integer', 'minimum': 0}}}}, {'type': 'object', 'additionalProperties': False, 'required': ['view', 'decision_index'], 'properties': {'view': {'type': 'string', 'const': 'publications'}, 'decision_index': {'type': 'integer', 'minimum': 0}, 'offset': {'type': 'integer', 'minimum': 0, 'description': 'Position in the actual saved publication-ID array for this one prior own action.'}, 'limit': {'type': 'integer', 'minimum': 1, 'description': 'Requested publication-ID page size; defaults to max(1, restoration preview_size).'}}}]}})
        projector = self.credit_detail_projector(source)
        if callable(getattr(projector, 'read_details', None)):
            entries.append({'name': 'episode.credit', 'description': "Read the current credit projection for this Episode's fixed scope using this run's actual frozen projector and policy. The explicit limit and offset page source contributions and inactive dependencies independently; each includes its own total and next_offset. Zero limit requests metadata only. These are current source-bound operands, not biological accuracy or newly performed work.", 'input_schema': _object({'limit': {'type': 'integer', 'minimum': 0}, 'offset': {'type': 'integer', 'minimum': 0}})})
        if not (source is not None and self.is_job_source(source)) and callable(getattr(self.project_annotation_score, 'read_details', None)):
            entries.append({'name': 'episode.annotation_score', 'description': 'Inspect the separately bound score for each proposed annotation and its actual evidence operands for this fixed scope. This uses the same projector and policy as the annotation scores in your decision context. Explicit limit and offset page its source contributions and inactive dependencies; limit zero requests metadata only. The result does not award investigation progress or establish biological correctness.', 'input_schema': _object({'limit': {'type': 'integer', 'minimum': 0}, 'offset': {'type': 'integer', 'minimum': 0}})})
        if self.native_timing_information is not None:
            entries.append({'name': 'episode.monitoring_information', 'description': "Read this episode's separately bound monitoring credit for received native durations. Explicit limit/offset page actual measurements beyond the inherited/original baseline. This read changes no scientific state, timer, job or continuation rule.", 'input_schema': _object({'limit': {'type': 'integer', 'minimum': 0}, 'offset': {'type': 'integer', 'minimum': 0}})})
        binding = self.specialist(source) if source is not None else None
        if self.decision_protocol == DECISION_EXCHANGE_PROTOCOL:
            for entry in entries:
                if entry['name'] == 'episode.history':
                    entry['input_schema']['anyOf'][0]['properties']['view'] = {'type': 'string', 'const': 'records'}
        names = getattr(binding, 'common_tool_names', None)
        if names is not None:
            permitted = set(names(self.binding_context(source)))
            instruction_tools = {entry['name'] for entry in launch_tools}
            entries = [entry for entry in entries if entry['name'] in permitted | instruction_tools]
        return entries

    def reasoning_action_schema(self, source, commit_schema=None, *, _accept_legacy_quotes=False):
        commit_schema = self.store.reasoning_schema() if commit_schema is None else commit_schema
        specialist = self.specialist(source)
        schema = getattr(specialist, 'accept_reasoning_action_schema', None) if _accept_legacy_quotes else None
        if schema is None:
            schema = getattr(specialist, 'reasoning_action_schema', None)
        selected = schema(self.binding_context(source), commit_schema) if schema is not None else None
        result = selected if selected is not None else _object({'kind': {'type': 'string', 'const': 'reason'}, 'commit': commit_schema})
        return {**result, 'description': '\n\n'.join((value for value in (result.get('description'), REASONING_COMMIT_REQUIREMENT) if value))}

    def action_schema(self, source):
        form_example = _object({'changed_annotation_refs': {'type': 'array', 'items': {'type': 'string', 'format': 'reference', 'x-reference-namespace': 'annotation'}, 'x-source': 'changed_annotation_refs', 'description': 'Actual annotation revisions changed during this investigation; these references are not a claim that every revision is still current.'}, 'changed_assessment_refs': {'type': 'array', 'items': {'type': 'string', 'format': 'reference', 'x-reference-namespace': 'assessment'}, 'x-source': 'changed_assessment_refs', 'description': 'Actual changed source-linked assessment revisions, retaining their hypotheses, observations, relations and applicability.'}, 'changed_interpretation_account_refs': {'type': 'array', 'items': {'type': 'string', 'format': 'reference', 'x-reference-namespace': 'interpretation_account'}, 'x-source': 'changed_interpretation_account_refs', 'description': FACT_MEANINGS['changed_interpretation_account_refs']}, 'scoped_credit': {'type': 'number', 'x-source': 'credit', 'description': 'Credit projected for the fixed child scope at completion, not an accuracy verdict or a stopping instruction.'}})
        interpretive_example = _object({'interpreted_assessment_refs': _array({'type': 'string', 'format': 'reference', 'x-reference-namespace': 'assessment', 'description': 'Assessments the child selects as bearing on the assigned distinction. Each resolves to its actual hypothesis, observation, relation, conditions and assumptions; a non-discriminating result remains useful information.'}), 'unresolved_hypothesis_refs': _array({'type': 'string', 'format': 'reference', 'x-reference-namespace': 'hypothesis', 'description': 'In-scope alternatives the child currently considers unresolved; an empty array makes no claim that every possible explanation was tested.'}), 'changed_annotation_refs': form_example['properties']['changed_annotation_refs'], 'interpretation_basis_refs': {'type': 'array', 'items': {'type': 'string', 'format': 'reference'}, 'x-source': 'interpretation_basis_refs', 'description': FACT_MEANINGS['interpretation_basis_refs']}, 'observations_after_report_basis': {'type': 'array', 'items': {'type': 'string', 'format': 'reference', 'x-reference-namespace': 'observation'}, 'x-source': 'observations_after_report_basis', 'description': FACT_MEANINGS['observations_after_report_basis']}})
        scope_schema = {'type': 'object', 'additionalProperties': False, 'required': ['subject_refs'], 'properties': {'subject_refs': _array({'type': 'string'}), 'read_selection_refs': _array({'type': 'string'}), 'segments': _array({'type': 'object', 'additionalProperties': False, 'required': ['target_ref', 'start', 'end', 'unit'], 'properties': {'target_ref': {'type': 'string'}, 'member_ref': {'type': 'string'}, 'start': {'type': 'integer', 'minimum': 0}, 'end': {'type': 'integer', 'minimum': 1}, 'unit': {'type': 'string', 'enum': ['nt', 'aa', 'symbol']}}})}}
        specialist = self.specialist(source)
        common_actions = specialist.permitted_common_actions(self.binding_context(source)) if specialist is not None else ('tool', 'reason', 'child', 'wait', 'redeliver_report')
        if not self.permits_common_action(source, 'wait'):
            common_actions = tuple((action for action in common_actions if action != 'wait'))
        if restricted_root(self, source):
            if self.receipts is None:
                common_actions = tuple((action for action in common_actions if action != 'tool'))
        options = [] if self.is_job_source(source) or 'reason' not in common_actions else [self.reasoning_action_schema(source)]
        if 'wait' in common_actions:
            options.append(_object({'kind': {'type': 'string', 'const': 'wait'}, 'condition': _wait_condition_schema()}))
        for item in self.catalog(source.scope, source=source) if 'tool' in common_actions else ():
            branch = _object({'kind': {'type': 'string', 'const': 'tool'}, 'tool': {'type': 'string', 'const': item['name']}, 'arguments': _embedded_tool_schema(item['input_schema'])})
            if item.get('argument_transport') is not None:
                if item['argument_transport'] != CONTRACT_ARGUMENT_TRANSPORT:
                    raise ValueError('unsupported_tool_argument_transport')
                branch['x-argument-transport'] = CONTRACT_ARGUMENT_TRANSPORT
            options.append(branch)
        scientific_child = _object({'kind': {'type': 'string', 'const': 'child'}, 'goal': {'type': 'string', 'description': "A substantive improvement the child can pursue iteratively and revise from outcomes. A fully specified one-off lookup/calculation belongs to an ordinary tool. Numerical yield controls the child's continuation."}, 'scope': scope_schema, 'purpose': {'type': 'string', 'description': 'Explain what information you need for your later scientific decision and what your selected form fields mean.'}, 'schema_json': {'type': 'string', 'description': 'JSON encoding of your parent-defined closed return form: explicit required fields, additionalProperties false, typed arrays, and strings restricted to enum codes or declared semantic formats. A reference can declare format reference and x-reference-namespace. Optional top-level x-source selectors bind recorded facts named in available_report_facts; do not ask a model to invent those facts. These examples are optional API guidance; choose fields and meanings for your actual later decision. Fact-only example: ' + _json(form_example) + ' Interpretive example, selecting actual assessment records rather than a findings paragraph: ' + _json(interpretive_example)}, 'initial_report_json': {'type': 'string', 'description': 'JSON containing exactly the interpretation fields you chose (those without x-source), with parent-supplied initial values. Use {} for the fact-only example; for the interpretive example use {"interpreted_assessment_refs":[],"unresolved_hypothesis_refs":[]}. Those initial arrays are not new child judgments. If you request other interpreted fields, define their allowed meanings and initialize them explicitly. The runtime does not choose fields or unknown values for you.'}})
        if not self.is_job_source(source):
            explicit_roles = None if self.annotation_child_roles is None and (not (len(source.path) == 1 and getattr(self.project_credit, 'task_credit', False))) else self.available_child_roles(source)
            if specialist is None and self.scientific_process_binding is None and ('child' in common_actions) and (explicit_roles is None or 'improvement' in explicit_roles):
                options.append(scientific_child)
            if self.job_episodes is not None and specialist is None:
                options.extend((option for option in self.job_commission_schemas(source, scientific_child) if explicit_roles is None or option['properties']['role']['const'] in explicit_roles))
            if 'child' in common_actions:
                roles = tuple((role for role in explicit_roles if role in self.episode_bindings.roles)) if explicit_roles is not None else specialist.allowed_children(self.binding_context(source), self.services.capabilities()) if specialist is not None else self.episode_bindings.entry_roles
                declared = set(specialist.child_roles(source.path[-1][0])) if specialist else set(roles)
                if not set(roles) <= declared:
                    raise WorkflowError('available_child_outside_declared_type_edges')
                for role in roles:
                    binding = self.episode_bindings.for_child(source.path, role)
                    child_schema = getattr(binding, 'child_assignment_schema', None)
                    properties = {**scientific_child['properties'], 'kind': {'type': 'string', 'const': 'episode_child'}, 'role': {'type': 'string', 'const': role}, 'assignment': child_schema(self.binding_context(source), role) if child_schema is not None else binding.assignment_schema(role)}
                    if self.root_child_return_sources(source, role):
                        properties.pop('schema_json')
                        properties.pop('initial_report_json')
                    options.append(_object(properties))
        if not self.is_job_source(source) and 'redeliver_report' in common_actions:
            options.append(_object({'kind': {'type': 'string', 'const': 'redeliver_report'}, 'delivery_ref': {'type': 'string', 'description': 'Copy the delivery_ref from report_deliveries or report_delivery_failure for the saved child report.'}, 'purpose': {'type': 'string'}, 'schema_json': {'type': 'string'}}))
        return _object({'selection': {'anyOf': options}, 'report_update': source.interpret_schema})
