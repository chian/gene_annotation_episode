"""Actual unregistered annotation parent and four supplied nominal children.

Cached identities only; original registry resolution, callbacks, validators and
error ordering remain in the selected request body. Custom callers fall back.
"""
from __future__ import annotations


def exchange_for_child(workflow, source, role):
    if type(role) is not str:
        return None
    from .task import LegacyAnnotationTask
    from .. import runtime
    if type(source) is not LegacyAnnotationTask or type(workflow) is not runtime.Workflow:
        return None
    if ((type(source.path) is not tuple and type(source.path) is not list)
            or any((type(part) is not tuple and type(part) is not list) or len(part) != 2
                   or any(type(value) is not str for value in part) for part in source.path)):
        return None
    if len(source.path) != 1 or source.path[0][0] != 'annotation':
        return None
    registry = workflow.episode_bindings
    if type(registry) is not runtime.EpisodeBindingRegistry:
        return None
    if (type(registry._by_role) is not dict or type(registry._by_path) is not dict
            or any(type(key) is not str for key in registry._by_role)
            or any(type(key) is not str for key in registry._by_path)
            or any((type(value) is not list and type(value) is not tuple) for value in registry._by_role.values())):
        return None
    if 'annotation' in registry._by_role:
        return None
    if role == 'launch':
        from ..resource_work_submission.episode import ResourceEpisode
        child = registry._by_path.get('resource_work_submission')
        if type(child) is not ResourceEpisode:
            return None
        from .to_child_resource_work_submission import prepare_request
        from .from_child_resource_work_submission import admit_return, admit_unowned_return
    elif role == 'results':
        from ..resource_result_acquisition.episode import ResourceEpisode
        child = registry._by_path.get('resource_result_acquisition')
        if type(child) is not ResourceEpisode:
            return None
        from .to_child_resource_result_acquisition import prepare_request
        from .from_child_resource_result_acquisition import admit_return, admit_unowned_return
    elif role == 'literature':
        from ..published_evidence_assessment.episode import LiteratureEpisode
        child = registry._by_path.get('published_evidence_assessment')
        if type(child) is not LiteratureEpisode:
            return None
        from .to_child_published_evidence_assessment import prepare_request
        from .from_child_published_evidence_assessment import admit_return, admit_unowned_return
    elif role == 'scientific_process':
        from ..scientific_process.episode import ScientificProcessEpisode
        child = registry._by_path.get('scientific_process')
        if type(child) is not ScientificProcessEpisode:
            return None
        from .to_child_scientific_process import prepare_request
        from .from_child_scientific_process import admit_return, admit_unowned_return
    else:
        return None
    if not any(candidate is child for candidate in registry._by_role.get(role, ())):
        return None
    return prepare_request, admit_return, admit_unowned_return
