class OriginalWorkflow:
    def root_child_return_sources(self, source, role):
        """Ask this root's own binding what it needs from its child."""
        if not restricted_root(self, source):
            return ()
        bound = getattr(self.project_credit, 'child_return_sources', None)
        return tuple(bound(self.binding_context(source), role)) if bound is not None else ()

    def child_form_input(self, source, selection, role):
        if 'schema_json' in selection:
            return selection['schema_json']
        sources = self.root_child_return_sources(source, role)
        if not sources:
            raise ContractError('child_return_form_required')
        return _json(self.project_credit.child_return_form(self.binding_context(source), role))

    def child_initial_report_input(self, source, selection, role):
        if 'initial_report_json' in selection:
            return selection['initial_report_json']
        if not self.root_child_return_sources(source, role):
            raise ContractError('child_initial_report_required')
        return '{}'

    def _default_scientific_child_roles(self):
        return (*(() if self.scientific_process_binding is not None else ('improvement',)), *(() if self.job_episodes is None else self.job_episodes.roles), *self.episode_bindings.entry_roles)

    def declared_child_roles(self, role, *, path=None):
        """Literal type edges; availability never creates additional roles."""
        if role in self.episode_bindings.roles:
            return tuple(self.episode_bindings.for_path(path).child_roles(role)) if path is not None else self.episode_bindings.declared_children(role)
        if role == 'annotation' and self.annotation_child_roles is not None:
            return self.annotation_child_roles
        if role in self.grain_names:
            return self._default_scientific_child_roles()
        return ()

    def available_child_roles(self, source):
        declared = self.declared_child_roles(source.path[-1][0], path=source.path)
        specialist = self.specialist(source)
        roles = tuple(specialist.allowed_children(self.binding_context(source), self.services.capabilities())) if specialist is not None else declared
        if not set(roles) <= set(declared):
            raise WorkflowError('available_child_outside_declared_type_edges')
        if len(source.path) == 1 and getattr(self.project_credit, 'task_credit', False):
            roles = tuple((role for role in roles if role == 'scientific_process'))
        return roles

    def validate_child_choice(self, source, role, *, selection=None, original=False):
        """Enforce an explicit caller graph before commissioning side effects.

        Absent-marker runs retain their original selection/recovery semantics.
        These are role and receipt checks, not scientific suitability checks.
        """
        annotation_axes = len(source.path) == 1 and getattr(self.project_credit, 'task_credit', False)
        if annotation_axes and role != 'scientific_process':
            raise ValueError('annotation_root_commissions_evidence_axes')
        if annotation_axes and selection is not None and (not original):
            from .scientific_process_records import selection_fields
            assignment = selection.get('assignment', {})
            process = assignment.get('selection', {})
            axis = process[selection_fields(process)[0]]['option_id']
            ref = assignment.get('proposed_annotation_ref')
            scope = self.store.validate_scope(selection['scope'], source.scope)
            arms = self.source_credit_view(source)['credit']['arms']
            if sum((arm['proposed_annotation_ref'] == ref and arm['axis'] == axis and (arm['scope'] == scope) for arm in arms)) != 1:
                raise ValueError('axis_assignment_requires_one_received_annotation_subject_scope')
        if self.annotation_child_roles is None:
            return
        roles = self.declared_child_roles(source.path[-1][0], path=source.path) if original else self.available_child_roles(source)
        if role not in roles:
            raise ValueError('child_role_not_available_to_parent')
        if selection is not None:
            kind = selection.get('kind')
            selected_role = selection.get('role', 'improvement')
            if selected_role != role or (kind == 'child' and role != 'improvement'):
                raise ValueError('child_role_selection_mismatch')
            if kind == 'job_child' and (self.job_episodes is None or role not in self.job_episodes.roles or self.specialist(source) is not None) or (kind == 'episode_child' and role not in self.episode_bindings.roles):
                raise ValueError('child_kind_not_available_to_parent')

    def permits_common_action(self, source, action):
        if action == 'wait' and len(source.path) == 1 and (source.path[0][0] == 'annotation') and (self.annotation_child_roles == ('literature',)) and ('literature' in self.episode_bindings.roles) and (not getattr(self.episode_bindings.for_child(source.path, 'literature'), 'supports_wait', True)):
            return False
        if restricted_root(self, source) and action == 'tool':
            return self.receipts is not None
        binding = self.specialist(source)
        if binding is not None:
            return action in binding.permitted_common_actions(self.binding_context(source))
        return action in {'tool', 'wait'} or not self.is_job_source(source)

    def catalog(self, scope, source=None):
        if restricted_root(self, source):
            entries = self.shared_information_catalog(source)
            if self.receipts is not None and source is not None and self.permits_common_action(source, 'wait'):
                entries.append(_wait_estimate_operation())
            return entries
        catalog = self.job_episode_for_path(source.path).catalog(source) if source is not None and self.is_job_source(source) else self.specialist(source).catalog(self.binding_context(source)) if source is not None and self.specialist(source) is not None else self.tools.catalog(scope=scope)
        entries = [{'name': name, **definition} for name, definition in catalog.items()] if isinstance(catalog, Mapping) else list(catalog)
        knowledge_tools = self.knowledge.operation_catalog()
        launch_tools = self.launch_instructions.operation_catalog()
        from .shared_information import catalog as shared_catalog
        shared_tools = self.shared_information_catalog(source)
        process_tools = []
        if self.scientific_process_binding is not None:
            process_tools = self.services.scientific_library_catalog() + self.scientific_retriever_catalog()
        reserved = {'episode.history', 'episode.credit', 'episode.annotation_score', 'episode.estimate_wait', 'episode.monitoring_information', *(item['name'] for item in knowledge_tools), *(item['name'] for item in launch_tools), *(item['name'] for item in shared_catalog()), *(item['name'] for item in process_tools)}
        if any((item['name'] in reserved for item in entries)):
            raise WorkflowError('Episode inspection tools are owned by the current Episode runtime')
        for entry in entries:
            guides = self.knowledge.entries_for_tool(entry['name'])
            if guides:
                entry['knowledge_entry_ids'] = guides
        entries.extend(knowledge_tools)
        entries.extend(launch_tools)
        entries.extend(shared_tools)
        if self.scientific_library_available(source):
            entries.extend(process_tools)
        if source is not None and self.permits_common_action(source, 'wait'):
            entries.append(_wait_estimate_operation())
        entries.append({'name': 'episode.history', 'description': "Read only this Episode's prior decisions: metadata index, exact selected actions/outcomes and admitted direct-child forms, or a bounded publication-ID page from one prior own action. Prior history-read bodies are represented by references to their original decision indices; read those indices directly rather than recursively copying history responses. Original scientific outcomes remain exact. Failed outcomes remain failed. In view=records, a saved rejected selection retains its exact rejection_feedback without becoming an executed outcome. This ordinary read never executes old work or reads child-private conversations.", 'input_schema': {'anyOf': [{'type': 'object', 'additionalProperties': False, 'required': ['view'], 'properties': {'view': {'type': 'string', 'enum': ['index', 'records']}, 'offset': {'type': 'integer', 'minimum': 0, 'description': "Position in this Episode's ordered prior-decision page; omit when selecting decision_indices."}, 'limit': {'type': 'integer', 'minimum': 1, 'description': 'Requested page size; defaults to max(1, restoration preview_size), so disabling automatic previews still permits an ordinary page to advance. Omit when selecting decision_indices.'}, 'decision_indices': {'type': 'array', 'minItems': 1, 'uniqueItems': True, 'items': {'type': 'integer', 'minimum': 0}}}}, {'type': 'object', 'additionalProperties': False, 'required': ['view', 'decision_index'], 'properties': {'view': {'type': 'string', 'const': 'publications'}, 'decision_index': {'type': 'integer', 'minimum': 0}, 'offset': {'type': 'integer', 'minimum': 0, 'description': 'Position in the actual saved publication-ID array for this one prior own action.'}, 'limit': {'type': 'integer', 'minimum': 1, 'description': 'Requested publication-ID page size; defaults to max(1, restoration preview_size).'}}}]}})
        projector = self.credit_detail_projector(source)
        if callable(getattr(projector, 'read_details', None)):
            entries.append({'name': 'episode.credit', 'description': "Read the current credit projection for this Episode's fixed scope using this run's actual frozen projector and policy. The explicit limit and offset page source contributions and inactive dependencies independently; each includes its own total and next_offset. Zero limit requests metadata only. These are current source-bound operands, not biological accuracy or newly performed work.", 'input_schema': _object({'limit': {'type': 'integer', 'minimum': 0}, 'offset': {'type': 'integer', 'minimum': 0}})})
        if not (source is not None and self.is_job_source(source)) and callable(getattr(self.project_annotation_score, 'read_details', None)):
            entries.append({'name': 'episode.annotation_score', 'description': 'Inspect the separately bound score for each proposed annotation and its actual evidence operands for this fixed scope. This uses the same projector and policy as the annotation scores in your decision context. Explicit limit and offset page its source contributions and inactive dependencies; limit zero requests metadata only. The result does not award investigation progress or establish biological correctness.', 'input_schema': _object({'limit': {'type': 'integer', 'minimum': 0}, 'offset': {'type': 'integer', 'minimum': 0}})})
        if self.native_timing_information is not None:
            entries.append({'name': 'episode.monitoring_information', 'description': "Read this episode's separately bound monitoring credit for received native durations. Explicit limit/offset page actual measurements beyond the inherited/original baseline. This read changes no scientific state, timer, job or continuation rule.", 'input_schema': _object({'limit': {'type': 'integer', 'minimum': 0}, 'offset': {'type': 'integer', 'minimum': 0}})})
        binding = self.specialist(source) if source is not None else None
        if self.decision_protocol == DECISION_EXCHANGE_PROTOCOL:
            for entry in entries:
                if entry['name'] == 'episode.history':
                    entry['input_schema']['anyOf'][0]['properties']['view'] = {'type': 'string', 'const': 'records'}
        names = getattr(binding, 'common_tool_names', None)
        if names is not None:
            permitted = set(names(self.binding_context(source)))
            instruction_tools = {entry['name'] for entry in launch_tools}
            entries = [entry for entry in entries if entry['name'] in permitted | instruction_tools]
        return entries

    async def execute(self, source, name, arguments, *, decision_index, operation_key, _composition_lookup=False):
        if restricted_root(self, source) and (not _composition_lookup):
            from .shared_information import TOOLS as shared_tools
            waiting_operation = name == 'episode.estimate_wait' and self.permits_common_action(source, 'wait')
            if self.receipts is None or (name not in shared_tools and (not waiting_operation)):
                return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'code': 'root_tool_requires_shared_coordination_operation'}}
        if source.path[-1][0] == 'scientific_process':
            self.scientific_process_binding.validate_execution_context(self.binding_context(source))
        if _composition_lookup and name in CONTRACT_INFORMATION_OPERATIONS:
            saved, record = self.pending_contract_information(source, decision_index)
            lookup = record['exchange_schema']['properties']['response']['anyOf'][0]['properties']['lookup']
            entry = next((row for row in lookup['anyOf'] if row.get('properties', {}).get('operation', {}).get('const') == name), None)
            if entry is None:
                return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'category': 'decision_exchange', 'code': 'composition_operation_not_available'}}
            try:
                Draft202012Validator(entry['properties']['arguments']).validate(arguments)
                return self.contract_information_reply(saved, record, name, arguments)
            except (ValueError, TypeError, ValidationError):
                return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'category': 'decision_exchange', 'code': 'composition_arguments_invalid'}}
        if _composition_lookup:
            entry = next((entry for entry in composition_catalog(self, source) if entry['name'] == name), None)
            if entry is None:
                return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'category': 'decision_exchange', 'code': 'composition_operation_not_available'}}
            try:
                Draft202012Validator(entry['input_schema']).validate(arguments)
            except ValidationError:
                return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'category': 'decision_exchange', 'code': 'composition_arguments_invalid'}}
        elif not self.permits_common_action(source, 'tool'):
            return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'category': 'arguments_or_reference', 'code': 'tool_not_available_to_episode'}}
        binding = self.specialist(source)
        if not _composition_lookup and binding is not None and callable(getattr(binding, 'common_tool_names', None)):
            entry = next((entry for entry in self.catalog(source.scope, source=source) if entry['name'] == name), None)
            try:
                if entry is None:
                    raise ValueError('tool_not_available_to_episode')
                Draft202012Validator(entry['input_schema']).validate(arguments)
            except (ValueError, ValidationError) as error:
                return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'category': 'arguments_or_reference', 'code': 'tool_arguments_invalid' if isinstance(error, ValidationError) else str(error)}}
        if self.scientific_process_binding is not None:
            retriever_catalog = self.scientific_retriever_catalog()
            if name in {item['name'] for item in self.services.scientific_library_catalog() + retriever_catalog}:
                if not self.scientific_library_available(source):
                    return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'category': 'arguments_or_reference', 'code': 'tool_not_available_to_episode'}}
                if name == 'process.tools':
                    try:
                        Draft202012Validator(retriever_catalog[0]['input_schema']).validate(arguments)
                        tools = self.scientific_process_binding.tool_library
                        available = self.services.tool_information_catalog(source.scope) if tools.supports_tool_info else self.services.tool_catalog(source.scope)
                        if not tools.supports_tool_info:
                            tools.resolve([entry['name'] for entry in tools.catalog()], available)
                        if self.scientific_tool_retriever is not None:
                            return await self.scientific_tool_retriever.retrieve(arguments['investigation'], episode_id=source.episode_id, operation_key=operation_key, available_catalog=available)
                        result = tools.retrieve_literal_test(arguments['investigation'], available_catalog=available)
                        return {'status': 'completed', 'record_refs': [], 'changed_record_refs': [], 'result': result, 'feedback': None}
                    except (ValueError, ValidationError) as error:
                        return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'code': str(error)}}
                return self.services.execute_scientific_library(self.binding_context(source), name, arguments)
        if name == 'episode.estimate_wait':
            if not self.permits_common_action(source, 'wait'):
                return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'category': 'arguments_or_reference', 'code': 'tool_not_available_to_episode'}}
            call = self.journal.row('runtime_model_calls', source.episode_id, decision_index)
            original_context = json.loads(call['request'])['context']
            return {'status': 'completed', 'record_refs': [], 'changed_record_refs': [], 'result': self.wait_estimate(source, arguments['condition'], original_context)}
        if name in {item['name'] for item in self.knowledge.operation_catalog()}:
            return self.knowledge.execute(name, arguments)
        if name in {item['name'] for item in self.launch_instructions.operation_catalog()}:
            return self.launch_instructions.execute(name, arguments)
        if _composition_lookup:
            raise WorkflowError('composition_lookup_has_no_instruction_handler')
        if name == 'episode.history':
            return self.history_read(source, arguments, before=decision_index)
        if name == 'episode.credit':
            return self.credit_read(source, arguments)
        from .shared_information import TOOLS as shared_tools
        if name in shared_tools:
            try:
                repository = self.shared_information_repository()
                if repository is None:
                    raise ContractError('shared_information_receipt_binding_required')
                return repository.execute(self.binding_context(source), name, arguments, known_record_refs=self.receipts.known(source.episode_id), operation_key=operation_key)
            except (ValueError, ValidationError) as error:
                return {'status': 'invalid', 'record_refs': [], 'changed_record_refs': [], 'result': None, 'feedback': {'code': str(error)}}
        if name == 'episode.annotation_score':
            return self.annotation_score_read(source, arguments)
        if name == 'episode.monitoring_information':
            return self.projection_read(source, arguments, self.native_timing_information, channel='native_timing_information', projector_arguments=self.native_timing_arguments(source))
        if self.is_job_source(source):
            result = await self.job_episode_for_path(source.path).execute(source, name, arguments, operation_key=operation_key)
            if self.resource_estimator is not None:
                call = self.journal.row('runtime_model_calls', source.episode_id, decision_index)
                context = json.loads(call['request'])['context']
                sample = result.get('result') if result.get('operational_sample_ref') else self.job_episode_for_path(source.path).latest_sample(source, include_inherited=True)
                result['resource_tool_estimates'] = self.resource_estimator.estimate(context.get('execution_expectations'), job_ref=self.job_episode_for_path(source.path).assignment(source)['job_ref'], sample=sample)
            return result
        specialist = self.specialist(source)
        with self.services.tool_invocation(self.binding_context(source), tool_name=name, arguments=arguments, operation_key=operation_key):
            if specialist is not None:
                result = specialist.execute(self.binding_context(source), name, arguments, operation_key)
                result = await result if inspect.isawaitable(result) else result
            else:
                execute = getattr(self.tools, 'execute_async', self.tools.execute)
                result = execute(name, arguments, scope=source.scope, operation_key=operation_key)
                result = await result if inspect.isawaitable(result) else result
        if self.resource_estimator is not None:
            if name == 'execution.estimate' and result.get('status') == 'completed':
                original = result['result']['execution_expectations']
                result['native_execution_expectations'] = original
                result['resource_tool_estimates'] = self.resource_estimator.estimate_context(original)
            elif result.get('native_execution_refs'):
                call = self.journal.row('runtime_model_calls', source.episode_id, decision_index)
                context = json.loads(call['request'])['context']
                classes = {read_measurement(self.store, ref).execution_class.ref for ref in result['native_execution_refs']}
                estimates = [item for item in context.get('resource_tool_estimates', []) if item['execution_class_ref'] in classes]
                if estimates:
                    result['resource_tool_estimates'] = estimates
                if context.get('native_execution_expectations') is not None:
                    result['native_execution_expectations'] = context['native_execution_expectations']
        return result

    def selected(self, source, selection, index):
        if selection['kind'] in {'child', 'job_child', 'episode_child'}:
            if source.path[-1][0] == 'scientific_process':
                saved = self.journal.row('runtime_actions', source.episode_id, index)
                if saved is None or saved['result'] is None:
                    self.scientific_process_binding.validate_execution_context(self.binding_context(source))
            old = self.journal.row('runtime_actions', source.episode_id, index) if self.annotation_child_roles is not None else None
            original = old is not None and json.loads(old['action']) == selection
            self.validate_child_choice(source, selection.get('role', 'improvement'), selection=selection, original=original)
        common_action = 'child' if selection['kind'] in {'child', 'job_child', 'episode_child'} else selection['kind']
        resolving = selection['kind'] == 'redeliver_report' and selection.get('delivery_ref') == source._delivery_resolution_ref and (self.pending_delivery(source, selection.get('delivery_ref')) is not None)
        if not resolving and (not self.permits_common_action(source, common_action)):
            raise ValueError('action_not_available_to_episode')
        if restricted_root(self, source) and selection['kind'] == 'tool':
            recorded = self.journal.row('runtime_actions', source.episode_id, index)
            replay = recorded is not None and recorded['result'] is not None and (json.loads(recorded['action']) == selection)
            if not replay and selection.get('tool') not in {item['name'] for item in self.catalog(source.scope, source=source)}:
                raise ValueError('action_not_available_to_episode')
        closed = self._closed_child_commission(source, selection, index)
        if closed is not None:
            return closed
        if self.execution_binding is None and selection['kind'] in {'child', 'job_child', 'episode_child'}:
            original = self.journal.row('runtime_actions', source.episode_id, index)
            if original is not None and original['result'] is not None:
                outcome = json.loads(original['result'])
                if outcome.get('status') == 'failed' and outcome.get('feedback', {}).get('category') == 'child_execution':
                    if json.loads(original['action']) != selection or original['credit'] is None:
                        raise WorkflowError('original_child_failure_replay_conflict')

                    def failed_result(_):
                        source.last_outcome, source.last_outcome_index = (outcome, index)
                        source.feedback = outcome['feedback']
                        return self.controller_value(source, index, original['credit'])
                    return ActionLeaf(selection, extract=failed_result, result=lambda _, result: result, label=f'child_{index}', decision_index=index)
        if selection['kind'] == 'wait':
            original = self.journal.row('runtime_actions', source.episode_id, index)
            recorded = original is not None and json.loads(original['action']) == selection
            if not recorded:
                self.validate_wait_selection(source, selection['condition'])
        if selection['kind'] == 'child' and self.scientific_process_binding is not None:
            raise ValueError('scientific_child_requires_filled_process')
        if selection['kind'] == 'redeliver_report':
            return self.redeliver(source, selection, index)
        if selection['kind'] not in {'child', 'job_child', 'episode_child'}:
            if self.execution_binding is not None or self.inprocess_replay is not None:
                old = self.journal.row('runtime_actions', source.episode_id, index)
                if old is not None and json.loads(old['action']) != selection:
                    raise WorkflowError('reconstructed selected work changed')
                if old is None:
                    self.journal.save('runtime_actions', {'episode_id': source.episode_id, 'decision_index': index, 'action': _json(selection), 'result': None, 'credit': None})
            return ActionLeaf(selection, extract=lambda action: source.execute(action, index), result=lambda action, result: result, label=f"{selection['kind']}:{index}", decision_index=index)
        if self.execution_binding is not None:
            old = self.journal.row('runtime_actions', source.episode_id, index)
            if old is not None:
                if json.loads(old['action']) != selection:
                    raise WorkflowError('reconstructed selected work changed')
                result = json.loads(old['result']) if old['result'] is not None else {}
                handle = result.get('pending_handle')
                if handle is not None:
                    original = next((spec for spec in self.commissions.recover_selected(source.episode_id) if spec['handle'] == handle), None)
                    if original is None:
                        raise WorkflowError('pending_commission_intent_unavailable')
                    return self.deferred_unit(source, index, original)
        scope = self.store.validate_scope(selection['scope'], parent_scope=source.scope)
        role = selection.get('role', 'improvement')
        child_exchange = None
        if selection['kind'] == 'episode_child':
            from .scientific_process.child_message_owners import exchange_for_child
            child_exchange = exchange_for_child(self, source, role)
            if child_exchange is None:
                from .legacy_annotation.child_message_owners import exchange_for_child
                child_exchange = exchange_for_child(self, source, role)
        if child_exchange is not None:
            schema, report_declaration, initial, episode_assignment, scientific_process, assignment, specialist = child_exchange[0](self, source, selection, index, scope, role)
        else:
            episode_assignment = None
            scientific_process = None
            schema, report_declaration = self.expanded_contract_form(source, selection, index, role)
            if selection['kind'] == 'episode_child':
                binding = self.episode_bindings.for_child(source.path, role)
                required = getattr(binding, 'required_return_sources', lambda _parent, _role: ())(self.binding_context(source), role)
                sources = [node.get('x-source') for node in schema.get('properties', {}).values()]
                for fact_source in required:
                    if sources.count(fact_source) != 1:
                        raise ContractError('child_return_requires_' + fact_source)
            hpc_launch = role == 'launch' and source.path[-1][0] in {'hpc', 'hpc_execution'} or (role == 'launch_hpc' and any((part[0] == 'hpc' for part in source.path)))
            if hpc_launch and (not any((node.get('x-source') == 'execution_handoff_refs' for node in schema.get('properties', {}).values()))):
                raise ContractError('hpc_launch_requires_original_handoff_fact_in_return_form')
            initial = parse_json_object(self.child_initial_report_input(source, selection, role))
            if selection['kind'] == 'episode_child':
                validate_form(initial, interpretation_schema(schema), lambda *_: True)
            else:
                validate_form(initial, interpretation_schema(schema), self.resolver(scope, grain=role))
                self.validate_report(initial, scope, grain=role, schema=interpretation_schema(schema))
            if selection['kind'] == 'episode_child':
                specialist = self.specialist(source)
                allowed = self.available_child_roles(source) if self.annotation_child_roles is not None else specialist.allowed_children(self.binding_context(source), self.services.capabilities()) if specialist is not None else self.episode_bindings.entry_roles
                if role not in allowed:
                    raise ValueError('child_role_not_available_to_parent')
                binding = self.episode_bindings.for_child(source.path, role)
                self.launch_instructions.materialize(selection['assignment'].get('launch_instructions'))
                if binding is self.scientific_process_binding:
                    closed = {}
                    recorded = self.journal.row('runtime_actions', source.episode_id, index)
                    if recorded is not None and recorded['result'] is not None and (_json(json.loads(recorded['action'])) == _json(selection)) and (json.loads(recorded['result']).get('status') == 'completed'):
                        from .episode_return_records import EpisodeReturnRecords
                        child_id = Episode.identity(self.context, self.grains[role], f'child_{index}', parent_path=source.path).episode_id
                        if self.journal.row('runtime_episodes', child_id) is not None:
                            records = EpisodeReturnRecords(self.store, self.run_id, failure_prefix='scientific_closed_')
                            candidate = records.context(child_id)
                            read_closed = getattr(self.services, 'scientific_closed_request', None)
                            if callable(read_closed) and read_closed(candidate) is not None:
                                closed['closed_context'] = candidate
                    prepared = binding.prepare_invocation(self.binding_context(source), role, selection['assignment'], scope, f'{self.run_id}:{source.episode_id}:{index}', invocation={'objective': selection['goal'], 'purpose': selection['purpose'], 'report_schema': schema, 'initial_report': initial}, **closed)
                    episode_assignment = prepared['assignment']
                    scientific_process = prepared['scientific_process']
                else:
                    child_assignment = selection['assignment']
                    send_request = getattr(specialist, 'prepare_child_request', None)
                    if send_request is not None:
                        child_assignment = send_request(self.binding_context(source), role, child_assignment)
                    episode_assignment = binding.prepare_assignment(self.binding_context(source), role, child_assignment, scope, f'{self.run_id}:{source.episode_id}:{index}')
            assignment = self.job_episode_for_child(source.path, role).assign(self.store, role, selection, scope, operation_key=f'{self.run_id}:{source.episode_id}:{index}') if selection['kind'] == 'job_child' else None
        contract_binding = {}

        def validator(value):
            self.validate_report(value, scope, assignment=assignment, grain=role, schema=schema, context=contract_binding['context'])

        def resolve(reference, namespace=None):
            return contract_binding['resolver'](reference, namespace)

        def recorded_admission(value):
            if self.receipts is None or self.is_job_source(source):
                return None
            from .episode_return_records import EpisodeReturnRecords
            return EpisodeReturnRecords(self.store, self.run_id, failure_prefix='recorded_admission_').recorded_admission_references(self.binding_context(source), value, schema, index)
        contract = TypedReportContract(selection['purpose'], schema, resolve, validator, recorded_admission=recorded_admission)
        with self.store.transaction():
            old = self.journal.row('runtime_actions', source.episode_id, index)
            if old is None:
                self.journal.save('runtime_actions', {'episode_id': source.episode_id, 'decision_index': index, 'action': _json(selection), 'result': None, 'credit': None})
            elif json.loads(old['action']) != selection:
                raise WorkflowError('reconstructed selected work changed')
            legacy_request_assembler = None
            if selection['kind'] == 'job_child':
                self.job_episode_for_child(source.path, role)
                parent = self.legacy_parent_for_path(source.path)
                legacy_request_assembler = parent.child_request_assembler(role)
            child = self.build(role, f'child_{index}', selection['goal'], scope, parent=source.request.goal, parent_path=source.path, contract=contract, initial=initial, job_assignment=assignment, episode_assignment=episode_assignment, scientific_process=scientific_process, **{'report_contract_declaration': report_declaration} if report_declaration is not None else {}, **{'request_assembler': legacy_request_assembler} if legacy_request_assembler is not None else {'request_assembler': request_assembler} if selection['kind'] == 'episode_child' and callable(getattr(specialist, 'child_request_assembler', None)) and ((request_assembler := specialist.child_request_assembler(role)) is not None) else {})
            contract_binding['context'] = self.binding_context(child.source)
            contract_binding['resolver'] = self.resolver(scope, assignment=assignment, grain=role, context=contract_binding['context'])
            allow_suspension = self.permits_common_action(child.source, 'wait')
            if self.execution_binding is not None:
                return self.commission_child(source, child, selection, index)

        def admitted_report(result, request):
            if child_exchange is not None:
                return child_exchange[1](self, source, child, index, schema, contract, result, request)
            delivery_ref = 'delivery_' + _digest({'run': self.run_id, 'parent': source.episode_id, 'index': index})[:24]
            owned = self.episode_branch_lifecycle == EPISODE_BRANCH_LIFECYCLE
            action = self.journal.row('runtime_actions', source.episode_id, index)
            frozen_index = None if action['result'] is None else json.loads(action['result']).get('delivery_resolution_index')
            saved = self.store.db.execute('SELECT * FROM runtime_report_attempts WHERE run_id=? AND parent_episode_id=? AND ' + ('decision_index=?' if frozen_index is not None or not owned else 'delivery_ref=? ORDER BY decision_index DESC LIMIT 1'), (self.run_id, source.episode_id, frozen_index if frozen_index is not None else delivery_ref if owned else index)).fetchone()
            if saved is not None:
                if saved['failure'] is not None:
                    raise ReportDeliveryError(Record(json.loads(saved['failure'])))
                admitted = json.loads(saved['form'])
            else:
                try:
                    admitted = contract.admit(result.as_record()['form'], audit_identifiers=(child.source.episode_id, request.goal.goal_id)).as_record()
                except ReportBoundaryError as error:
                    feedback = self.delivery_feedback(delivery_ref, error)
                    self.save_attempt(source.episode_id, index, delivery_ref, child.source.episode_id, contract, failure=feedback)
                    raise ReportDeliveryError(Record(feedback)) from error
                self.save_attempt(source.episode_id, index, delivery_ref, child.source.episode_id, contract, form=admitted)
            delivery_index = index if saved is None else saved['decision_index']
            delivery_schema = schema if saved is None else json.loads(saved['contract'])['measurements']['schema']
            references = self.receive_form(source, admitted, delivery_schema, delivery_index, redelivery=delivery_index != index)
            return (admitted, references)

        def credit(result, completion, request):
            old = self.journal.row('runtime_actions', source.episode_id, index)
            if old['result'] is None:
                facts = self.facts(child.source)
                if self.receipts is not None or self.episode_branch_lifecycle == EPISODE_BRANCH_LIFECYCLE:
                    _, returned = admitted_report(result, request)
                    changed = set(facts['changed_record_refs'])
                    facts = {'committed_record_refs': returned, 'changed_record_refs': [ref for ref in returned if ref in changed]}
                outcome = {'status': 'completed', 'record_refs': facts['committed_record_refs'], 'changed_record_refs': facts['changed_record_refs']}
                original_delivery = self.store.db.execute('SELECT MAX(decision_index) FROM runtime_report_attempts WHERE run_id=? AND parent_episode_id=? AND delivery_ref=?', (self.run_id, source.episode_id, 'delivery_' + _digest({'run': self.run_id, 'parent': source.episode_id, 'index': index})[:24])).fetchone()[0]
                outcome['delivery_resolution_index'] = original_delivery
                from .episode_source_failure import child_completion_status
                outcome['child_completion'] = child_completion_status(self.store, self.run_id, child.source.episode_id, completion.as_record(), delivery='admitted')
                if self.wait_inputs_version == 'wait_inputs_binding_v2' or self.completed_action_inputs_version is not None:
                    outcome['pending_work_after_action'] = self.pending_work(source)
                self.journal.save('runtime_actions', {'episode_id': source.episode_id, 'decision_index': index, 'action': _json(selection), 'result': _json(outcome), 'credit': None})
                old = self.journal.row('runtime_actions', source.episode_id, index)
            value = old['credit']
            if value is None:
                value = self.source_credit_view(source)['credit']
                self.journal.save('runtime_actions', {'episode_id': source.episode_id, 'decision_index': index, 'action': old['action'], 'result': old['result'], 'credit': value})
            source.last_outcome, source.last_outcome_index = (json.loads(old['result']), index)
            source.checkpoint()
            return self.controller_value(source, index, value)

        async def report(result, completion, request):
            if self.receipts is not None or self.episode_branch_lifecycle == EPISODE_BRANCH_LIFECYCLE:
                try:
                    return admitted_report(result, request)[0]
                except ReportDeliveryError as error:
                    source.feedback = error.feedback.as_record()
                    await self.resolve_pending_deliveries(source, source._selection_view, only_delivery_ref=source.feedback['delivery_ref'])
                    return admitted_report(result, request)[0]
            if child_exchange is not None:
                return child_exchange[2](self, source, child, index, schema, contract, result, request)
            delivery_ref = 'delivery_' + _digest({'run': self.run_id, 'parent': source.episode_id, 'index': index})[:24]
            try:
                admitted = contract.admit(result.as_record()['form'], audit_identifiers=(child.source.episode_id, request.goal.goal_id)).as_record()
            except ReportBoundaryError as error:
                feedback = self.delivery_feedback(delivery_ref, error)
                self.save_attempt(source.episode_id, index, delivery_ref, child.source.episode_id, contract, failure=feedback)
                raise ReportDeliveryError(Record(feedback)) from error
            self.save_attempt(source.episode_id, index, delivery_ref, child.source.episode_id, contract, form=admitted)
            self.receive_form(source, admitted, schema, index)
            return admitted
        scheduled = 'delay_seconds' in selection
        if scheduled:
            self.journal.schedule_child(source.episode_id, index, selection, child.source.episode_id)

        async def resolved_credit(result, completion, request):
            try:
                admitted_report(result, request)
            except ReportDeliveryError as error:
                source.feedback = error.feedback.as_record()
                await self.resolve_pending_deliveries(source, source._selection_view, only_delivery_ref=source.feedback['delivery_ref'])
                admitted_report(result, request)
            value = credit(result, completion, request)
            original = self.journal.row('runtime_actions', source.episode_id, index)
            resolved_index = json.loads(original['result']).get('delivery_resolution_index')
            if resolved_index is not None:
                source.calls = max(source.calls, resolved_index + 1)
            return value

        def delivery_contract():
            action = self.journal.row('runtime_actions', source.episode_id, index)
            resolved_index = None if action['result'] is None else json.loads(action['result']).get('delivery_resolution_index')
            latest = self.store.db.execute('SELECT contract FROM runtime_report_attempts WHERE run_id=? AND parent_episode_id=? AND ' + ('decision_index=?' if resolved_index is not None else 'delivery_ref=? ORDER BY decision_index DESC LIMIT 1'), (self.run_id, source.episode_id, resolved_index if resolved_index is not None else 'delivery_' + _digest({'run': self.run_id, 'parent': source.episode_id, 'index': index})[:24])).fetchone()
            return contract if latest is None else self.saved_delivery_contract(child.source.episode_id, json.loads(latest['contract']))
        owned = self.episode_branch_lifecycle == EPISODE_BRANCH_LIFECYCLE

        def failed_child(error):
            outcome = {'status': 'failed', 'record_refs': [], 'changed_record_refs': [], 'feedback': {'category': 'child_execution', 'exception_type': type(error).__name__}}
            from .communication import ReportBoundaryError
            if isinstance(error, ReportBoundaryError):
                outcome['feedback']['report_boundary'] = dict(error.diagnostic)
            self.journal.save('runtime_actions', {'episode_id': source.episode_id, 'decision_index': index, 'action': _json(selection), 'result': _json(outcome), 'credit': None})
            value = self.source_credit_view(source)['credit']
            self.journal.save('runtime_actions', {'episode_id': source.episode_id, 'decision_index': index, 'action': _json(selection), 'result': _json(outcome), 'credit': value})
            source.last_outcome, source.last_outcome_index = (outcome, index)
            source.feedback = outcome['feedback']
            return self.controller_value(source, index, value)
        return TimedChildUnit(child, resolved_credit if owned else credit, report, self.journal, source.episode_id, index, scheduled=scheduled, delivery_contract=delivery_contract if owned else None, receive_failure=failed_child, allow_suspension=allow_suspension)
