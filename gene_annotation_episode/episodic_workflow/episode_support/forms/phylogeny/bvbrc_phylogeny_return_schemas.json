{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Json"
          },
          "minItems": 0
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        }
      ]
    },
    "ContentBinding": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_field": {
          "enum": [
            "artifact_ref",
            "text_ref",
            "stdout_ref",
            "stderr_ref",
            "request_ref"
          ]
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source_ref",
        "artifact_field",
        "artifact_ref",
        "sha256",
        "byte_count"
      ],
      "additionalProperties": false
    },
    "SourceEvidence": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentBinding"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(|/.*)$"
        }
      },
      "required": [
        "content",
        "pointer"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "custody",
            "prepare",
            "transport",
            "native_decode",
            "association",
            "publication",
            "recovery",
            "return"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(|/.*)$"
        },
        "severity": {
          "enum": [
            "error",
            "qualification"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "code",
        "phase",
        "path",
        "severity",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "AcquisitionRequirement": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "definition",
            "input_metadata",
            "input_bytes",
            "original_task",
            "task_manifest",
            "output_metadata",
            "output_bytes",
            "byte_version_evidence",
            "scientific_metadata",
            "parser_binding"
          ]
        },
        "role": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requirement_id",
        "kind",
        "role",
        "source_refs",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "AdapterResult": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "invalid",
            "failed"
          ]
        },
        "sheet_content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "components_content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcquisitionRequirement"
          },
          "minItems": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "minItems": 0
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "status",
        "sheet_content",
        "components_content",
        "facts",
        "missing_requirements",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  }
}
